<!-- Right Side - Form -->
    <div class="contact-form-wrapper">
      <div class="form-header">
        <h2>
          <i class="fas fa-envelope-open-text"></i>
          {{ 'landing.contact.form.title'|trans }}
        </h2>
        <p>{{ 'landing.contact.form.subtitle'|trans }}</p>
      </div>

      {# Flash messages #}
      {% for msg in app.flashes('success') %}
        <div class="alert alert-success">
          <i class="fas fa-check-circle"></i>
          <span>{{ msg }}</span>
        </div>
      {% endfor %}

      {% for msg in app.flashes('error') %}
        <div class="alert alert-error">
          <i class="fas fa-exclamation-circle"></i>
          <span>{{ msg }}</span>
        </div>
      {% endfor %}

      {% include "auth/contact/_form.html.twig" %}
    </div>


<script>
document.querySelector('#contact .contact-form')?.addEventListener('submit', function() {
  const submitBtn = document.querySelector('#contact .btn-submit');
  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> {{ "landing.contact.form.sending"|trans }}';
  }
});
</script>


