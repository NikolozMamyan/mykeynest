{# ======================== CONTACT ======================== #}
<div class="contact-page" id="contact">
  <div class="contact-container">
    <div class="contact-info">
      <span class="sh-label"><i class="fas fa-comments" aria-hidden="true"></i> {{ app.request.locale == 'en' ? 'Let’s talk' : 'Parlons de votre équipe' }}</span>
      <h2>{{ 'landing.contact.title'|trans }}</h2>
      <p class="subtitle">{{ 'landing.contact.subtitle'|trans }}</p>
      <div class="contact-methods">
        <div class="contact-method">
          <div class="contact-method-icon"><i class="fas fa-envelope"></i></div>
          <div class="contact-method-content">
            <h3>{{ 'landing.contact.info.email_title'|trans }}</h3>
            <p><a href="mailto:contact@key-nest.com">contact@key-nest.com</a></p>
          </div>
        </div>
        <div class="contact-method">
          <div class="contact-method-icon"><i class="fas fa-headset"></i></div>
          <div class="contact-method-content">
            <h3>{{ 'landing.contact.info.support_title'|trans }}</h3>
            <p>{{ 'landing.contact.info.support_text'|trans }}<br>{{ 'landing.contact.info.support_time'|trans|raw }}</p>
          </div>
        </div>
        <div class="contact-method">
          <div class="contact-method-icon"><i class="fas fa-clock"></i></div>
          <div class="contact-method-content">
            <h3>{{ 'landing.contact.info.hours_title'|trans }}</h3>
            <p>{{ 'landing.contact.info.hours_text'|trans|raw }}</p>
          </div>
        </div>
      </div>
    </div>
    {% include "auth/contact/contact.html.twig" %}
  </div>
</div>

{# ======================== CTA ======================== #}
<section class="cta-sec">
  <div class="wrap">
    <div class="cta-box" data-reveal>
      <div class="cta-keys" aria-hidden="true"><i class="fas fa-key k1"></i><i class="fas fa-lock k2"></i><i class="fas fa-shield-halved k3"></i><i class="fas fa-user-check k4"></i></div>
      <div class="cta-icon" aria-hidden="true"><i class="fas fa-key"></i></div>
      <h2>{{ 'landing.cta.title'|trans }}</h2>
      <p>{{ 'landing.cta.subtitle'|trans }}</p>
      <div class="cta-btns">
        <a href="{{ path('show_register', app.request.locale == 'en' ? {lang: 'en'} : {}) }}" class="btn btn-primary btn-lg btn-w">
          {{ 'landing.cta.start'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </a>
        <a href="{{ path('show_login', app.request.locale == 'en' ? {lang: 'en'} : {}) }}" class="btn btn-outline btn-lg btn-w">{{ 'landing.cta.login'|trans }}</a>
      </div>
      <p class="cta-note"><i class="fas fa-circle-check"></i> {{ 'landing.cta.note'|trans }}</p>
    </div>
  </div>
</section>
</main>

{# JSON-LD FAQ #}
{% set questions = [] %}
{% for number in 1..7 %}
  {% set questions = questions|merge([{'@type': 'Question', name: ('landing.faq.items.q' ~ number)|trans, acceptedAnswer: {'@type': 'Answer', text: ('landing.faq.items.a' ~ number)|trans|striptags}}]) %}
{% endfor %}
<script type="application/ld+json">{{ {'@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: questions}|json_encode(15)|raw }}</script>
{% endblock %}
