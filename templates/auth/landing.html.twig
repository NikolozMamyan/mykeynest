{% extends 'base_auth.html.twig' %}

{% block title %}{{ app.request.locale == 'en' ? 'Share team access without revealing passwords | MYKEYNEST' : 'Partagez les accès sans révéler les mots de passe | MYKEYNEST' }}{% endblock %}
{% block description %}{{ app.request.locale == 'en' ? 'MYKEYNEST helps SMBs and agencies centralize credentials, control sharing, and fill sign-in forms from the browser extension.' : 'MYKEYNEST aide les PME et agences à centraliser leurs identifiants, contrôler les partages et remplir les connexions depuis l’extension navigateur.' }}{% endblock %}
{% block og_title %}{{ app.request.locale == 'en' ? 'Share team access without revealing passwords | MYKEYNEST' : 'Partagez les accès sans révéler les mots de passe | MYKEYNEST' }}{% endblock %}
{% block og_description %}{{ app.request.locale == 'en' ? 'Centralize business credentials and decide how each teammate or external collaborator can use them.' : 'Centralisez les identifiants de l’entreprise et choisissez comment chaque collaborateur ou prestataire peut les utiliser.' }}{% endblock %}
{% block twitter_title %}{{ app.request.locale == 'en' ? 'Controlled access sharing for SMBs | MYKEYNEST' : 'Partage d’accès contrôlé pour PME | MYKEYNEST' }}{% endblock %}
{% block twitter_description %}{{ app.request.locale == 'en' ? 'Password management, controlled sharing, and browser autofill for teams.' : 'Gestion des mots de passe, partage contrôlé et auto-remplissage pour les équipes.' }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/landing.css') }}">
{% endblock %}

{% block body %}
{# ======================== HERO ======================== #}
<section class="hero" role="banner" id="main-content">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-eyebrow" aria-hidden="true">
        <i class="fas fa-shield-halved"></i> {{ 'landing.hero.eyebrow'|trans }}
      </div>
      <h1 class="hero-h1">
        {{ 'landing.hero.title_before'|trans }}
        <span class="hl">{{ 'landing.hero.title_highlight'|trans }}</span>
      </h1>
      <p class="hero-sub">{{ 'landing.hero.subtitle'|trans }}</p>
      <div class="hero-cta">
        <a href="{{ path('show_register') }}" class="btn btn-primary btn-lg btn-w" aria-label="{{ 'landing.hero.cta_start_aria'|trans }}">
          <i class="fas fa-rocket" aria-hidden="true"></i> {{ 'landing.hero.cta_start'|trans }}
        </a>
        <a href="#how-it-works" class="btn btn-outline btn-lg btn-w">{{ 'landing.hero.cta_discover'|trans }}</a>
      </div>
      <p class="hero-hint"><i class="fas fa-circle-check"></i> {{ 'landing.hero.hint'|trans }}</p>
      <div class="trust" aria-label="{{ 'landing.hero.trust_aria'|trans }}">
        <div class="trust-item"><i class="fas fa-shield-check"></i><span>{{ 'landing.hero.trust.aes'|trans }}</span></div>
        <div class="trust-item"><i class="fas fa-lock"></i><span>{{ 'landing.hero.trust.zeroknowledge'|trans }}</span></div>
        <div class="trust-item"><i class="fas fa-fingerprint"></i><span>{{ 'landing.hero.trust.hashed'|trans }}</span></div>
      </div>
    </div>

    <div class="hero-vis" aria-hidden="true">
      <div class="sec-pill"><i class="fas fa-shield-check"></i> {{ app.request.locale == 'en' ? 'Encrypted vault' : 'Coffre-fort chiffré' }}</div>
      <div class="vault">
        <div class="vault-bar">
          <div class="vdots"><div class="vdot"></div><div class="vdot"></div><div class="vdot"></div></div>
          <span class="vault-title">MyKeyNest - Vault</span>
        </div>
        <div class="vault-search">
          <i class="fas fa-magnifying-glass"></i>
          <input type="text" placeholder="{{ app.request.locale == 'en' ? 'Search an access' : 'Rechercher un accès' }}" tabindex="-1" readonly>
        </div>
        <div class="cred-list">
          <div class="cred">
            <div class="cred-logo g"><i class="fab fa-google"></i></div>
            <div class="cred-body"><b>{{ 'landing.hero.mock.gmail'|trans }}</b><span>email@example.com</span></div>
            <div class="sdots"><div class="sd ok"></div><div class="sd ok"></div><div class="sd ok"></div><div class="sd ok"></div></div>
            <i class="fas fa-lock cred-lock"></i>
          </div>
          <div class="cred">
            <div class="cred-logo f"><i class="fab fa-facebook"></i></div>
            <div class="cred-body"><b>{{ 'landing.hero.mock.facebook'|trans }}</b><span>••••••••••••</span></div>
            <div class="sdots"><div class="sd mid"></div><div class="sd mid"></div><div class="sd mid"></div><div class="sd"></div></div>
            <i class="fas fa-lock cred-lock"></i>
          </div>
          <div class="cred">
            <div class="cred-logo gh"><i class="fab fa-github"></i></div>
            <div class="cred-body"><b>{{ 'landing.hero.mock.github'|trans }}</b><span>developer@mail.com</span></div>
            <div class="sdots"><div class="sd ok"></div><div class="sd ok"></div><div class="sd ok"></div><div class="sd ok"></div></div>
            <i class="fas fa-lock cred-lock"></i>
          </div>
          <div class="cred cred-extra">
            <div class="cred-logo s"><i class="fab fa-stripe-s"></i></div>
            <div class="cred-body"><b>Stripe Dashboard</b><span>admin@company.com</span></div>
            <div class="sdots"><div class="sd ok"></div><div class="sd ok"></div><div class="sd ok"></div><div class="sd ok"></div></div>
            <i class="fas fa-lock cred-lock"></i>
          </div>
          <div class="cred cred-extra">
            <div class="cred-logo a"><i class="fab fa-aws"></i></div>
            <div class="cred-body"><b>AWS Console</b><span>ops@company.com</span></div>
            <div class="sdots"><div class="sd ok"></div><div class="sd ok"></div><div class="sd ok"></div><div class="sd ok"></div></div>
            <i class="fas fa-lock cred-lock"></i>
          </div>
        </div>
        <div class="hash-badge">
          <span style="color:#64748b;">{{ app.request.locale == 'en' ? 'ACCESS' : 'ACCÈS' }}</span>
          <span>{{ app.request.locale == 'en' ? 'Guest' : 'Invité' }}</span>
          <span class="hash-ok"><i class="fas fa-circle-check"></i> {{ app.request.locale == 'en' ? 'AUTHORIZED' : 'AUTORISÉ' }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

{# STRIP #}
<div class="strip" aria-hidden="true">
  <div class="strip-inner">
    <div class="s-item"><i class="fas fa-certificate"></i> {{ app.request.locale == 'en' ? 'Encrypted credentials' : 'Identifiants chiffrés' }}</div>
    <div class="s-div"></div>
    <div class="s-item"><i class="fas fa-user-shield"></i> {{ app.request.locale == 'en' ? 'Controlled sharing' : 'Partage contrôlé' }}</div>
    <div class="s-div"></div>
    <div class="s-item"><i class="fas fa-puzzle-piece"></i> {{ app.request.locale == 'en' ? 'Browser extension' : 'Extension navigateur' }}</div>
    <div class="s-div"></div>
    <div class="s-item"><i class="fas fa-building-user"></i> {{ app.request.locale == 'en' ? 'Team management' : 'Gestion d’équipe' }}</div>
    <div class="s-div"></div>
    <div class="s-item"><i class="fas fa-check-double"></i> {{ app.request.locale == 'en' ? 'Access revocation' : 'Révocation des accès' }}</div>
  </div>
</div>



{# ======================== SECURITY ======================== #}
<section class="sec-section" id="security" aria-labelledby="sec-h2">
  <div class="wrap">
    <div class="sec-inner">
      <div class="sec-text">
        <span class="sh-label"><i class="fas fa-fingerprint"></i> {{ 'landing.security.label'|trans }}</span>
        <h2 class="sec-h2" id="sec-h2">{{ 'landing.security.title'|trans }}</h2>
        <p class="sec-intro">{{ 'landing.security.intro'|trans }}</p>
        <div class="sec-pts">
          <div class="sp">
            <div class="sp-ico"><i class="fas fa-fingerprint"></i></div>
            <div class="sp-body"><b>{{ 'landing.security.points.p1_title'|trans }}</b><p>{{ 'landing.security.points.p1_text'|trans }}</p></div>
          </div>
          <div class="sp">
            <div class="sp-ico"><i class="fas fa-link-slash"></i></div>
            <div class="sp-body"><b>{{ 'landing.security.points.p2_title'|trans }}</b><p>{{ 'landing.security.points.p2_text'|trans }}</p></div>
          </div>
          <div class="sp">
            <div class="sp-ico"><i class="fas fa-database"></i></div>
            <div class="sp-body"><b>{{ 'landing.security.points.p3_title'|trans }}</b><p>{{ 'landing.security.points.p3_text'|trans }}</p></div>
          </div>
          <div class="sp">
            <div class="sp-ico"><i class="fas fa-file-shield"></i></div>
            <div class="sp-body"><b>{{ 'landing.security.points.p4_title'|trans }}</b><p>{{ 'landing.security.points.p4_text'|trans }}</p></div>
          </div>
        </div>
      </div>
      <div class="terminal" aria-hidden="true">
        <div class="t-bar">
          <div class="t-dots"><div class="t-dot"></div><div class="t-dot"></div><div class="t-dot"></div></div>
          <span class="t-title">{{ app.request.locale == 'en' ? 'mykeynest - access manager' : 'mykeynest - gestion des accès' }}</span>
        </div>
        <div class="t-body">
          <div class="tl"><span class="tp">$</span><span class="tc">check_access --user collaborator</span></div>
          <div class="tl"><span class="tp"> </span><span class="tv">CREDENTIAL&nbsp; : ENCRYPTED</span></div>
          <div class="tl"><span class="tp"> </span><span class="tv">SHARE_MODE&nbsp; : SIGN-IN ONLY</span></div>
          <div class="tl"><span class="tp"> </span><span class="tv">EXTENSION&nbsp;&nbsp; : ASSOCIATED &#10003;</span></div>
          <br>
          <div class="tl"><span class="tp">$</span><span class="tc">revoke_access --user collaborator</span></div>
          <div class="tl"><span class="tp"> </span><span class="te">ACCESS&nbsp;&nbsp; : REVOKED</span></div>
          <div class="tl"><span class="tp"> </span><span class="tw">SESSION : CLOSED</span></div>
          <br>
          <div class="tl"><span class="tp">$</span><span class="tc">status</span></div>
          <div class="tl"><span class="tp"> </span><span class="tok">&#10003; OWNER CONTROL RETAINED</span></div>
        </div>
        <div class="t-chain">
          <div class="tnode"><i class="fas fa-puzzle-piece"></i></div>
          <div class="tarrow"></div>
          <div class="tnode"><i class="fas fa-file-signature"></i></div>
          <div class="tarrow"></div>
          <div class="tnode"><i class="fas fa-lock"></i></div>
          <div class="tarrow"></div>
          <div class="tnode"><i class="fas fa-shield-check"></i></div>
        </div>
        <div class="t-scan"></div>
      </div>
    </div>
  </div>
</section>

{# ======================== PRICING ======================== #}
<section class="pricing" id="pricing" aria-label="{{ 'landing.pricing.aria'|trans }}">
  <div class="wrap">
    <div class="sh">
      <span class="sh-label"><i class="fas fa-tag"></i> {{ 'landing.pricing.label'|trans }}</span>
      <h2>{{ 'landing.pricing.showcase.title'|trans }}</h2>
      <p>{{ 'landing.pricing.showcase.subtitle'|trans }}</p>
      <span class="pricing-cycle"><i class="fas fa-calendar-check"></i> {{ 'landing.pricing.showcase.billing'|trans }}</span>
    </div>

    {% set landingFreePlan = subscription_plan('free') %}
    {% set landingProPlan = subscription_plan('pro') %}
    {% set landingTeamPlan = subscription_plan('team') %}
    <div class="p-grid">
      <div class="p-card">
        <div class="p-card-head">
          <p class="p-eye">{{ 'landing.pricing.showcase.starter.eyebrow'|trans }}</p>
          <h3>{{ 'landing.pricing.showcase.starter.name'|trans }}</h3>
          <p class="p-tag">{{ 'landing.pricing.showcase.starter.target'|trans }}</p>
          <p class="p-price"><span>0€</span> <small>{{ 'landing.pricing.showcase.per_month'|trans }}</small></p>
          <a href="{{ path('show_register') }}" class="btn p-cta" aria-label="{{ 'landing.pricing.plan.basic_aria'|trans }}">{{ 'landing.pricing.showcase.starter.cta'|trans }}</a>
        </div>
        <p class="p-included"><i class="fas fa-user"></i> {{ 'landing.pricing.showcase.starter.included'|trans }}</p>
        <ul class="p-feats">
          <li><span class="p-feature-icon"><i class="fas fa-key"></i></span><b>{{ 'landing.pricing.showcase.features.passwords'|trans }}</b><span>{{ landingFreePlan.limits.credentials ?? ('landing.pricing.showcase.unlimited'|trans) }}</span></li>
          <li><span class="p-feature-icon"><i class="fas fa-share-nodes"></i></span><b>{{ 'landing.pricing.showcase.features.shares'|trans }}</b><span>{{ landingFreePlan.limits.shares ?? ('landing.pricing.showcase.unlimited'|trans) }}</span></li>
          <li{% if not landingFreePlan.features.password_generator %} class="p-disabled"{% endif %}><span class="p-feature-icon"><i class="fas fa-wand-magic-sparkles"></i></span><b>{{ 'landing.pricing.showcase.features.generator'|trans }}</b><i class="fas {{ landingFreePlan.features.password_generator ? 'fa-check p-yes' : 'fa-minus' }}"></i></li>
          <li class="p-disabled"><span class="p-feature-icon"><i class="fas fa-mobile-screen"></i></span><b>{{ 'landing.pricing.showcase.features.two_factor'|trans }}</b><i class="fas fa-minus"></i></li>
          <li{% if not landingFreePlan.features.security_checker %} class="p-disabled"{% endif %}><span class="p-feature-icon"><i class="fas fa-shield-halved"></i></span><b>{{ 'landing.pricing.showcase.features.audit'|trans }}</b><i class="fas {{ landingFreePlan.features.security_checker ? 'fa-check p-yes' : 'fa-minus' }}"></i></li>
        </ul>
      </div>

      <div class="p-card pop" aria-label="{{ 'landing.pricing.plan.pro_reco_aria'|trans }}">
        <div class="pop-badge"><i class="fas fa-fire"></i> {{ 'landing.pricing.plan.popular_badge'|trans }}</div>
        <div class="p-card-head">
          <p class="p-eye">{{ 'landing.pricing.showcase.pro.eyebrow'|trans }}</p>
          <h3>{{ 'landing.pricing.showcase.pro.name'|trans }}</h3>
          <p class="p-tag">{{ 'landing.pricing.showcase.pro.target'|trans }}</p>
          <p class="p-price"><span>6,99€</span> <small>{{ 'landing.pricing.showcase.per_user_month'|trans }}</small></p>
          <a href="{{ path('app_public_subscription_checkout_pro') }}" class="btn p-cta p-cta-primary" aria-label="{{ 'landing.pricing.plan.pro_aria'|trans }}">{{ 'landing.pricing.showcase.pro.cta'|trans }} <i class="fas fa-arrow-right"></i></a>
        </div>
        <p class="p-included"><i class="fas fa-user"></i> {{ 'landing.pricing.showcase.pro.included'|trans }}</p>
        <ul class="p-feats">
          <li><span class="p-feature-icon"><i class="fas fa-key"></i></span><b>{{ 'landing.pricing.showcase.features.passwords'|trans }}</b><span>{{ landingProPlan.limits.credentials ?? ('landing.pricing.showcase.unlimited'|trans) }}</span></li>
          <li><span class="p-feature-icon"><i class="fas fa-share-nodes"></i></span><b>{{ 'landing.pricing.showcase.features.shares'|trans }}</b><span>{{ landingProPlan.limits.shares ?? ('landing.pricing.showcase.unlimited'|trans) }}</span></li>
          <li><span class="p-feature-icon"><i class="fas fa-mobile-screen"></i></span><b>{{ 'landing.pricing.showcase.features.two_factor'|trans }}</b><i class="fas fa-check p-yes"></i></li>
          <li><span class="p-feature-icon"><i class="fas fa-shield-halved"></i></span><b>{{ 'landing.pricing.showcase.features.audit'|trans }}</b><span>{{ 'landing.pricing.showcase.pro.audit'|trans }}</span></li>
          <li><span class="p-feature-icon"><i class="fas fa-headset"></i></span><b>{{ 'landing.pricing.showcase.features.support'|trans }}</b><span>{{ 'landing.pricing.showcase.pro.support'|trans }}</span></li>
        </ul>
      </div>

      <div class="p-card">
        <div class="p-card-head">
          <p class="p-eye">{{ 'landing.pricing.showcase.team.eyebrow'|trans }}</p>
          <h3>{{ 'landing.pricing.showcase.team.name'|trans }}</h3>
          <p class="p-tag">{{ 'landing.pricing.showcase.team.target'|trans }}</p>
          <p class="p-price"><span>5,49€</span> <small>{{ 'landing.pricing.showcase.per_user_month'|trans }}</small></p>
          <a href="{{ path('app_public_subscription_checkout_team') }}" class="btn p-cta" aria-label="{{ 'landing.pricing.showcase.team.aria'|trans }}">{{ 'landing.pricing.showcase.team.cta'|trans }}</a>
        </div>
        <p class="p-included"><i class="fas fa-users"></i> {{ 'landing.pricing.showcase.team.included'|trans }}</p>
        <ul class="p-feats">
          <li><span class="p-feature-icon"><i class="fas fa-key"></i></span><b>{{ 'landing.pricing.showcase.features.passwords'|trans }}</b><span>{{ landingTeamPlan.limits.credentials ?? ('landing.pricing.showcase.unlimited'|trans) }}</span></li>
          <li><span class="p-feature-icon"><i class="fas fa-share-nodes"></i></span><b>{{ 'landing.pricing.showcase.features.shares'|trans }}</b><span>{{ landingTeamPlan.limits.shares ?? ('landing.pricing.showcase.unlimited'|trans) }}</span></li>
          <li><span class="p-feature-icon"><i class="fas fa-user-shield"></i></span><b>{{ 'landing.pricing.showcase.features.admin'|trans }}</b><i class="fas fa-check p-yes"></i></li>
          <li><span class="p-feature-icon"><i class="fas fa-file-shield"></i></span><b>{{ 'landing.pricing.showcase.features.audit'|trans }}</b><span>{{ 'landing.pricing.showcase.team.audit'|trans }}</span></li>
          <li><span class="p-feature-icon"><i class="fas fa-headset"></i></span><b>{{ 'landing.pricing.showcase.features.support'|trans }}</b><span>{{ 'landing.pricing.showcase.team.support'|trans }}</span></li>
        </ul>
      </div>
    </div>

    <div class="pricing-comparison">
      <div class="pricing-comparison__heading">
        <span>{{ 'landing.pricing.showcase.comparison.eyebrow'|trans }}</span>
        <h3>{{ 'landing.pricing.showcase.comparison.title'|trans }}</h3>
      </div>
      <div class="pricing-table-wrap">
        <table class="pricing-table">
          <thead><tr><th>{{ 'landing.pricing.showcase.comparison.feature'|trans }}</th><th>Starter</th><th>Pro</th><th>Team</th></tr></thead>
          <tbody>
            <tr><th>{{ 'landing.pricing.showcase.comparison.passwords'|trans }}</th><td>{{ landingFreePlan.limits.credentials ?? ('landing.pricing.showcase.unlimited'|trans) }}</td><td>{{ landingProPlan.limits.credentials ?? ('landing.pricing.showcase.unlimited'|trans) }}</td><td>{{ landingTeamPlan.limits.credentials ?? ('landing.pricing.showcase.unlimited'|trans) }}</td></tr>
            <tr><th>{{ 'landing.pricing.showcase.comparison.shares'|trans }}</th><td>{{ landingFreePlan.limits.shares ?? ('landing.pricing.showcase.unlimited'|trans) }}</td><td>{{ landingProPlan.limits.shares ?? ('landing.pricing.showcase.unlimited'|trans) }}</td><td>{{ landingTeamPlan.limits.shares ?? ('landing.pricing.showcase.unlimited'|trans) }}</td></tr>
            <tr><th>{{ 'landing.pricing.showcase.comparison.two_factor'|trans }}</th><td><i class="fas fa-minus p-no"></i></td><td><i class="fas fa-check p-yes"></i></td><td><i class="fas fa-check p-yes"></i></td></tr>
            <tr><th>{{ 'landing.pricing.showcase.comparison.audit'|trans }}</th><td><i class="fas {{ landingFreePlan.features.security_checker ? 'fa-check p-yes' : 'fa-minus p-no' }}"></i></td><td>{{ 'landing.pricing.showcase.pro.audit'|trans }}</td><td>{{ 'landing.pricing.showcase.team.audit'|trans }}</td></tr>
            <tr><th>{{ 'landing.pricing.showcase.comparison.support'|trans }}</th><td>{{ 'landing.pricing.showcase.starter.support'|trans }}</td><td>{{ 'landing.pricing.showcase.pro.support'|trans }}</td><td>{{ 'landing.pricing.showcase.team.support'|trans }}</td></tr>
            <tr><th>{{ 'landing.pricing.showcase.comparison.secure_notes'|trans }}</th><td><i class="fas {{ landingFreePlan.features.secure_notes ? 'fa-check p-yes' : 'fa-minus p-no' }}"></i></td><td><i class="fas {{ landingProPlan.features.secure_notes ? 'fa-check p-yes' : 'fa-minus p-no' }}"></i></td><td><i class="fas {{ landingTeamPlan.features.secure_notes ? 'fa-check p-yes' : 'fa-minus p-no' }}"></i></td></tr>
            <tr><th>{{ 'landing.pricing.showcase.comparison.credential_import'|trans }}</th><td><i class="fas {{ landingFreePlan.features.credential_import ? 'fa-check p-yes' : 'fa-minus p-no' }}"></i></td><td><i class="fas {{ landingProPlan.features.credential_import ? 'fa-check p-yes' : 'fa-minus p-no' }}"></i></td><td><i class="fas {{ landingTeamPlan.features.credential_import ? 'fa-check p-yes' : 'fa-minus p-no' }}"></i></td></tr>
            <tr><th>{{ 'landing.pricing.showcase.comparison.admin'|trans }}</th><td><i class="fas fa-minus p-no"></i></td><td><i class="fas fa-minus p-no"></i></td><td>{{ 'landing.pricing.showcase.team.admin'|trans }}</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
{# ======================== HOW IT WORKS ======================== #}
<section class="how" id="how-it-works">
  <div class="wrap">
    <div class="sh">
      <span class="sh-label"><i class="fas fa-map"></i> {{ 'landing.how.label'|trans }}</span>
      <h2>{{ 'landing.how.title'|trans }}</h2>
      <p>{{ 'landing.how.subtitle'|trans }}</p>
    </div>
    <div class="how-demo">
      <div class="how-demo-copy">
        <span class="how-demo-eyebrow"><i class="fas fa-play-circle"></i> {{ 'landing.how.demo.eyebrow'|trans }}</span>
        <h3>{{ 'landing.how.demo.title'|trans }}</h3>
        <p>{{ 'landing.how.demo.text'|trans }}</p>
      </div>
      <div class="how-demo-shell" aria-hidden="true">
        <div class="how-demo-bar">
          <div class="how-demo-dots"><span></span><span></span><span></span></div>
          <span>mykeynest://demo/onboarding</span>
        </div>
        <div class="how-demo-screen">
          <iframe
            src="https://www.youtube-nocookie.com/embed/IS4YgAdW-H8?rel=0"
            title="{{ 'landing.how.demo.iframe_title'|trans }}"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
    <div class="steps">
      <div class="step">
        <div class="step-n">1</div>
        <div class="step-body"><h3>{{ 'landing.how.steps.s1_title'|trans }}</h3><p>{{ 'landing.how.steps.s1_text'|trans }}</p></div>
      </div>
      <div class="step">
        <div class="step-n">2</div>
        <div class="step-body"><h3>{{ 'landing.how.steps.s2_title'|trans }}</h3><p>{{ 'landing.how.steps.s2_text'|trans }}</p></div>
      </div>
      <div class="step">
        <div class="step-n">3</div>
