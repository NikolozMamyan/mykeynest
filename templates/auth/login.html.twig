{% extends 'base_auth.html.twig' %}

{% block title %}Connexion{% endblock %}
{% block body_class %}auth-form-page{% endblock %}

{% block body %}
{% set en = app.request.locale == 'en' %}

<div class="auth-container">
  <div class="auth-bg" aria-hidden="true"><span class="ab ab1"></span><span class="ab ab2"></span></div>
  <div class="login-wrapper" data-controller="auth" data-auth-locale-value="{{ app.request.locale }}">

    <!-- Colonne gauche - Hero -->
    <div class="login-hero">
      <div class="hero-content">
        <div class="hero-brand">
          <span class="hero-icon"><img src="{{ asset('images/mykeynest-dot-mark.svg') }}" alt="" aria-hidden="true"></span>
          <span class="hero-status"><i class="fas fa-circle" aria-hidden="true"></i> {{ en ? 'Secure connection' : 'Connexion sécurisée' }}</span>
        </div>

        <h1>{{ 'auth.login.hero.title'|trans }}</h1>
        <p>{{ 'auth.login.hero.subtitle'|trans }}</p>

        <div class="ah-scene" aria-hidden="true">
          <div class="ah-vault">
            <div class="ah-vault-head">
              <span class="ah-lock"><i class="fas fa-lock ah-lock-c"></i><i class="fas fa-lock-open ah-lock-o"></i></span>
              <div><small>{{ en ? 'Your vault' : 'Votre coffre' }}</small><b>{{ en ? 'Unlocked' : 'Déverrouillé' }}</b></div>
              <span class="ah-tag">AES-256</span>
            </div>
            <div class="ah-row" style="--i:0"><span class="ah-ico"><i class="fab fa-google"></i></span><div><b>Google Workspace</b><small>{{ en ? 'Owner' : 'Propriétaire' }}</small></div><em>••••••</em></div>
            <div class="ah-row" style="--i:1"><span class="ah-ico"><i class="fab fa-shopify"></i></span><div><b>{{ en ? 'Client store' : 'Boutique client' }}</b><small>{{ en ? 'Shared with Léa · sign-in only' : 'Partagé avec Léa · connexion seule' }}</small></div><em>••••••</em></div>
            <div class="ah-row" style="--i:2"><span class="ah-ico"><i class="fab fa-wordpress"></i></span><div><b>{{ en ? 'Agency website' : 'Site de l’agence' }}</b><small>{{ en ? 'Shared with the team' : 'Partagé avec l’équipe' }}</small></div><em>••••••</em></div>
          </div>
          <div class="ah-toast"><span><i class="fas fa-user-check"></i></span><div><b>{{ en ? 'Léa signed in to the store' : 'Léa s’est connectée à la boutique' }}</b><small>{{ en ? 'Password stayed hidden' : 'Le mot de passe est resté masqué' }}</small></div></div>
        </div>

        <ul class="hero-features">
          <li><i class="fas fa-shield-halved" aria-hidden="true"></i> {{ 'auth.login.hero.features.f1'|trans }}</li>
          <li><i class="fas fa-user-lock" aria-hidden="true"></i> {{ 'auth.login.hero.features.f2'|trans }}</li>
          <li><i class="fas fa-puzzle-piece" aria-hidden="true"></i> {{ 'auth.login.hero.features.f3'|trans }}</li>
        </ul>
      </div>
    </div>

    <!-- Colonne droite - Formulaire -->
    <div class="login-form-section">
      <div class="form-header">
        <span class="form-kicker"><i class="fas fa-right-to-bracket" aria-hidden="true"></i> {{ en ? 'Sign in' : 'Connexion' }}</span>
        <h2>{{ 'auth.login.form.title'|trans }}</h2>
        <p>{{ 'auth.login.form.subtitle'|trans }}</p>
      </div>

      {% include 'components/auth/feedback.html.twig' %}
      {% include 'components/auth/google_button.html.twig' %}

      <form class="login-form" data-action="submit->auth#login">
        <div class="form-group">
          <label for="email">{{ 'auth.login.form.email_label'|trans }}</label>
          <div class="input-wrap">
            <i class="fas fa-envelope input-ico" aria-hidden="true"></i>
            <input
              type="email"
              id="email"
              data-auth-target="email"
              placeholder="{{ 'auth.login.form.email_placeholder'|trans }}"
              required
              autocomplete="email"
            >
          </div>
        </div>

        <div class="form-group">
          <div class="label-row">
            <label for="password">{{ 'auth.login.form.password_label'|trans }}</label>
            <a href="{{ path('app_forgot_password_request') }}" class="label-link">{{ 'auth.login.form.hint_link1'|trans }}</a>
          </div>
          <div class="input-wrap" data-controller="password-toggle">
            <i class="fas fa-lock input-ico" aria-hidden="true"></i>
            <input
              type="password"
              id="password"
              data-auth-target="password"
              data-password-toggle-target="input"
              placeholder="••••••••"
              required
              autocomplete="current-password"
            >
            <button type="button" class="input-toggle" data-action="password-toggle#toggle" aria-label="{{ en ? 'Show or hide the password' : 'Afficher ou masquer le mot de passe' }}">
              <i class="fas fa-eye" data-password-toggle-target="icon" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-submit">
          {{ 'auth.login.form.submit'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </button>

        <p class="auth-hint">
          {{ 'auth.login.form.hint'|trans }}
          <a href="{{ path('show_register', en ? {lang: 'en'} : {}) }}">{{ 'auth.login.form.hint_link'|trans }}</a>
        </p>
      </form>

      <div data-auth-target="result" role="status" aria-live="polite"></div>

      <p class="auth-trust"><i class="fas fa-lock" aria-hidden="true"></i> {{ en ? 'Encrypted credentials · Manageable sessions' : 'Identifiants chiffrés · Sessions gérables' }}</p>
    </div>

  </div>
</div>

{% endblock %}
