{% extends 'base_auth.html.twig' %}

{% block title %}Inscription{% endblock %}
{% block body_class %}auth-form-page{% endblock %}

{% block body %}


<div class="auth-container">
  <div class="register-wrapper" data-controller="auth" data-auth-locale-value="{{ app.request.locale }}">

    <!-- Colonne gauche - Hero -->
    <div class="register-hero">
      <div class="hero-content">
        <div class="hero-icon">
          <img src="{{ asset('images/mykeynest-dot-mark.svg') }}" alt="" aria-hidden="true">
        </div>

        <h1>{{ 'auth.register.hero.title'|trans }}</h1>
        <p>{{ 'auth.register.hero.subtitle'|trans }}</p>

        <div class="hero-features">
          <div class="feature-item">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {{ 'auth.register.hero.features.f1'|trans }}
          </div>

          <div class="feature-item">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {{ 'auth.register.hero.features.f2'|trans }}
          </div>

          <div class="feature-item">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 0 002.25 2.25z" />
            </svg>
            {{ 'auth.register.hero.features.f3'|trans }}
          </div>
        </div>
      </div>
    </div>

    <!-- Colonne droite - Formulaire -->
    <div class="register-form-section">
      <div class="form-header">
        <h2>{{ 'auth.register.form.title'|trans }}</h2>
        <p>{{ 'auth.register.form.subtitle'|trans }}</p>
      </div>

      {% include 'components/auth/feedback.html.twig' %}
      <fieldset class="auth-account-types">
        <legend>{{ 'auth.register.form.account_type'|trans }}</legend>
        <label class="auth-account-type">
          <input type="radio" name="accountType" value="personal" checked form="register-form" data-auth-target="accountType" data-action="change->auth#changeAccountType" aria-controls="company-field">
          <span class="auth-account-type__mark" aria-hidden="true"></span>
          <span><strong>{{ 'auth.register.form.personal'|trans }}</strong><small>{{ 'auth.register.form.personal_hint'|trans }}</small></span>
        </label>
        <label class="auth-account-type">
          <input type="radio" name="accountType" value="professional" form="register-form" data-auth-target="accountType" data-action="change->auth#changeAccountType" aria-controls="company-field">
          <span class="auth-account-type__mark" aria-hidden="true"></span>
          <span><strong>{{ 'auth.register.form.professional'|trans }}</strong><small>{{ 'auth.register.form.professional_hint'|trans }}</small></span>
        </label>
      </fieldset>
        <div class="form-group auth-company-field" id="company-field" data-auth-target="companyField" hidden>
          <label for="company">{{ 'auth.register.form.company_label'|trans }}</label>
          <input
            type="text"
            id="company"
            data-auth-target="company"
            placeholder="{{ 'auth.register.form.company_placeholder'|trans }}"
            form="register-form"
            disabled
            maxlength="255"
            autocomplete="organization"
          >
        </div>

      {% include 'components/auth/google_button.html.twig' %}

      <form id="register-form" class="register-form" data-action="submit->auth#register">
        <div class="form-group">
          <label for="email">{{ 'auth.register.form.email_label'|trans }}</label>
          <input
            type="email"
            id="email"
            data-auth-target="email"
            placeholder="{{ 'auth.register.form.email_placeholder'|trans }}"
            required
            autocomplete="email"
          >
        </div>

        <div class="form-group">
          <label for="password">{{ 'auth.register.form.password_label'|trans }}</label>
          <input
            type="password"
            id="password"
            data-auth-target="password"
            placeholder="••••••••"
            required
            autocomplete="new-password"
          >
        </div>

        <button type="submit" class="btn-submit">
          {{ 'auth.register.form.submit'|trans }}
        </button>

        <p class="auth-hint">
          {{ 'auth.register.form.hint'|trans }}
          <a href="/login">{{ 'auth.register.form.hint_link'|trans }}</a>
        </p>
      </form>

      <p class="auth-free-note">{{ 'auth.register.form.free_note'|trans }}</p>
      <div data-auth-target="result" role="status" aria-live="polite"></div>
    </div>

  </div>
</div>


{% endblock %}
