<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
  <head>
    {% set currentRoute = app.request.attributes.get('_route') %}
    {% set routeParams = app.request.attributes.get('_route_params') ?? {} %}
    {% set queryParams = app.request.query.all %}
    {% set currentLocale = app.request.locale|default('fr') %}
    {% set seoPublicRoutes = [
      'app_landing',
      'app_public_generator',
      'app_help_center',
      'app_help_category',
      'app_help_article',
      'business_solution',
      'business_password_manager',
      'business_comparatif',
      'business_audit',
      'legal_cgu',
      'legal_cgv',
      'legal_privacy',
      'legal_mentions',
      'app_security'
    ] %}
    {% set sensitiveAuthRoutes = [
      'app_guest_register',
      'app_guest_shared_preview',
      'app_forgot_password_request',
      'app_check_email',
      'app_reset_password'
    ] %}
    {% set isSensitiveAuthRoute = currentRoute in sensitiveAuthRoutes %}
    {% set analyticsExcludedRoutes = sensitiveAuthRoutes|merge(['legal_privacy']) %}
    {% set canonicalUrl %}{% block canonical_url %}{% endblock %}{% endset %}
    {% set canonicalUrl = canonicalUrl|trim %}
    {% if canonicalUrl is empty %}
      {% if isSensitiveAuthRoute and currentRoute %}
        {% set canonicalUrl = url(currentRoute, routeParams) %}
      {% elseif currentRoute and currentRoute in seoPublicRoutes %}
        {% set canonicalQueryParams = {} %}
        {% if currentLocale == 'en' %}
          {% set canonicalQueryParams = canonicalQueryParams|merge({ lang: 'en' }) %}
        {% endif %}
        {% set canonicalUrl = url(currentRoute, routeParams|merge(canonicalQueryParams)) %}
      {% else %}
        {% set canonicalUrl = app.request.uri %}
      {% endif %}
    {% endif %}

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8fafc" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    {% set pageTitle %}{% block title %}MYKEYNEST — Gestionnaire de mots de passe et partage d’accès{% endblock %}{% endset %}
    {% set pageDescription %}{% block description %}{{ currentLocale == 'en' ? 'MYKEYNEST is a password manager for individuals and teams: encrypted credentials, access sharing and browser autofill.' : 'MYKEYNEST est un gestionnaire de mots de passe pour particuliers et équipes : identifiants chiffrés, partage d’accès et extension navigateur.' }}{% endblock %}{% endset %}
    <title>{{ pageTitle|trim }}</title>

    {% include 'components/parts/_theme_boot.html.twig' %}

    {% if currentRoute not in analyticsExcludedRoutes %}
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-RG9YT46TFS"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-RG9YT46TFS');
      </script>
    {% endif %}

      <meta name="description" content="{{ pageDescription|trim }}" />
      {% set keywords %}{% block keywords %}{% endblock %}{% endset %}
      {% set keywords = keywords|trim %}
      {% if keywords is not empty %}
        <meta name="keywords" content="{{ keywords }}" />
      {% endif %}
      <meta name="author" content="MYKEYNEST" />
      <meta name="robots" content="{% block robots %}{% if isSensitiveAuthRoute %}noindex,nofollow,noarchive{% elseif currentRoute not in seoPublicRoutes and currentRoute != 'app_install_app' %}noindex,follow{% else %}index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1{% endif %}{% endblock %}" />
      <meta name="referrer" content="{% if isSensitiveAuthRoute %}no-referrer{% else %}strict-origin-when-cross-origin{% endif %}" />

      <meta property="og:type" content="{% block og_type %}website{% endblock %}" />
      <meta property="og:site_name" content="MYKEYNEST" />
      <meta property="og:locale" content="{% block og_locale %}{{ app.request.locale == 'en' ? 'en_US' : 'fr_FR' }}{% endblock %}" />
      <meta property="og:url" content="{{ canonicalUrl }}" />
      <meta property="og:title" content="{% block og_title %}{{ pageTitle|trim }}{% endblock %}" />
      <meta property="og:description" content="{% block og_description %}{{ pageDescription|trim }}{% endblock %}" />
      <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/seo/gestoinnaire-mots-passes.webp')) }}{% endblock %}" />
      <meta property="og:image:alt" content="MYKEYNEST — {{ currentLocale == 'en' ? 'Password manager' : 'Gestionnaire de mots de passe' }}" />

      <meta name="twitter:card" content="{% block twitter_card %}summary_large_image{% endblock %}" />
      <meta name="twitter:url" content="{{ canonicalUrl }}" />
      <meta name="twitter:title" content="{% block twitter_title %}{{ pageTitle|trim }}{% endblock %}" />
      <meta name="twitter:description" content="{% block twitter_description %}{{ pageDescription|trim }}{% endblock %}" />
      <meta name="twitter:image" content="{% block twitter_image %}{{ absolute_url(asset('images/seo/gestoinnaire-mots-passes.webp')) }}{% endblock %}" />

    <link rel="canonical" href="{{ canonicalUrl }}" />

    {% if currentRoute in seoPublicRoutes %}
      {% set hreflangBaseParams = routeParams %}
      {% set frUrl = currentLocale == 'fr'
        ? canonicalUrl
        : url(currentRoute, hreflangBaseParams) %}
      {% set enUrl = currentLocale == 'en'
        ? canonicalUrl
        : url(currentRoute, hreflangBaseParams|merge({ lang: 'en' })) %}
      {% set defaultUrl = url(currentRoute, hreflangBaseParams) %}

      <link rel="alternate" hreflang="fr" href="{{ frUrl }}" />
      {% if currentRoute not in ['legal_cgu', 'legal_cgv', 'legal_privacy'] %}
        <link rel="alternate" hreflang="en" href="{{ enUrl }}" />
      {% endif %}
      <link rel="alternate" hreflang="x-default" href="{{ defaultUrl }}" />
    {% endif %}

    <link rel="icon" href="{{ asset('favicon.ico') }}?v=4" sizes="any" />
    <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}?v=4" />
    <link rel="manifest" href="{{ asset('manifest.webmanifest') }}?v=4" />
    <link rel="alternate" type="text/markdown" title="LLMs" href="{{ absolute_url(asset('llms.txt')) }}" />

    {% set externalIconExcludedRoutes = ['app_guest_register', 'app_guest_shared_preview'] %}
    {% if currentRoute not in externalIconExcludedRoutes %}
      <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
      <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />

      <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      />
    {% endif %}

    {% block head_extras %}{% endblock %}
    {% block stylesheets %}{% endblock %}
    {% block page_styles %}{% endblock %}
    {% if currentRoute in ['show_login', 'show_register', 'app_guest_register'] %}
      <link rel="stylesheet" href="{{ asset('styles/pages/auth-forms.css') }}" />
    {% endif %}
    {% if currentRoute in ['app_forgot_password_request', 'app_check_email', 'app_reset_password'] %}
      <link rel="stylesheet" href="{{ asset('styles/pages/reset-password.css') }}" />
    {% endif %}
    {% block javascripts %}
      {% block importmap %}{{ importmap('public') }}{% endblock %}
    {% endblock %}

    <link rel="stylesheet" href="{{ asset('styles/pages/public-shell.css') }}" />

    {% include 'components/seo/_organization.html.twig' %}
    {% block seo_jsonld %}{% endblock %}
  </head>

  <body class="auth-layout public-page {% block body_class %}{% endblock %}" data-controller="pwa-install">
    {% set route = app.request.attributes.get('_route') %}

    {% if route in ['show_login', 'show_register', 'app_pending_login', 'app_guest_register'] %}
      {% include 'components/parts/_public_auth_header.html.twig' %}
    {% else %}
      {% include 'components/nav.html.twig' %}
    {% endif %}

    {% block body %}{% endblock %}
    {% if route not in ['show_login', 'show_register', 'app_pending_login', 'app_guest_register', 'app_guest_shared_preview'] %}
      {% block public_footer %}
        {% include 'components/parts/_public_footer.html.twig' %}
      {% endblock %}
    {% endif %}
    {% set supportChatExcludedRoutes = [
      'show_login',
      'show_register',
      'app_pending_login',
      'app_guest_register',
      'app_guest_shared_preview',
      'app_forgot_password_request',
      'app_check_email',
      'app_reset_password'
    ] %}
    {% if route not in supportChatExcludedRoutes %}
      {{ render(path('app_support_chat_widget')) }}
    {% endif %}
    {% if app.request.hasPreviousSession %}
      {% include './components/parts/_toasts.html.twig' %}
    {% endif %}
  </body>
</html>
