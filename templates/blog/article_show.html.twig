{% extends 'base.blog.html.twig' %}

{% block seo_title %}{{ vm.seoTitle }}{% endblock %}
{% block seo_description %}{{ vm.metaDesc }}{% endblock %}

{% block seo_hreflang %}
    <link rel="alternate" hreflang="fr" href="{{ vm.url_fr }}">
    <link rel="alternate" hreflang="en" href="{{ vm.url_en }}">
    <link rel="alternate" hreflang="x-default" href="{{ vm.url_en }}">
{% endblock %}

{% block seo_canonical %}
    <link rel="canonical" href="{{ vm.canonical }}">
{% endblock %}

{% block seo_open_graph %}
    <meta property="og:title" content="{{ vm.seoTitle }}">
    <meta property="og:description" content="{{ vm.metaDesc }}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ vm.canonical }}">
    <meta property="og:locale" content="{{ vm.ogLocale }}">
    <meta property="og:locale:alternate" content="fr_FR">
    <meta property="og:locale:alternate" content="en_US">
    {% if vm.coverImage %}
        <meta property="og:image" content="{{ absolute_url(asset('uploads/blog/' ~ vm.coverImage)) }}">
        <meta property="og:image:alt" content="{{ vm.coverAlt }}">
    {% endif %}
{% endblock %}

{% block seo_twitter %}
    <meta name="twitter:card" content="{{ vm.coverImage ? 'summary_large_image' : 'summary' }}">
    <meta name="twitter:title" content="{{ vm.seoTitle }}">
    <meta name="twitter:description" content="{{ vm.metaDesc }}">
    {% if vm.coverImage %}
        <meta name="twitter:image" content="{{ absolute_url(asset('uploads/blog/' ~ vm.coverImage)) }}">
        <meta name="twitter:image:alt" content="{{ vm.coverAlt }}">
    {% endif %}
{% endblock %}

{% block seo_jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": "{{ vm.canonical|e('js') }}",
  "headline": "{{ vm.h1|e('js') }}",
  "description": "{{ vm.metaDesc|e('js') }}",
  "datePublished": "{{ vm.publishedAt|date('c') }}",
  "dateModified": "{{ vm.updatedAt|date('c') }}",
  "inLanguage": "{{ app.request.locale|e('js') }}",
{% if vm.coverImage %}
  "image": "{{ absolute_url(asset('uploads/blog/' ~ vm.coverImage))|e('js') }}",
{% endif %}
  "author": { "@type": "Organization", "name": "MyKeyNest" },
  "publisher": { "@type": "Organization", "name": "MyKeyNest" }
}
</script>
{% endblock %}

{% block main_class %}blog-main--article{% endblock %}

{% block body %}
{% set isEn = app.request.locale == 'en' %}
<div class="article-back-row">
    <a class="article-back" href="{{ path('blog_index', {_locale: app.request.locale}) }}">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        {{ isEn ? 'All guides' : 'Tous les guides' }}
    </a>
</div>

<article class="article-shell" itemscope itemtype="https://schema.org/Article">
    <header class="article-header">
        <span class="article-kicker"><i class="fa-regular fa-newspaper" aria-hidden="true"></i> {{ isEn ? 'Practical guide' : 'Guide pratique' }}</span>
        <h1 class="blog-page-title" itemprop="headline">{{ vm.h1 }}</h1>

        <div class="article-meta">
            <span class="article-meta__item">
                <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                <time datetime="{{ vm.publishedAt|date('Y-m-d') }}">
                {% if app.request.locale == 'fr' %}
                    {{ vm.publishedAt|date('d/m/Y') }}
                {% else %}
                    {{ vm.publishedAt|date('M d, Y') }}
                {% endif %}
                </time>
            </span>
            <span class="article-meta__item"><i class="fa-regular fa-clock" aria-hidden="true"></i> {{ app.request.locale == 'fr' ? 'Lecture ' ~ vm.readingMinutes ~ ' min' : vm.readingMinutes ~ ' min read' }}</span>
        </div>
    </header>

    {% if vm.coverImage %}
        <figure class="article-hero">
            <img src="{{ asset('uploads/blog/' ~ vm.coverImage) }}"
                 alt="{{ vm.coverAlt }}"
                 decoding="async"
                 fetchpriority="high">
        </figure>
    {% endif %}

    <section class="blog-content" itemprop="articleBody">
        {{ vm.content|raw }}
    </section>
</article>

{% include 'components/seo/_internal_links.html.twig' with {
  compact: true,
  sectionTitle: isEn ? 'Related pages to continue after this article' : 'Pour aller plus loin',
  sectionSubtitle: isEn ? 'Move from reading to action with four useful next steps.' : 'Passez de la lecture à l’action avec quatre ressources vraiment utiles.',
  links: [
    {
      route: 'business_password_manager',
      params: app.request.locale == 'en' ? { lang: 'en' } : {},
      icon: 'fa-solid fa-key',
      label: isEn ? 'Product page' : 'Page produit',
      kicker: isEn ? 'Secure access' : 'Accès sécurisés',
      title: isEn ? 'Enterprise password manager for SMBs' : 'Gestionnaire de mots de passe entreprise pour PME',
      text: isEn ? 'See the core product and key access-control features.' : 'Voir le produit central et ses fonctions clefs.',
      image: 'images/seo/gestoinnaire-mots-passes.png',
      imageAlt: isEn ? 'Password manager dashboard illustration' : 'Illustration gestionnaire de mots de passe'
    },
    {
      route: 'business_comparatif',
      params: app.request.locale == 'en' ? { lang: 'en' } : {},
      icon: 'fa-solid fa-scale-balanced',
      label: isEn ? 'Comparison' : 'Comparatif',
      kicker: isEn ? 'Vendor choice' : 'Choix fournisseur',
      title: isEn ? 'Compare MYKEYNEST with Dashlane and Bitwarden' : 'Comparer MYKEYNEST à Dashlane et Bitwarden',
      text: isEn ? 'Useful if the reader is already evaluating alternatives.' : 'Utile si le lecteur compare deja des alternatives.',
      image: 'images/seo/comparatif.png',
      imageAlt: isEn ? 'Software comparison illustration' : 'Illustration comparatif logiciel'
    },
    {
      route: 'app_help_center',
      params: app.request.locale == 'en' ? { lang: 'en' } : {},
      icon: 'fa-solid fa-circle-question',
      label: isEn ? 'Help center' : 'Centre d’aide',
      kicker: isEn ? 'Implementation' : 'Mise en place',
      title: isEn ? 'Setup guides and practical documentation' : 'Guides de mise en place et documentation',
      text: isEn ? 'Answer product questions without leaving the site.' : 'Repondre aux questions produit sans quitter le site.',
      image: 'images/seo/help.png',
      imageAlt: isEn ? 'Documentation and onboarding illustration' : 'Illustration documentation et onboarding'
    },
    {
      route: 'business_audit',
      params: app.request.locale == 'en' ? { lang: 'en' } : {},
      icon: 'fa-solid fa-shield-virus',
      label: isEn ? 'Cyber services' : 'Services cyber',
      kicker: isEn ? 'Risk reduction' : 'Réduction du risque',
      title: isEn ? 'Cybersecurity audit and awareness services' : 'Audit cybersécurité et sensibilisation',
      text: isEn ? 'Explore phishing, awareness, and SMB security support.' : 'Explorer phishing, sensibilisation et accompagnement PME.',
      image: 'images/seo/audit.png',
      imageAlt: isEn ? 'Cybersecurity audit illustration' : 'Illustration audit cybersécurité'
    }
  ]
} only %}
{% endblock %}

{% block footer %}
<section class="blog-cta-shell" aria-labelledby="blog-cta-title">
    <div class="cta-container">
        {% if app.request.locale == 'fr' %}
            <span class="cta-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
            <h2 class="cta-title" id="blog-cta-title">Prêt à mieux contrôler vos accès ?</h2>
            <p class="cta-description">Centralisez vos identifiants et partagez les accès utiles avec MYKEYNEST.</p>
            <a href="{{ path('show_register') }}" class="cta-button" aria-label="Créer un compte MyKeyNest">
                Essayer gratuitement
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        {% else %}
            <span class="cta-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
            <h2 class="cta-title" id="blog-cta-title">Ready to take control of your access?</h2>
            <p class="cta-description">Centralize credentials and share useful access with MYKEYNEST.</p>
            <a href="{{ path('show_register') }}" class="cta-button" aria-label="Create a MyKeyNest account">
                Try it free
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        {% endif %}
    </div>
</section>
{% include 'components/parts/_public_footer.html.twig' %}
{% endblock %}
