{% set sectionTitle = sectionTitle|default(app.request.locale == 'en' ? 'Continue exploring MYKEYNEST' : 'Continuer sur MYKEYNEST') %}
{% set sectionSubtitle = sectionSubtitle|default(app.request.locale == 'en' ? 'Move from discovery to action with the pages that clarify positioning, comparison, support, and implementation.' : 'Passez de la découverte à l’action avec les pages qui clarifient le positionnement, la comparaison, le support et la mise en place.') %}
{% set links = links|default([]) %}
{% set compact = compact|default(false) %}

<section class="seo-links-band {{ compact ? 'seo-links-band--compact' : '' }}" aria-labelledby="seo-links-title">
  <div class="seo-links-band__header">
    <div class="seo-links-band__head">
      <span class="seo-links-band__eyebrow">
        <i class="fa-solid fa-compass" aria-hidden="true"></i>
        {{ app.request.locale == 'en' ? 'Explore MYKEYNEST' : 'À découvrir' }}
      </span>
      <h2 id="seo-links-title">{{ sectionTitle }}</h2>
      <p>{{ sectionSubtitle }}</p>
    </div>
    <span class="seo-links-band__header-icon" aria-hidden="true">
      <i class="fa-solid fa-arrow-trend-up"></i>
    </span>
  </div>

  <div class="seo-links-band__grid">
    {% for link in links %}
      <a href="{{ path(link.route, link.params|default({})) }}" class="seo-links-band__card" aria-label="{{ link.title }}">
        <div class="seo-links-band__visual">
          {% if link.image is defined and link.image is not empty %}
            <img src="{{ asset(link.image) }}" alt="{{ link.imageAlt|default(link.title) }}" loading="lazy">
          {% endif %}
          <div class="seo-links-band__visual-overlay">
            <span class="seo-links-band__visual-kicker">{{ link.kicker|default(link.label) }}</span>
            <span class="seo-links-band__visual-icon">
              <i class="{{ link.icon|default('fa-solid fa-arrow-right') }}" aria-hidden="true"></i>
            </span>
          </div>
        </div>
        <div class="seo-links-band__content">
          <span class="seo-links-band__label">
            <i class="{{ link.icon|default('fa-solid fa-arrow-right') }}" aria-hidden="true"></i>
            {{ link.label }}
          </span>
          <strong>{{ link.title }}</strong>
          <p>{{ link.text }}</p>
          <span class="seo-links-band__action">
            {{ app.request.locale == 'en' ? 'Discover' : 'Découvrir' }}
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
