<!-- === SIDEBAR === -->
<aside class="sidebar" data-layout-target="sidebar">
  <div class="sidebar-header">
    <div class="logo-container">
      {% include 'components/parts/logo.html.twig' %}
    </div>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section">
      <div class="nav-section-title">
        Admin
      </div>

      <a href="{{ path('app_admin') }}"
         class="nav-item {{ app.request.attributes.get('_route') == 'app_admin' ? 'active' : '' }}">
        <i class="fas fa-house"></i>
        <span>Dashboard</span>
      </a>

      <a href="{{ path('admin_blog') }}"
         class="nav-item {{ app.request.attributes.get('_route') in ['admin_blog', 'admin_article_new', 'admin_article_edit'] ? 'active' : '' }}">
        <i class="fas fa-newspaper"></i>
        <span>Blog</span>
      </a>

      {% set subscriptionAdminRoutes = ['admin_subscriptions', 'admin_subscription_plans', 'admin_subscription_payment', 'admin_user_subscription_assign_pro', 'admin_user_subscription_deactivate'] %}
      <a href="{{ path('admin_subscriptions') }}"
         class="nav-item nav-item--parent {{ app.request.attributes.get('_route') in subscriptionAdminRoutes ? 'active' : '' }}">
        <i class="fas fa-credit-card"></i>
        <span>Subscriptions</span>
        <i class="fas fa-chevron-down nav-item-chevron" aria-hidden="true"></i>
      </a>
      <div class="nav-submenu" aria-label="Sous-menu subscriptions">
        <a href="{{ path('admin_subscriptions') }}"
           class="nav-subitem {{ app.request.attributes.get('_route') == 'admin_subscriptions' ? 'active' : '' }}">
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
          <span>Gestion</span>
        </a>
        <a href="{{ path('admin_subscription_plans') }}"
           class="nav-subitem {{ app.request.attributes.get('_route') == 'admin_subscription_plans' ? 'active' : '' }}">
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
          <span>Plans</span>
        </a>
        <a href="{{ path('admin_subscription_payment') }}"
           class="nav-subitem {{ app.request.attributes.get('_route') == 'admin_subscription_payment' ? 'active' : '' }}">
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
          <span>{{ 'admin_payment.nav'|trans }}</span>
        </a>
      </div>

      <a href="{{ path('admin_sessions') }}"
         class="nav-item {{ app.request.attributes.get('_route') in ['admin_sessions', 'admin_session_revoke', 'admin_session_block_device', 'admin_session_unblock_device'] ? 'active' : '' }}">
        <i class="fas fa-user-shield"></i>
        <span>Sessions</span>
      </a>

      <a href="{{ path('admin_extensions') }}"
         class="nav-item {{ app.request.attributes.get('_route') in ['admin_extensions', 'admin_extension_client_block', 'admin_extension_client_unblock', 'admin_extension_client_revoke', 'admin_extension_challenge_approve', 'admin_extension_challenge_reject'] ? 'active' : '' }}">
        <i class="fas fa-puzzle-piece"></i>
        <span>Extension install</span>
      </a>

      <a href="{{ path('admin_emailing') }}"
         class="nav-item {{ app.request.attributes.get('_route') == 'admin_emailing' ? 'active' : '' }}">
        <i class="fas fa-envelope"></i>
        <span>Emailing</span>
      </a>

      <a href="{{ path('admin_chat') }}"
         class="nav-item {{ app.request.attributes.get('_route') in ['admin_chat', 'admin_chat_reply', 'admin_chat_close', 'admin_chat_delete'] ? 'active' : '' }}">
        <i class="fas fa-comments"></i>
        <span>Chat</span>
        {% set supportChatUnreadCount = support_chat_unread_count() %}
        {% if supportChatUnreadCount > 0 %}
          <span class="nav-item-badge">{{ supportChatUnreadCount > 99 ? '99+' : supportChatUnreadCount }}</span>
        {% endif %}
      </a>

      <a href="{{ path('admin_teams') }}"
         class="nav-item {{ app.request.attributes.get('_route') in ['admin_teams', 'admin_team_show', 'admin_team_member_add', 'admin_team_member_remove', 'admin_team_delete'] ? 'active' : '' }}">
        <i class="fas fa-users"></i>
        <span>Teams</span>
      </a>
    </div>
  </nav>

  <div class="sidebar-footer">
    <a href="#"
      class="logout-btn"
      data-controller="auth"
      data-action="click->auth#logout">
      <i class="fas fa-sign-out-alt"></i>
      <span>Logout</span>
    </a>
  </div>
</aside>
