<dialog id="credential-launch-dialog" class="credential-launch-dialog"
        data-credential-index-target="launchDialog"
        data-action="click->credential-index#dismissLaunch close->credential-index#launchClosed"
        aria-labelledby="credential-launch-title"
        aria-describedby="credential-launch-description">
  <div class="credential-launch-head">
    <span class="credential-launch-symbol"><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
    <button type="button" class="credential-launch-close" autofocus
            aria-label="{{ 'credential.index.launch.close'|trans }}"
            data-action="click->credential-index#closeLaunch">
      <i class="fas fa-times" aria-hidden="true"></i>
    </button>
  </div>

  <div class="credential-launch-content">
    <p class="credential-launch-eyebrow">{{ 'credential.index.launch.eyebrow'|trans }}</p>
    <h2 id="credential-launch-title">{{ 'credential.index.launch.title'|trans }}</h2>
    <p id="credential-launch-description" class="credential-launch-description">{{ 'credential.index.launch.description'|trans }}</p>

    <div class="credential-launch-account">
      <span class="credential-launch-initial" data-credential-index-target="launchInitial"></span>
      <div>
        <strong data-credential-index-target="launchName"></strong>
        <span data-credential-index-target="launchUsername"></span>
      </div>
      <i class="fas fa-key" aria-hidden="true"></i>
    </div>

    <input type="hidden" data-credential-index-target="launchUrl">
    <p class="credential-launch-hint"><i class="fas fa-shield-halved" aria-hidden="true"></i> {{ 'credential.index.launch.destination_hint'|trans }}</p>

    <div class="credential-launch-autofill">
      <div class="credential-launch-autofill-heading">
        <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
        <strong>{{ 'credential.index.launch.autofill_title'|trans }}</strong>
        <span class="credential-launch-badge" data-credential-index-target="launchState" role="status">{{ 'credential.index.launch.checking'|trans }}</span>
      </div>
      <p data-credential-index-target="launchDescription">{{ 'credential.index.launch.checking_description'|trans }}</p>
      <a href="{{ path('app_extention') }}" data-credential-index-target="launchExtension" data-settings-url="{{ path('app_extention') }}" data-reconnect-url="{{ path('app_extention', {reconnect: 1}) }}">{{ 'credential.index.launch.extension'|trans }}</a>
    </div>
  </div>

  <div class="credential-launch-footer">
    <button type="button" class="credential-launch-open credential-launch-fill" hidden disabled
            data-credential-index-target="launchFill" data-action="click->credential-index#launchAndFill">
      {{ 'credential.index.launch.button'|trans }} <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
    </button>
    <a class="credential-launch-open" target="_blank" rel="noopener noreferrer" aria-disabled="true"
       data-credential-index-target="launchLink" data-action="click->credential-index#openLaunchSite">
      {{ 'credential.index.launch.open_site'|trans }} <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
    </a>
    <p class="credential-launch-feedback" role="status" data-credential-index-target="launchFeedback"></p>
    <p>{{ 'credential.index.launch.open_hint'|trans }}</p>
  </div>
</dialog>
