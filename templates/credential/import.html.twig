{% extends 'base.html.twig' %}

{% block title %}{{ 'credential.import.meta_title'|trans }}{% endblock %}

{% block body %}
<div class="credential-import"
     data-controller="credential-import"
     data-credential-import-max-size-value="{{ maxFileSize }}"
     data-credential-import-invalid-type-value="{{ 'credential.import.client.invalid_type'|trans }}"
     data-credential-import-too-large-value="{{ 'credential.import.client.too_large'|trans({'%size%': 5}) }}"
     data-credential-import-invalid-columns-value="{{ 'credential.import.client.invalid_columns'|trans }}"
     data-credential-import-file-ready-value="{{ 'credential.import.client.file_ready'|trans }}">
  <header class="credential-import__hero">
    <div>
      <a href="{{ path('app_credential') }}" class="credential-import__back" data-turbo="true" data-turbo-action="advance">
        <i class="fas fa-arrow-left" aria-hidden="true"></i>
        {{ 'credential.import.back'|trans }}
      </a>
      <span class="credential-import__eyebrow">{{ 'credential.import.eyebrow'|trans }}</span>
      <h1>{{ 'credential.import.title'|trans }}</h1>
      <p>{{ 'credential.import.subtitle'|trans }}</p>
    </div>
    <div class="credential-import__hero-icon" aria-hidden="true">
      <i class="fas fa-file-arrow-up"></i>
      <span><i class="fas fa-lock"></i></span>
    </div>
  </header>

  <ol class="credential-import__steps" aria-label="{{ 'credential.import.steps.aria'|trans }}">
    <li class="is-complete">
      <span><i class="fas fa-check" aria-hidden="true"></i></span>
      <div><strong>{{ 'credential.import.steps.prepare.title'|trans }}</strong><small>{{ 'credential.import.steps.prepare.text'|trans }}</small></div>
    </li>
    <li class="is-active">
      <span>2</span>
      <div><strong>{{ 'credential.import.steps.select.title'|trans }}</strong><small>{{ 'credential.import.steps.select.text'|trans }}</small></div>
    </li>
    <li>
      <span>3</span>
      <div><strong>{{ 'credential.import.steps.import.title'|trans }}</strong><small>{{ 'credential.import.steps.import.text'|trans }}</small></div>
    </li>
  </ol>

  <div class="credential-import__grid">
    <section class="credential-import-card credential-import-card--format">
      <div class="credential-import-card__heading">
        <span class="credential-import-card__number">1</span>
        <div>
          <h2>{{ 'credential.import.format.title'|trans }}</h2>
          <p>{{ 'credential.import.format.subtitle'|trans }}</p>
        </div>
      </div>

      <div class="credential-import__columns" aria-label="{{ 'credential.import.format.columns_aria'|trans }}">
        <span><i class="fas fa-tag" aria-hidden="true"></i> name <small>{{ 'credential.import.format.optional'|trans }}</small></span>
        <span><i class="fas fa-globe" aria-hidden="true"></i> domain</span>
        <span><i class="fas fa-user" aria-hidden="true"></i> username</span>
        <span><i class="fas fa-key" aria-hidden="true"></i> password</span>
      </div>

      <div class="credential-import__preview">
        <div class="credential-import__preview-header">
          <span>{{ 'credential.import.example.preview'|trans }}</span>
          <span class="credential-import__file-badge">CSV</span>
        </div>
        <div class="credential-import__preview-table" role="table" aria-label="{{ 'credential.import.example.table_aria'|trans }}">
          <div role="row" class="is-header">
            <span role="columnheader">name</span><span role="columnheader">domain</span><span role="columnheader">username</span><span role="columnheader">password</span>
          </div>
          <div role="row">
            <span role="cell">{{ 'credential.import.example.account'|trans }}</span><span role="cell">example.com</span><span role="cell">user@example.com</span><span role="cell">••••••••••</span>
          </div>
        </div>
      </div>

      <a href="{{ path('credential_import_example') }}" class="credential-import__download" data-turbo="false" download>
        <span><i class="fas fa-download" aria-hidden="true"></i></span>
        <div>
          <strong>{{ 'credential.import.example.download'|trans }}</strong>
          <small>{{ 'credential.import.example.download_hint'|trans }}</small>
        </div>
        <i class="fas fa-arrow-down" aria-hidden="true"></i>
      </a>

      <div class="credential-import__sources">
        <span>{{ 'credential.import.sources.label'|trans }}</span>
        <p>{{ 'credential.import.sources.list'|trans }}</p>
      </div>
    </section>

    <section class="credential-import-card credential-import-card--upload">
      <div class="credential-import-card__heading">
        <span class="credential-import-card__number">2</span>
        <div>
          <h2>{{ 'credential.import.upload.title'|trans }}</h2>
          <p>{{ 'credential.import.upload.subtitle'|trans }}</p>
        </div>
      </div>

      {% if remainingCredentialCount is same as(0) %}
        <div class="credential-import__capacity credential-import__capacity--full">
          <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
          <div>
            <strong>{{ 'credential.import.capacity.full_title'|trans }}</strong>
            <p>{{ 'credential.import.capacity.full_text'|trans({'%limit%': credentialLimit}) }}</p>
          </div>
          <a href="{{ path('app_subscription') }}">{{ 'credential.import.capacity.upgrade'|trans }}</a>
        </div>
      {% else %}
        <form method="post" enctype="multipart/form-data" data-action="submit->credential-import#submit">
          <input type="hidden" name="_token" value="{{ csrf_token('credential_csv_import') }}">

          <div class="credential-import__dropzone"
               data-credential-import-target="dropzone"
               data-action="dragenter->credential-import#dragEnter dragover->credential-import#dragOver dragleave->credential-import#dragLeave drop->credential-import#drop">
            <input type="file"
                   name="csv_file"
                   id="csv_file"
                   accept=".csv,text/csv,application/csv"
                   required
                   data-credential-import-target="input"
                   data-action="change->credential-import#fileChanged">

            <label for="csv_file" class="credential-import__dropzone-empty" data-credential-import-target="emptyState">
              <span class="credential-import__upload-icon"><i class="fas fa-cloud-arrow-up" aria-hidden="true"></i></span>
              <strong>{{ 'credential.import.upload.choose'|trans }}</strong>
              <small>{{ 'credential.import.upload.drop'|trans }}</small>
              <em>{{ 'credential.import.upload.constraints'|trans }}</em>
            </label>

            <div class="credential-import__selected" data-credential-import-target="selectedState" hidden>
              <span class="credential-import__selected-icon"><i class="fas fa-file-csv" aria-hidden="true"></i></span>
              <div>
                <strong data-credential-import-target="fileName"></strong>
                <small data-credential-import-target="fileSize"></small>
              </div>
              <button type="button" data-action="click->credential-import#clear" aria-label="{{ 'credential.import.upload.remove'|trans }}">
                <i class="fas fa-xmark" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <p class="credential-import__feedback" data-credential-import-target="feedback" aria-live="polite"></p>

          <div class="credential-import__capacity">
            <i class="fas fa-layer-group" aria-hidden="true"></i>
            <span>
              {% if remainingCredentialCount is null %}
                {{ 'credential.import.capacity.unlimited'|trans }}
              {% else %}
                {{ 'credential.import.capacity.remaining'|trans({'%remaining%': remainingCredentialCount, '%limit%': credentialLimit}) }}
              {% endif %}
            </span>
          </div>

          <button type="submit" class="credential-import__submit" disabled data-credential-import-target="submitButton">
            <i class="fas fa-file-import" aria-hidden="true"></i>
            <span data-credential-import-target="submitLabel"
                  data-default-label="{{ 'credential.import.upload.submit'|trans }}"
                  data-loading-label="{{ 'credential.import.upload.submitting'|trans }}">{{ 'credential.import.upload.submit'|trans }}</span>
            <i class="fas fa-arrow-right" aria-hidden="true"></i>
          </button>
        </form>
      {% endif %}
    </section>
  </div>

  <aside class="credential-import__security">
    <span><i class="fas fa-shield-halved" aria-hidden="true"></i></span>
    <div>
      <strong>{{ 'credential.import.security.title'|trans }}</strong>
      <p>{{ 'credential.import.security.text'|trans }}</p>
    </div>
  </aside>
</div>
{% endblock %}
