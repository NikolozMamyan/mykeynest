{% extends 'base.html.twig' %}

{% block title %}{{ 'credential.import.result_page.meta_title'|trans }}{% endblock %}

{% block body %}
<div class="credential-import credential-import-result">
  <header class="credential-import-result__hero {{ result.imported == 0 ? 'is-warning' : '' }}">
    <span class="credential-import-result__icon" aria-hidden="true">
      <i class="fas {{ result.imported > 0 ? 'fa-check' : 'fa-circle-info' }}"></i>
    </span>
    <span class="credential-import__eyebrow">{{ 'credential.import.result_page.eyebrow'|trans }}</span>
    <h1>{{ result.imported > 0 ? 'credential.import.result_page.title'|trans : 'credential.import.result_page.empty_title'|trans }}</h1>
    <p>{{ 'credential.import.result_page.subtitle'|trans }}</p>
  </header>

  <section class="credential-import-result__stats" aria-label="{{ 'credential.import.result_page.summary_aria'|trans }}">
    <div class="is-success">
      <span><i class="fas fa-shield" aria-hidden="true"></i></span>
      <strong>{{ result.imported }}</strong>
      <small>{{ 'credential.import.result_page.imported'|trans }}</small>
    </div>
    <div class="is-warning">
      <span><i class="fas fa-forward" aria-hidden="true"></i></span>
      <strong>{{ result.skipped }}</strong>
      <small>{{ 'credential.import.result_page.skipped'|trans }}</small>
    </div>
    <div class="is-error">
      <span><i class="fas fa-triangle-exclamation" aria-hidden="true"></i></span>
      <strong>{{ result.failed }}</strong>
      <small>{{ 'credential.import.result_page.failed'|trans }}</small>
    </div>
  </section>

  <section class="credential-import-result__details">
    <div class="credential-import-result__details-head">
      <div>
        <h2>{{ 'credential.import.result_page.details'|trans }}</h2>
        <p>{{ 'credential.import.result_page.details_hint'|trans }}</p>
      </div>
      <span>{{ 'credential.import.result_page.processed'|trans({'%count%': result.processed}) }}</span>
    </div>

    <div class="credential-import-result__list">
      {% for item in result.items %}
        <article class="credential-import-result__row is-{{ item.status }}">
          <span class="credential-import-result__row-icon" aria-hidden="true">
            <i class="fas {% if item.status == 'success' %}fa-check{% elseif item.status == 'warning' %}fa-exclamation{% else %}fa-xmark{% endif %}"></i>
          </span>
          <div>
            <small>{{ 'credential.import.result_page.line'|trans({'%line%': item.line}) }}</small>
            <p>{{ item.message }}</p>
          </div>
        </article>
      {% else %}
        <div class="credential-import-result__no-detail">{{ 'credential.import.result_page.no_detail'|trans }}</div>
      {% endfor %}
    </div>
  </section>

  <div class="credential-import-result__actions">
    <a href="{{ path('app_credential') }}" class="credential-import-result__primary" data-turbo="true" data-turbo-action="advance">
      <i class="fas fa-key" aria-hidden="true"></i>
      {{ 'credential.import.result_page.open_vault'|trans }}
    </a>
    <a href="{{ path('credential_import') }}" class="credential-import-result__secondary" data-turbo="true" data-turbo-action="advance">
      <i class="fas fa-rotate" aria-hidden="true"></i>
      {{ 'credential.import.result_page.new_import'|trans }}
    </a>
  </div>
</div>
{% endblock %}
