{# templates/credential/index.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}{{ 'credential.index.meta.title'|trans }}{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('styles/pages/credential-index.css') }}">
{% endblock %}
{% block page_styles %}
<link rel="stylesheet" href="{{ asset('styles/pages/credential-quick-share.css') }}">
{% endblock %}
{% block body %}

{% set launchMessages = {} %}
{% for key in ['button', 'open_site', 'checking', 'checking_description', 'missing', 'missing_description', 'unpaired', 'unpaired_description', 'outdated', 'outdated_description', 'ready', 'ready_description', 'extension', 'reconnect', 'saving', 'saved', 'save_error', 'opening', 'opened', 'launch_error', 'extension_account_mismatch', 'credential_domain_mismatch', 'credential_access_denied', 'domain_excluded'] %}
  {% set launchMessages = launchMessages|merge({(key): ('credential.index.launch.' ~ key)|trans}) %}
{% endfor %}
<div class="pm-wrap" data-controller="credential-index" data-credential-index-user-id-value="{{ app.user.id }}" data-credential-index-launch-messages-value="{{ launchMessages|json_encode|e('html_attr') }}">

  {# ?? HEADER ?? #}
  <div class="pm-header">
    <div class="pm-header-left">
      <h1><i class="fas fa-shield-alt"></i> {{ 'credential.index.header.title'|trans }}</h1>
      <p>{{ 'credential.index.header.subtitle'|trans }}</p>
    </div>
  </div>

  {# Counts are used for limits and conditional sections; no visual stats row. #}
  {% set totalMine   = credentials|length %}
  {% set totalShared = sharedAccesses|length %}
  {% set totalTeamShared = teamSharedCredentials|default([])|length %}

  {# ?? PRO BANNER ?? #}
  {% if credentialLimit is not null and totalMine >= credentialLimit %}
    <div class="pro-banner">
      <div class="pro-banner-left">
        <div class="pro-icon"><i class="fas fa-crown"></i></div>
        <div>
          <h3>{{ 'credential.pro_banner.title'|trans }}</h3>
          <p>{{ 'credential.pro_banner.description'|trans({'%limit%': credentialLimit}) }}</p>
        </div>
      </div>
      <a href="{{ path('app_subscription') }}" class="btn-upgrade">
          <i class="fas fa-star"></i> {{ 'credential.pro_banner.action'|trans }}
      </a>
    </div>
  {% endif %}

  {# ?? TOOLBAR ?? #}
  <div class="pm-toolbar">
    <div class="pm-search">
      <i class="fas fa-search"></i>
      <input type="text" id="searchInput" placeholder="{{ 'credential.index.search.placeholder'|trans }}" autocomplete="off" data-action="input->credential-index#search">
    </div>
    <div class="pm-actions">
      {% if canCreateCredential %}
        <a href="{{ path('credential_new') }}" class="btn-primary">
          <i class="fas fa-plus"></i> {{ 'credential.index.actions.add_short'|trans }}
        </a>
      {% else %}
        <div class="btn-primary disabled" title="{{ 'header.upgrade.text'|trans }}">
          <i class="fas fa-lock"></i> {{ 'credential.index.actions.add_short'|trans }}
        </div>
      {% endif %}

      {% if canImportCredentials and canCreateCredential %}
        <a href="{{ path('credential_import') }}" class="btn-primary btn-import">
          <i class="fas fa-file-import"></i> {{ 'credential.index.actions.import_csv'|trans }}
        </a>
      {% else %}
        <div class="btn-primary disabled" title="{{ 'header.upgrade.text'|trans }}">
          <i class="fas fa-lock"></i> {{ 'credential.index.actions.import_csv'|trans }}
        </div>
      {% endif %}
    </div>
  </div>

  {# ?? FILTERS ?? #}
  <div class="pm-filters">
    <button class="filter-tab active" data-filter="all" data-action="click->credential-index#setFilter">
      <i class="fas fa-th-large"></i> <span class="mob_off">{{ 'credential.index.filters.all'|trans }}</span>
      <span class="tab-count">{{ totalMine + totalShared + totalTeamShared }}</span>
    </button>
    <button class="filter-tab" data-filter="mine" data-action="click->credential-index#setFilter">
      <i class="fas fa-user"></i> <span class="mob_off">{{ 'credential.index.filters.mine'|trans }}</span>
      <span class="tab-count">{{ totalMine }}</span>
    </button>
    <button class="filter-tab" data-filter="shared" data-action="click->credential-index#setFilter">
      <i class="fas fa-share-alt"></i><span class="mob_off">{{ 'credential.index.filters.shared'|trans }}</span>
      <span class="tab-count">{{ totalShared }}</span>
    </button>
    <button class="filter-tab" data-filter="team" data-action="click->credential-index#setFilter">
      <i class="fas fa-users"></i><span class="mob_off">{{ 'credential.index.filters.team'|trans }}</span>
      <span class="tab-count">{{ totalTeamShared }}</span>
    </button>
  </div>

  {# ?? CONTENT ?? #}
  {% if totalMine == 0 and totalShared == 0 and totalTeamShared == 0 %}
    <div class="pm-empty">
      <div class="empty-icon"><i class="fas fa-lock"></i></div>
      <h3>{{ 'credential.index.empty.title'|trans }}</h3>
      <p>{{ 'credential.index.empty.text'|trans }}</p>
      <a href="{{ path('credential_new') }}" class="btn-primary">
        <i class="fas fa-plus"></i> {{ 'credential.index.actions.add_first'|trans }}
      </a>
    </div>

  {% else %}

    <div id="noResults" class="no-results-msg">
      <i class="fas fa-search"></i>
      {{ 'credential.index.no_results.search_text'|trans }}
    </div>

    {# ?? MY CREDENTIALS ?? #}
    {% if totalMine > 0 %}
      <div class="section-label" id="section-mine" data-section="mine">
        <h2>{{ 'credential.index.sections.mine'|trans }}</h2>
        <span class="label-badge badge-mine">{{ totalMine }}</span>
        <div class="label-line"></div>
      </div>

      <div class="pm-grid pm-grid-spaced" id="grid-mine">
        {% for credential in credentials %}
          {% set shouldLoadFavicon = credential.domain is not empty and '.' in credential.domain and ' ' not in credential.domain %}
          <div class="cred-card {{ credential.pinPosition ? 'is-pinned' }}" data-credential-id="{{ credential.id }}" data-save-url="{{ path('credential_login_url', {id: credential.id}) }}" data-save-token="{{ csrf_token('credential_login_url' ~ credential.id) }}" data-section="mine" data-name="{{ credential.name|lower }}" data-domain="{{ credential.domain|lower }}" data-username="{{ credential.username|lower }}" data-pin-position="{{ credential.pinPosition ?? '' }}" style="animation-delay:{{ loop.index0 * 0.04 }}s">
            <button
              type="button"
              class="pin-toggle {{ credential.pinPosition ? 'is-active' }}"
              title="{{ (credential.pinPosition ? 'credential.index.pin.unpin' : 'credential.index.pin.pin')|trans }}"
              aria-pressed="{{ credential.pinPosition ? 'true' : 'false' }}"
              data-action="click->credential-index#togglePin"
              data-toggle-url="{{ path('credential_pin_toggle', {'id': credential.id}) }}"
              data-toggle-token="{{ csrf_token('pin_toggle' ~ credential.id) }}"
            >
              <i class="fas fa-thumbtack"></i>
            </button>
            <div class="cred-card-body">

              <div class="site-row">
                <div class="site-favicon">
                  {% if shouldLoadFavicon %}
                    <img
                      data-domain="{{ credential.domain }}"
                      data-favicon-url="https://www.google.com/s2/favicons?domain={{ credential.domain|url_encode }}&sz=64"
                      alt=""
                      loading="lazy"
                      referrerpolicy="no-referrer"
                      data-action="load->credential-index#handleFaviconLoad error->credential-index#handleFaviconError"
                    >
                  {% endif %}
                  <span class="favicon-letter">{{ credential.name|first|upper }}</span>
                </div>
                <div class="site-meta">
                  <div class="site-name">{{ credential.name }}</div>
                  <a class="site-domain credential-site-link" data-site-domain="{{ credential.domain }}" data-login-url="{{ credential.loginUrl }}" aria-disabled="true" target="_blank" rel="noopener noreferrer" title="{{ 'credential.index.launch.open_site'|trans }}">
                    <span>{{ credential.domain }}</span><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                  </a>
                </div>
              </div>

              <div class="cred-fields">
                <div class="cred-field">
                  <div class="cred-field-label"><i class="fas fa-user"></i> {{ 'credential.index.labels.username'|trans }}</div>
                  <div class="cred-field-value">{{ credential.username }}</div>
                </div>
                <div class="cred-field">
                  <div class="cred-field-label"><i class="fas fa-key"></i> {{ 'credential.index.labels.password'|trans }}</div>
                  <div class="cred-field-value is-password">**********</div>
                </div>
              </div>

            </div>
            <div class="credential-launch-action">
              <button type="button" class="credential-launch-button" aria-haspopup="dialog" aria-controls="credential-launch-dialog" data-action="click->credential-index#openLaunch">
                <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
                <span data-launch-label>{{ 'credential.index.launch.open_site'|trans }}</span>
                <span class="credential-launch-badge" hidden>{{ 'credential.index.launch.ready'|trans }}</span>
              </button>
            </div>
            <div class="cred-card-footer">
              <a href="{{ path('credential_show', {'id': credential.id}) }}" class="act-btn view" title="{{ 'credential.index.card_actions.view'|trans }}">
                <i class="fas fa-eye"></i>
              </a>
              <button
                type="button"
                class="act-btn share"
                title="{{ 'credential.index.card_actions.share'|trans }}"
                data-action="click->credential-index#openQuickShare"
                data-credential-id="{{ credential.id }}"
                data-credential-name="{{ credential.name }}"
                data-credential-domain="{{ credential.domain }}"
                data-credential-initials="{{ credential.name|slice(0, 2)|upper }}"
              >
                <i class="fas fa-share-alt"></i>
              </button>
              <a href="{{ path('credential_edit', {'id': credential.id}) }}" class="act-btn edit" title="{{ 'credential.index.card_actions.edit'|trans }}">
                <i class="fas fa-pencil-alt"></i>
              </a>
              <form method="post" action="{{ path('credential_delete', {'id': credential.id}) }}"
                    class="credential-delete-form"
                    data-action="submit->credential-index#confirmDelete"
                    data-confirm-message="{{ 'credential.index.confirm.delete'|trans }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ credential.id) }}">
                <button class="act-btn delete" title="{{ 'credential.index.card_actions.delete'|trans }}" type="submit">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {# ?? SHARED WITH ME ?? #}
    {% if totalShared > 0 %}
      <div class="section-label" id="section-shared" data-section="shared">
        <h2>{{ 'credential.index.sections.shared'|trans }}</h2>
        <span class="label-badge badge-shared">{{ totalShared }}</span>
        <div class="label-line"></div>
      </div>

      <div class="pm-grid" id="grid-shared">
        {% for access in sharedAccesses %}
          {% set credential = access.credential %}
          {% set owner = access.owner %}
          {% set shouldLoadFavicon = credential.domain is not empty and '.' in credential.domain and ' ' not in credential.domain %}
          <div class="cred-card is-shared" data-credential-id="{{ credential.id }}" data-section="shared" data-name="{{ credential.name|lower }}" data-domain="{{ credential.domain|lower }}" data-username="{{ credential.username|lower }}" style="animation-delay:{{ loop.index0 * 0.04 }}s">

            <div class="shared-ribbon">
              <i class="fas fa-share-alt"></i> {{ 'credential.index.badges.shared'|trans }}
            </div>

            <div class="cred-card-body">

              <div class="site-row">
                <div class="site-favicon">
                  {% if shouldLoadFavicon %}
                    <img
                      data-domain="{{ credential.domain }}"
                      data-favicon-url="https://www.google.com/s2/favicons?domain={{ credential.domain|url_encode }}&sz=64"
                      alt=""
                      loading="lazy"
                      referrerpolicy="no-referrer"
                      data-action="load->credential-index#handleFaviconLoad error->credential-index#handleFaviconError"
                    >
                  {% endif %}
                  <span class="favicon-letter">{{ credential.name|first|upper }}</span>
                </div>
                <div class="site-meta">
                  <div class="site-name">{{ credential.name }}</div>
                  <a class="site-domain credential-site-link" data-site-domain="{{ credential.domain }}" data-login-url="{{ credential.loginUrl }}" aria-disabled="true" target="_blank" rel="noopener noreferrer" title="{{ 'credential.index.launch.open_site'|trans }}">
                    <span>{{ credential.domain }}</span><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                  </a>
                </div>
              </div>

              {# Owner info #}
              <div class="owner-row">
                <div class="owner-avatar">{{ owner.email|first|upper }}</div>
                <i class="fas fa-user-shield"></i>
                {{ 'credential.index.labels.owner'|trans }}&nbsp;:&nbsp;<strong>{{ owner.email }}</strong>
              </div>

              <div class="cred-fields">
                <div class="cred-field">
                  <div class="cred-field-label"><i class="fas fa-user"></i> {{ 'credential.index.labels.username'|trans }}</div>
                  <div class="cred-field-value">{{ credential.username }}</div>
                </div>
                <div class="cred-field">
                  <div class="cred-field-label"><i class="fas fa-key"></i> {{ 'credential.index.labels.password'|trans }}</div>
                  <div class="cred-field-value is-password">**********</div>
                </div>
              </div>

            </div>
            <div class="credential-launch-action">
              <button type="button" class="credential-launch-button" aria-haspopup="dialog" aria-controls="credential-launch-dialog" data-action="click->credential-index#openLaunch">
                <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
                <span data-launch-label>{{ 'credential.index.launch.open_site'|trans }}</span>
                <span class="credential-launch-badge" hidden>{{ 'credential.index.launch.ready'|trans }}</span>
              </button>
            </div>
            <div class="cred-card-footer">
              <a href="{{ path('shared_access_view_credential', {'id': access.id}) }}" class="act-btn view" title="{{ 'credential.index.card_actions.view'|trans }}">
                <i class="fas fa-eye"></i>
              </a>
              {# No share/edit/delete for shared credentials ? read-only access #}
              <button class="act-btn act-btn-disabled" title="{{ 'credential.index.card_actions.unavailable_shared'|trans }}">
                <i class="fas fa-share-alt"></i>
              </button>
              <button class="act-btn act-btn-disabled" title="{{ 'credential.index.card_actions.unavailable_shared'|trans }}">
                <i class="fas fa-pencil-alt"></i>
              </button>
              <button class="act-btn act-btn-disabled" title="{{ 'credential.index.card_actions.unavailable_shared'|trans }}">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if totalTeamShared > 0 %}
      <div class="section-label" id="section-team" data-section="team">
        <h2>{{ 'credential.index.sections.team'|trans }}</h2>
        <span class="label-badge badge-shared">{{ totalTeamShared }}</span>
        <div class="label-line"></div>
      </div>

      <div class="pm-grid" id="grid-team">
        {% for entry in teamSharedCredentials %}
          {% set credential = entry.credential %}
          {% set owner = entry.owner %}
          {% set teamNames = entry.teams %}
          {% set shouldLoadFavicon = credential.domain is not empty and '.' in credential.domain and ' ' not in credential.domain %}
          <div class="cred-card is-shared" data-credential-id="{{ credential.id }}" data-section="team" data-name="{{ credential.name|lower }}" data-domain="{{ credential.domain|lower }}" data-username="{{ credential.username|lower }}" style="animation-delay:{{ loop.index0 * 0.04 }}s">
            <div class="shared-ribbon">
              <i class="fas fa-users"></i> {{ 'credential.index.badges.team'|trans }}
            </div>

            <div class="cred-card-body">
              <div class="site-row">
                <div class="site-favicon">
                  {% if shouldLoadFavicon %}
                    <img
                      data-domain="{{ credential.domain }}"
                      data-favicon-url="https://www.google.com/s2/favicons?domain={{ credential.domain|url_encode }}&sz=64"
                      alt=""
                      loading="lazy"
                      referrerpolicy="no-referrer"
                      data-action="load->credential-index#handleFaviconLoad error->credential-index#handleFaviconError"
                    >
                  {% endif %}
                  <span class="favicon-letter">{{ credential.name|first|upper }}</span>
                </div>
                <div class="site-meta">
                  <div class="site-name">{{ credential.name }}</div>
                  <a class="site-domain credential-site-link" data-site-domain="{{ credential.domain }}" data-login-url="{{ credential.loginUrl }}" aria-disabled="true" target="_blank" rel="noopener noreferrer" title="{{ 'credential.index.launch.open_site'|trans }}">
                    <span>{{ credential.domain }}</span><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                  </a>
                </div>
              </div>

              <div class="owner-row">
                <div class="owner-avatar">{{ owner.email|first|upper }}</div>
                <i class="fas fa-user-shield"></i>
                {{ 'credential.index.labels.owner'|trans }}&nbsp;:&nbsp;<strong>{{ owner.email }}</strong>
              </div>

              <div class="owner-row">
                <div class="owner-avatar"><i class="fas fa-users"></i></div>
                <span>{{ (teamNames|length > 1 ? 'credential.index.labels.teams' : 'credential.index.labels.team')|trans }}&nbsp;:&nbsp;<strong>{{ teamNames|join(', ') }}</strong></span>
              </div>

              <div class="cred-fields">
                <div class="cred-field">
                  <div class="cred-field-label"><i class="fas fa-user"></i> {{ 'credential.index.labels.username'|trans }}</div>
                  <div class="cred-field-value">{{ credential.username }}</div>
                </div>
                <div class="cred-field">
                  <div class="cred-field-label"><i class="fas fa-key"></i> {{ 'credential.index.labels.password'|trans }}</div>
                  <div class="cred-field-value is-password">**********</div>
                </div>
              </div>
            </div>

            <div class="credential-launch-action">
              <button type="button" class="credential-launch-button" aria-haspopup="dialog" aria-controls="credential-launch-dialog" data-action="click->credential-index#openLaunch">
                <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
                <span data-launch-label>{{ 'credential.index.launch.open_site'|trans }}</span>
                <span class="credential-launch-badge" hidden>{{ 'credential.index.launch.ready'|trans }}</span>
              </button>
            </div>
            <div class="cred-card-footer">
              <a href="{{ path('credential_show', {'id': credential.id}) }}" class="act-btn view" title="{{ 'credential.index.card_actions.view'|trans }}">
                <i class="fas fa-eye"></i>
              </a>
              <button class="act-btn act-btn-disabled" title="{{ 'credential.index.card_actions.unavailable_team'|trans }}">
                <i class="fas fa-share-alt"></i>
              </button>
              <button class="act-btn act-btn-disabled" title="{{ 'credential.index.card_actions.unavailable_team'|trans }}">
                <i class="fas fa-pencil-alt"></i>
              </button>
              <button class="act-btn act-btn-disabled" title="{{ 'credential.index.card_actions.unavailable_team'|trans }}">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

  {% endif %}

  {% include 'credential/_launch_dialog.html.twig' only %}

  <dialog
    class="quick-share-modal"
    data-credential-index-target="quickShareModal"
    data-action="click->credential-index#dismissQuickShare close->credential-index#quickShareClosed"
    aria-labelledby="quick-share-title"
    aria-describedby="quick-share-subtitle"
  >
    <div class="quick-share-dialog">
      <div class="quick-share-head">
        <div class="quick-share-head__main">
          <span class="quick-share-symbol"><i class="fas fa-user-plus" aria-hidden="true"></i></span>
          <div>
            <span class="quick-share-eyebrow">{{ 'credential.index.quick_share.eyebrow'|trans }}</span>
            <h2 class="quick-share-title" id="quick-share-title">{{ 'credential.index.quick_share.title'|trans }}</h2>
            <p class="quick-share-subtitle" id="quick-share-subtitle">{{ 'credential.index.quick_share.subtitle'|trans }}</p>
          </div>
        </div>

        <button
          type="button"
          class="quick-share-close"
          aria-label="{{ 'credential.index.quick_share.close'|trans }}"
          data-action="click->credential-index#closeQuickShare"
        >
          <i class="fas fa-times"></i>
        </button>
      </div>

      <form method="post" action="{{ path('shared_access_quick') }}" class="quick-share-form">
        <input type="hidden" name="_token" value="{{ csrf_token('quick_share') }}">
        <input type="hidden" name="credential_id" value="" data-credential-index-target="quickShareCredentialId">

        <div class="quick-share-body">
          <div class="quick-share-section-label">{{ 'credential.index.quick_share.selected_credential'|trans }}</div>
          <div class="quick-share-credential">
            <div class="quick-share-badge" data-credential-index-target="quickShareInitials">--</div>
            <div class="quick-share-credential__copy">
              <strong data-credential-index-target="quickShareName">-</strong>
              <span data-credential-index-target="quickShareDomain">-</span>
            </div>
            <span class="quick-share-lock" title="{{ 'credential.index.quick_share.protected'|trans }}"><i class="fas fa-shield-halved" aria-hidden="true"></i></span>
          </div>

          <div class="quick-share-field">
            <label class="quick-share-label" for="quick-share-email">{{ 'credential.index.quick_share.email_label'|trans }}</label>
            <div class="quick-share-input-wrap">
              <i class="far fa-envelope" aria-hidden="true"></i>
              <input
                id="quick-share-email"
                name="email"
                type="email"
                class="quick-share-input"
                placeholder="{{ 'credential.index.quick_share.email_placeholder'|trans }}"
                required
                autocomplete="email"
                autocapitalize="none"
                spellcheck="false"
                data-credential-index-target="quickShareEmail"
              >
            </div>
          </div>
          <p class="quick-share-hint">{{ 'credential.index.quick_share.email_hint'|trans }}</p>

          <label class="quick-share-permission">
            <input type="checkbox" name="can_reveal_password" value="1" checked>
            <span class="quick-share-toggle" aria-hidden="true"><span></span></span>
            <span class="quick-share-permission__copy">
              <strong>{{ 'credential_access.reveal_label_short'|trans }}</strong>
              <small>{{ 'credential_access.reveal_help_short'|trans }}</small>
            </span>
          </label>

          <div class="quick-share-security-note">
            <i class="fas fa-lock" aria-hidden="true"></i>
            <span>{{ 'credential.index.quick_share.security_hint'|trans }}</span>
          </div>

        </div>

        <div class="quick-share-actions">
          <button type="button" class="quick-share-btn quick-share-btn-secondary" data-action="click->credential-index#closeQuickShare">
            {{ 'credential.index.quick_share.cancel'|trans }}
          </button>
          <button type="submit" class="quick-share-btn quick-share-btn-primary">
            <i class="fas fa-paper-plane" aria-hidden="true"></i>{{ 'credential.index.quick_share.submit'|trans }}
          </button>
        </div>
      </form>
    </div>
  </dialog>
</div>

{% endblock %}

