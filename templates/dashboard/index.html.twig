{% extends 'base.html.twig' %}
{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block body %}
{% set planCode = currentPlan.code|default('free') %}
{% set displayName = app.user.prenom|default('')|trim %}
{% set hasLimitedUsage = planUsage.credentials.limit is not null or planUsage.shares.limit is not null or planUsage.groups.limit is not null %}

<style>
.dashboard-shell {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 1440px;
  margin: 0 auto;
}

.dashboard-hero,
.dashboard-card,
.stat-card {
  border: 1px solid var(--glass-card-border);
  border-radius: var(--border-radius);
  background: var(--glass-card-bg);
  box-shadow: var(--glass-card-shadow);
  -webkit-backdrop-filter: var(--glass-card-blur);
  backdrop-filter: var(--glass-card-blur);
}

.dashboard-hero {
  position: relative;
  isolation: isolate;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 28px;
  align-items: center;
  min-height: 190px;
  padding: 30px;
  overflow: hidden;
}

.dashboard-hero::after {
  content: '';
  position: absolute;
  z-index: -1;
  right: -90px;
  top: -130px;
  width: 380px;
  height: 380px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(16, 185, 129, .18), rgba(16, 185, 129, 0) 68%);
  pointer-events: none;
}

.dashboard-hero__eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 11px;
  color: var(--color-primary);
  font-size: 12px;
  font-weight: 850;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.dashboard-plan-chip {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 5px 9px;
  border: 1px solid rgba(16, 185, 129, .24);
  border-radius: 999px;
  background: rgba(16, 185, 129, .09);
  color: var(--color-primary);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: none;
}

.dashboard-hero h1 {
  margin: 0;
  color: var(--color-text-dark);
  font-size: clamp(25px, 3vw, 38px);
  line-height: 1.08;
  letter-spacing: -.035em;
}

.dashboard-hero__copy {
  max-width: 660px;
  margin: 12px 0 0;
  color: var(--color-text-medium);
  font-size: 15px;
  line-height: 1.65;
}

.dashboard-hero__actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10px;
}

.dashboard-primary-action,
.dashboard-secondary-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 44px;
  padding: 0 16px;
  border: 1px solid transparent;
  border-radius: var(--border-radius);
  font-size: 13px;
  font-weight: 800;
  text-decoration: none;
  transition: transform .18s ease, background .18s ease, border-color .18s ease;
}

.dashboard-primary-action {
  background: var(--color-primary);
  color: #fff;
  box-shadow: 0 8px 18px -10px rgba(5, 150, 105, .75);
}

.dashboard-secondary-action {
  border-color: var(--color-border);
  background: var(--color-bg-light);
  color: var(--color-text-dark);
}

.dashboard-primary-action:hover,
.dashboard-secondary-action:hover {
  transform: translateY(-1px);
}

.dashboard-usage {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1px;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
  background: var(--color-border);
}

.dashboard-usage__item {
  padding: 13px 15px;
  background: var(--glass-card-bg);
}

.dashboard-usage__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
  color: var(--color-text-medium);
  font-size: 12px;
  font-weight: 700;
}

.dashboard-usage__top strong {
  color: var(--color-text-dark);
  font-size: 12px;
}

.dashboard-usage__track {
  height: 4px;
  border-radius: 999px;
  background: var(--color-bg-hover);
  overflow: hidden;
}

.dashboard-usage__track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.stat-card {
  display: flex;
  align-items: center;
  gap: 13px;
  min-height: 88px;
  padding: 15px;
  color: inherit;
  text-decoration: none;
  transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease;
}

.stat-card:hover {
  transform: translateY(-1px);
  border-color: rgba(16, 185, 129, .32);
  box-shadow: 0 12px 24px -18px rgba(15, 23, 42, .38);
}

.stat-icon {
  display: grid;
  flex: 0 0 42px;
  width: 42px;
  height: 42px;
  place-items: center;
  border-radius: var(--border-radius);
  color: #fff;
  font-size: 16px;
}

.stat-content {
  min-width: 0;
}

.stat-label {
  margin-bottom: 4px;
  color: var(--color-text-muted);
  font-size: 12px;
  font-weight: 700;
}

.stat-value {
  color: var(--color-text-dark);
  font-size: 25px;
  font-weight: 900;
  line-height: 1;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(320px, .65fr);
  gap: 16px;
}

.dashboard-grid--balanced {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.dashboard-card {
  min-width: 0;
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 62px;
  padding: 16px 18px;
  border-bottom: 1px solid var(--color-border);
}

.card-header h2 {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 0;
  color: var(--color-text-dark);
  font-size: 15px;
  font-weight: 850;
}

.card-header h2 i {
  color: var(--color-primary);
  font-size: 14px;
}

.card-content {
  padding: 16px 18px;
}

.btn-link,
.btn-primary-small {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--color-primary);
  font-size: 12px;
  font-weight: 800;
  text-decoration: none;
}

.btn-primary-small {
  min-height: 34px;
  padding: 0 11px;
  border: 1px solid rgba(16, 185, 129, .25);
  border-radius: var(--border-radius);
  background: rgba(16, 185, 129, .09);
}

.activity-list,
.teams-list,
.drafts-list {
  display: flex;
  flex-direction: column;
}

.activity-item,
.team-item,
.draft-item {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
  padding: 12px 0;
  border-bottom: 1px solid var(--color-border);
}

.activity-item:first-child,
.team-item:first-child,
.draft-item:first-child {
  padding-top: 0;
}

.activity-item:last-child,
.team-item:last-child,
.draft-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.activity-icon,
.draft-icon,
.team-avatar {
  display: grid;
  flex: 0 0 38px;
  width: 38px;
  height: 38px;
  place-items: center;
  border-radius: var(--border-radius);
  font-size: 13px;
  font-weight: 850;
}

.activity-icon--credential_created {
  background: rgba(16, 185, 129, .11);
  color: var(--color-primary);
}

.activity-icon--share_created {
  background: rgba(245, 158, 11, .12);
  color: #d97706;
}

.activity-icon--draft_created,
.draft-icon {
  background: rgba(99, 102, 241, .1);
  color: #6366f1;
}

.activity-details,
.team-info,
.draft-info {
  min-width: 0;
  flex: 1;
}

.activity-title,
.team-name,
.draft-name {
  overflow: hidden;
  color: var(--color-text-dark);
  font-size: 13px;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-desc,
.activity-time,
.team-meta,
.draft-time {
  color: var(--color-text-muted);
  font-size: 11px;
  line-height: 1.45;
}

.activity-desc {
  margin-top: 2px;
  color: var(--color-text-medium);
  font-size: 12px;
}

.activity-time,
.draft-time {
  margin-top: 3px;
}

.team-item {
  color: inherit;
  text-decoration: none;
}

.team-avatar {
  background: rgba(16, 185, 129, .11);
  color: var(--color-primary);
}

.team-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 4px;
}

.team-meta span {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.badge {
  flex: 0 0 auto;
  padding: 4px 7px;
  border-radius: 999px;
  background: rgba(16, 185, 129, .1);
  color: var(--color-primary);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .04em;
  text-transform: uppercase;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.action-btn {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr) auto;
  gap: 10px;
  align-items: center;
  min-height: 68px;
  padding: 11px;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  background: var(--color-bg-light);
  color: inherit;
  text-decoration: none;
  transition: border-color .18s ease, background .18s ease;
}

.action-btn:hover {
  border-color: rgba(16, 185, 129, .32);
  background: var(--color-bg-hover);
}

.action-btn__icon {
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border-radius: var(--border-radius);
  background: rgba(16, 185, 129, .1);
  color: var(--color-primary);
  font-size: 14px;
}

.action-btn strong,
.action-btn small {
  display: block;
}

.action-btn strong {
  color: var(--color-text-dark);
  font-size: 12px;
  font-weight: 800;
}

.action-btn small {
  margin-top: 3px;
  color: var(--color-text-muted);
  font-size: 10px;
  line-height: 1.35;
}

.action-btn > .fa-chevron-right {
  color: var(--color-text-muted);
  font-size: 9px;
}

.empty-state {
  padding: 22px 12px;
  text-align: center;
}

.empty-title {
  margin-top: 8px;
  color: var(--color-text-dark);
  font-size: 13px;
  font-weight: 800;
}

.empty-desc {
  max-width: 340px;
  margin: 5px auto 0;
  color: var(--color-text-muted);
  font-size: 12px;
  line-height: 1.5;
}

.security-score {
  display: grid;
  grid-template-columns: 132px minmax(0, 1fr);
  gap: 22px;
  align-items: center;
}

.score-circle {
  position: relative;
  width: 132px;
  height: 132px;
}

.score-circle svg {
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}

.score-circle circle.progress {
  transition: stroke-dashoffset .8s ease-out;
}

.score-value {
  position: absolute;
  inset: 50% auto auto 50%;
  transform: translate(-50%, -50%);
  color: var(--color-text-dark);
  font-size: 27px;
  font-weight: 900;
}

.score-details {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.score-item {
  display: flex;
  align-items: center;
  gap: 9px;
  color: var(--color-text-medium);
  font-size: 12px;
}

.score-item i {
  font-size: 13px;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  min-height: 38px;
  margin-top: 5px;
  padding: 0 13px;
  border-radius: var(--border-radius);
  background: var(--color-primary);
  color: #fff;
  font-size: 12px;
  font-weight: 800;
  text-decoration: none;
}

@media (max-width: 1100px) {
  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid,
  .dashboard-grid--balanced {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .dashboard-shell {
    gap: 12px;
  }

  .dashboard-hero {
    grid-template-columns: 1fr;
    min-height: 0;
    padding: 21px 17px;
  }

  .dashboard-hero__actions {
    justify-content: flex-start;
  }

  .dashboard-primary-action,
  .dashboard-secondary-action {
    flex: 1 1 150px;
  }

  .dashboard-usage,
  .quick-actions {
    grid-template-columns: 1fr;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .stat-card {
    min-height: 78px;
    padding: 12px;
  }

  .stat-icon {
    flex-basis: 36px;
    width: 36px;
    height: 36px;
  }

  .stat-value {
    font-size: 21px;
  }

  .security-score {
    grid-template-columns: 1fr;
    justify-items: center;
  }

  .score-details,
  .btn-primary {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .dashboard-shell *,
  .score-circle circle.progress {
    scroll-behavior: auto !important;
    transition: none !important;
  }
}
</style>

<div class="dashboard-shell">
  <section class="dashboard-hero">
    <div>
      <div class="dashboard-hero__eyebrow">
        <i class="fas fa-shield-alt"></i>
        {{ 'dashboard.hero.eyebrow'|trans }}
        <span class="dashboard-plan-chip"><i class="fas fa-crown"></i> {{ currentPlan.label|default('Free') }}</span>
      </div>
      <h1>
        {% if displayName %}
          {{ 'dashboard.hero.greeting_named'|trans({'%name%': displayName}) }}
        {% else %}
          {{ 'dashboard.hero.greeting'|trans }}
        {% endif %}
      </h1>
      <p class="dashboard-hero__copy">{{ ('dashboard.hero.description.' ~ planCode)|trans }}</p>
    </div>

    <div class="dashboard-hero__actions">
      <a class="dashboard-primary-action" href="{{ planAccess.canCreateCredential ? path('credential_new') : path('app_subscription') }}">
        <i class="fas {{ planAccess.canCreateCredential ? 'fa-plus' : 'fa-lock' }}"></i>
        {{ 'dashboard.hero.add_credential'|trans }}
      </a>
      <a class="dashboard-secondary-action" href="{{ planAccess.canCreateShare ? path('shared_access_new') : path('app_subscription') }}">
        <i class="fas {{ planAccess.canCreateShare ? 'fa-share-alt' : 'fa-lock' }}"></i>
        {{ 'dashboard.hero.share_access'|trans }}
      </a>
    </div>
  </section>

  {% if hasLimitedUsage %}
    <section class="dashboard-usage" aria-label="{{ 'dashboard.usage.title'|trans }}">
      {% for key, item in planUsage %}
        {% set rawPercent = item.limit is not null and item.limit > 0 ? ((item.used / item.limit * 100)|round) : 0 %}
        {% set percent = rawPercent > 100 ? 100 : rawPercent %}
        <div class="dashboard-usage__item">
          <div class="dashboard-usage__top">
            <span>{{ ('dashboard.usage.' ~ key)|trans }}</span>
            <strong>{% if item.limit is null %}{{ 'dashboard.usage.unlimited'|trans }}{% else %}{{ item.used }}/{{ item.limit }}{% endif %}</strong>
          </div>
          <div class="dashboard-usage__track" aria-hidden="true"><span style="width: {{ percent }}%"></span></div>
        </div>
      {% endfor %}
    </section>
  {% endif %}

  <section class="stats-grid" aria-label="{{ 'dashboard.overview'|trans }}">
    {% include 'components/app_ui/stat_card.html.twig' with {
      href: path('app_credential'), gradient: 'linear-gradient(135deg, #059669, #10b981)', icon: 'fas fa-key',
      label: 'dashboard.stats.credentials'|trans, value: stats.credentials|default(0)
    } only %}
    {% include 'components/app_ui/stat_card.html.twig' with {
      href: path('app_team_index'), gradient: 'linear-gradient(135deg, #2563eb, #60a5fa)', icon: 'fas fa-layer-group',
      label: 'dashboard.stats.teams'|trans, value: stats.teams|default(0)
    } only %}
    {% include 'components/app_ui/stat_card.html.twig' with {
      href: path('shared_access_index'), gradient: 'linear-gradient(135deg, #d97706, #fbbf24)', icon: 'fas fa-share-alt',
      label: 'dashboard.stats.active_shares'|trans, value: stats.shares|default(0)
    } only %}
    {% include 'components/app_ui/stat_card.html.twig' with {
      href: planAccess.passwordGenerator ? path('app_generator') : path('app_subscription'), gradient: 'linear-gradient(135deg, #7c3aed, #a78bfa)', icon: 'fas fa-file-alt',
      label: 'dashboard.stats.drafts'|trans, value: stats.drafts|default(0)
    } only %}
  </section>

  <div class="dashboard-grid">
    <section class="dashboard-card">
      <div class="card-header"><h2><i class="fas fa-clock"></i> {{ 'dashboard.recent_activity.title'|trans }}</h2></div>
      <div class="card-content">
        <div class="activity-list">
          {% if activity is empty %}
            {% include 'components/app_ui/empty_state.html.twig' with {icon: 'fas fa-clock', title: 'dashboard.recent_activity.empty.title'|trans, text: 'dashboard.recent_activity.empty.desc'|trans} only %}
          {% else %}
            {% for item in activity %}
              <div class="activity-item">
                <div class="activity-icon activity-icon--{{ item.type|e }}"><i class="fas {{ item.type == 'credential_created' ? 'fa-key' : (item.type == 'share_created' ? 'fa-share-alt' : 'fa-file-alt') }}"></i></div>
                <div class="activity-details">
                  <div class="activity-title">{{ item.title_key|trans }}</div>
                  <div class="activity-desc">{{ item.desc ?: (item.type == 'draft_created' ? ('dashboard.activity.fallback_unnamed'|trans) : ('dashboard.activity.fallback_credential'|trans)) }}</div>
                  <div class="activity-time">{{ item.at|date('d/m/Y H:i') }}</div>
                </div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </section>

    <section class="dashboard-card">
      <div class="card-header"><h2><i class="fas fa-bolt"></i> {{ 'dashboard.quick_actions.title'|trans }}</h2></div>
      <div class="card-content">
        <div class="quick-actions">
          <a class="action-btn" href="{{ planAccess.canCreateCredential ? path('credential_new') : path('app_subscription') }}">
            <span class="action-btn__icon"><i class="fas {{ planAccess.canCreateCredential ? 'fa-plus' : 'fa-lock' }}"></i></span>
            <span><strong>{{ 'dashboard.quick_actions.new_credential'|trans }}</strong><small>{{ 'dashboard.quick_actions.new_credential_desc'|trans }}</small></span><i class="fas fa-chevron-right"></i>
          </a>
          <a class="action-btn" href="{{ planAccess.canCreateShare ? path('shared_access_new') : path('app_subscription') }}">
            <span class="action-btn__icon"><i class="fas {{ planAccess.canCreateShare ? 'fa-share-alt' : 'fa-lock' }}"></i></span>
            <span><strong>{{ 'dashboard.quick_actions.share_access'|trans }}</strong><small>{{ 'dashboard.quick_actions.share_access_desc'|trans }}</small></span><i class="fas fa-chevron-right"></i>
          </a>
          <a class="action-btn" href="{{ path('app_team_index') }}">
            <span class="action-btn__icon"><i class="fas fa-building"></i></span>
            <span><strong>{{ 'dashboard.quick_actions.enterprise'|trans }}</strong><small>{{ ('dashboard.quick_actions.enterprise_desc.' ~ planCode)|trans }}</small></span><i class="fas fa-chevron-right"></i>
          </a>
          <a class="action-btn" href="{{ path('app_extention') }}">
            <span class="action-btn__icon"><i class="fas fa-puzzle-piece"></i></span>
            <span><strong>{{ 'dashboard.quick_actions.extension'|trans }}</strong><small>{{ 'dashboard.quick_actions.extension_desc'|trans }}</small></span><i class="fas fa-chevron-right"></i>
          </a>
        </div>
      </div>
    </section>
  </div>

  <div class="dashboard-grid dashboard-grid--balanced">
    <section class="dashboard-card">
      <div class="card-header">
        <h2><i class="fas fa-layer-group"></i> {{ 'dashboard.teams.title'|trans }}</h2>
        {% if planAccess.canCreateTeam %}<a class="btn-primary-small" href="{{ path('app_team_new') }}"><i class="fas fa-plus"></i> {{ 'dashboard.teams.create'|trans }}</a>{% endif %}
      </div>
      <div class="card-content">
        <div class="teams-list">
          {% if teams is empty %}
            {% include 'components/app_ui/empty_state.html.twig' with {icon: 'fas fa-layer-group', title: 'dashboard.teams.empty.title'|trans, text: 'dashboard.teams.empty.desc'|trans} only %}
          {% else %}
            {% for team in teams %}
              <a class="team-item" href="{{ path('app_team_show', {id: team.id}) }}">
                <div class="team-avatar">{{ team.avatar|e }}</div>
                <div class="team-info">
                  <div class="team-name">{{ team.name|e }}</div>
                  <div class="team-meta"><span><i class="fas fa-users"></i> {{ team.membersCount }} {{ 'dashboard.teams.meta.members'|trans }}</span><span><i class="fas fa-key"></i> {{ team.credentialsCount }} {{ 'dashboard.teams.meta.credentials'|trans }}</span></div>
                </div>
                <span class="badge">{{ 'dashboard.teams.owner'|trans }}</span>
              </a>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </section>

    <section class="dashboard-card">
      <div class="card-header">
        <h2><i class="fas fa-file-alt"></i> {{ 'dashboard.drafts.title'|trans }}</h2>
        <a class="btn-link" href="{{ planAccess.passwordGenerator ? path('app_generator') : path('app_subscription') }}">{{ 'dashboard.drafts.view_all'|trans }} <i class="fas fa-arrow-right"></i></a>
      </div>
      <div class="card-content">
        <div class="drafts-list">
          {% if drafts is empty %}
            {% include 'components/app_ui/empty_state.html.twig' with {icon: 'fas fa-file-alt', title: 'dashboard.drafts.empty.title'|trans, text: 'dashboard.drafts.empty.desc'|trans} only %}
          {% else %}
            {% for draft in drafts %}
              <div class="draft-item"><div class="draft-icon"><i class="fas fa-file-alt"></i></div><div class="draft-info"><div class="draft-name">{{ draft.name ?: ('dashboard.drafts.unnamed'|trans) }}</div><div class="draft-time">{{ 'dashboard.drafts.created_on'|trans }} {{ draft.createdAt|date('d/m/Y H:i') }}</div></div></div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </section>
  </div>

  {% set score = security.score|default(0) %}
  {% set circumference = 2 * 3.14159 * 90 %}
  {% set dashOffset = circumference - (circumference * score / 100) %}
  {% set strokeColor = score >= 80 ? '#059669' : (score >= 50 ? '#f59e0b' : '#ef4444') %}

  <section class="dashboard-card">
    <div class="card-header"><h2><i class="fas fa-shield-alt"></i> {{ 'dashboard.security.title'|trans }}</h2></div>
    <div class="card-content">
      <div class="security-score">
        <div class="score-circle" aria-label="{{ 'dashboard.security.title'|trans }} : {{ score }}%">
          <svg viewBox="0 0 200 200" aria-hidden="true"><circle cx="100" cy="100" r="90" fill="none" stroke="var(--color-border)" stroke-width="16"/><circle class="progress" cx="100" cy="100" r="90" fill="none" stroke="{{ strokeColor }}" stroke-width="16" stroke-dasharray="{{ circumference }}" stroke-dashoffset="{{ circumference }}" data-target-offset="{{ dashOffset }}" stroke-linecap="round"/></svg>
          <div class="score-value js-score" data-score="{{ score }}">{{ score }}%</div>
        </div>
        <div class="score-details">
          <div class="score-item"><i class="fas fa-check-circle" style="color:#10b981"></i><span>{{ security.strong|default(0) }} {{ 'dashboard.security.strong_passwords'|trans }}</span></div>
          <div class="score-item"><i class="fas fa-exclamation-triangle" style="color:#f59e0b"></i><span>{{ security.weak|default(0) }} {{ 'dashboard.security.weak_passwords'|trans }}</span></div>
          <div class="score-item"><i class="fas fa-copy" style="color:#ef4444"></i><span>{{ security.reused|default(0) }} {{ 'dashboard.security.reused_passwords'|trans }}</span></div>
          <a class="btn-primary" href="{{ planAccess.securityChecker ? path('app_security_checker') : path('app_subscription') }}"><i class="fas {{ planAccess.securityChecker ? 'fa-arrow-right' : 'fa-lock' }}"></i> {{ 'dashboard.security.improve'|trans }}</a>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
(() => {
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const easeOutCubic = value => 1 - Math.pow(1 - value, 3);

  document.querySelectorAll('.js-count').forEach(element => {
    const target = Number.parseInt(element.dataset.count || '0', 10) || 0;
    if (reduceMotion) {
      element.textContent = String(target);
      return;
    }
    const startedAt = performance.now();
    const render = now => {
      const progress = Math.min(1, (now - startedAt) / 420);
      element.textContent = String(Math.round(target * easeOutCubic(progress)));
      if (progress < 1) requestAnimationFrame(render);
    };
    requestAnimationFrame(render);
  });

  const circle = document.querySelector('.score-circle circle.progress');
  if (circle) {
    const targetOffset = circle.dataset.targetOffset || '0';
    if (reduceMotion) circle.style.strokeDashoffset = targetOffset;
    else requestAnimationFrame(() => { circle.style.strokeDashoffset = targetOffset; });
  }
})();
</script>
{% endblock %}
