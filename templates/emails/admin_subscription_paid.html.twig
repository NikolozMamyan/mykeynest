{% extends 'emails/layout.html.twig' %}

{% block title %}Nouvel abonnement MYKEYNEST{% endblock %}
{% block preheader %}Un paiement d’abonnement vient d’être confirmé.{% endblock %}
{% block eyebrow %}Notification administrateur{% endblock %}
{% block heading %}Un nouvel abonnement est actif{% endblock %}

{% block content %}
  <p style="margin:0 0 22px;">Le paiement Stripe a été synchronisé et les droits du compte ont été mis à jour.</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;table-layout:fixed;background:#f4f7f5;border:1px solid #e0e8e3;border-radius:12px;">
    <tr><td style="word-wrap:break-word;padding:9px 15px;color:#576d65;font-size:12px;">Client</td><td align="right" style="word-wrap:break-word;padding:9px 15px;color:#132c25;font-size:13px;font-weight:700;">{{ user.email }}</td></tr>
    <tr><td style="word-wrap:break-word;padding:9px 15px;color:#576d65;font-size:12px;">Entreprise</td><td align="right" style="word-wrap:break-word;padding:9px 15px;color:#132c25;font-size:13px;">{{ user.company ?: '—' }}</td></tr>
    <tr><td style="word-wrap:break-word;padding:9px 15px;color:#576d65;font-size:12px;">Offre</td><td align="right" style="word-wrap:break-word;padding:9px 15px;color:#087f5b;font-size:13px;font-weight:800;">{{ subscription.planCode|default('pro')|upper }}</td></tr>
    <tr><td style="word-wrap:break-word;padding:9px 15px;color:#576d65;font-size:12px;">Statut</td><td align="right" style="word-wrap:break-word;padding:9px 15px;color:#132c25;font-size:13px;">{{ subscription.status|default('active') }}</td></tr>
    <tr><td style="word-wrap:break-word;padding:9px 15px;color:#576d65;font-size:12px;">Source</td><td align="right" style="word-wrap:break-word;padding:9px 15px;color:#132c25;font-size:13px;">{{ source }}</td></tr>
    <tr><td style="word-wrap:break-word;padding:9px 15px 14px;color:#576d65;font-size:12px;">Date</td><td align="right" style="word-wrap:break-word;padding:9px 15px 14px;color:#132c25;font-size:13px;">{{ paidAt|date('d/m/Y H:i') }}</td></tr>
  </table>
{% endblock %}

{% block action %}
  {% include 'emails/_action.html.twig' with {actionUrl: adminUrl, label: 'Ouvrir l’administration'} %}
{% endblock %}
