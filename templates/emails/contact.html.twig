{% extends 'emails/layout.html.twig' %}

{% block title %}Nouveau message de contact{% endblock %}
{% block eyebrow %}Formulaire de contact{% endblock %}
{% block heading %}Nouveau message de {{ name }}{% endblock %}
{% block content %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin-bottom:22px;background:#f7faf9;border:1px solid #e1e9e7;border-radius:6px;">
    <tr><td style="padding:9px 15px;color:#748079;font-size:12px;">E-mail</td><td align="right" style="padding:9px 15px;color:#172033;font-size:13px;font-weight:700;">{{ userEmail }}</td></tr>
    <tr><td style="padding:9px 15px 14px;color:#748079;font-size:12px;">Motif</td><td align="right" style="padding:9px 15px 14px;color:#172033;font-size:13px;">{{ reasonLabel }}</td></tr>
  </table>
  <div style="padding:15px;background:#f7faf9;border-left:3px solid #059669;border-radius:4px;color:#334155;white-space:pre-line;">{{ message }}</div>
{% endblock %}
