{% extends 'emails/layout.html.twig' %}

{% block title %}Nouveau message de contact{% endblock %}
{% block eyebrow %}Formulaire de contact{% endblock %}
{% block heading %}Nouveau message de {{ name }}{% endblock %}
{% block content %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin-bottom:22px;background:#f4f7f5;border:1px solid #e0e8e3;border-radius:12px;">
    <tr><td style="word-wrap:break-word;padding:9px 15px;color:#576d65;font-size:12px;">E-mail</td><td align="right" style="word-wrap:break-word;padding:9px 15px;color:#132c25;font-size:13px;font-weight:700;">{{ userEmail }}</td></tr>
    <tr><td style="word-wrap:break-word;padding:9px 15px 14px;color:#576d65;font-size:12px;">Motif</td><td align="right" style="word-wrap:break-word;padding:9px 15px 14px;color:#132c25;font-size:13px;">{{ reasonLabel }}</td></tr>
  </table>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;table-layout:fixed;background:#f4f7f5;border:1px solid #e0e8e3;border-radius:12px;"><tr><td style="word-wrap:break-word;padding:18px;color:#435e53;font-size:14px;line-height:24px;word-wrap:break-word;">{{ message|nl2br }}</td></tr></table>
{% endblock %}
