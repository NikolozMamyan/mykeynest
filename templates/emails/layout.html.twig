{% set emailLocale = locale|default('locale'|trans({}, 'emails')) %}
<!doctype html>
<html lang="{{ emailLocale }}" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <meta name="format-detection" content="telephone=no,date=no,address=no,email=no">
  <meta name="x-apple-disable-message-reformatting">
  <title>{% block title %}MYKEYNEST{% endblock %}</title>
  <!--[if mso]>
  <noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
  <![endif]-->
</head>
<body bgcolor="#f2f6f3" style="margin:0;padding:0;width:100%;background-color:#f2f6f3;font-family:Arial,Helvetica,sans-serif;color:#132c25;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f2f6f3" style="width:100%;background-color:#f2f6f3;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;">
    <tr>
      <td align="center" style="padding:32px 12px;">
        <!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;table-layout:fixed;mso-table-lspace:0pt;mso-table-rspace:0pt;">
          <tr><td align="left" style="padding:0 8px 22px;">{% include 'emails/_brand_header.html.twig' %}</td></tr>
          {% set summary %}{% block preheader %}{% endblock %}{% endset %}
          {% if summary|trim is not empty %}
            <tr><td style="padding:0 8px 20px;font-family:Arial,Helvetica,sans-serif;color:#576d65;font-size:13px;line-height:21px;word-wrap:break-word;">{{ summary }}</td></tr>
          {% endif %}
          <tr>
            <td bgcolor="#ffffff" style="background-color:#ffffff;border:1px solid #dfe8e2;border-radius:16px;box-shadow:0 12px 36px rgba(20,53,39,.05);">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;table-layout:fixed;mso-table-lspace:0pt;mso-table-rspace:0pt;">
                <tr><td height="5" bgcolor="#087f5b" style="height:5px;background-color:#087f5b;border-radius:16px 16px 0 0;font-size:1px;line-height:5px;mso-line-height-rule:exactly;">&nbsp;</td></tr>
                <tr>
                  <td style="padding:32px 28px 30px;font-family:Arial,Helvetica,sans-serif;word-wrap:break-word;overflow-wrap:break-word;">
                    <p style="margin:0 0 15px;font-family:Arial,Helvetica,sans-serif;color:#087f5b;font-size:11px;font-weight:700;line-height:18px;letter-spacing:1px;text-transform:uppercase;">{% block eyebrow %}MYKEYNEST{% endblock %}</p>
                    <h1 style="margin:0;font-family:Arial,Helvetica,sans-serif;color:#132c25;font-size:27px;font-weight:700;line-height:35px;letter-spacing:-.5px;word-wrap:break-word;">{% block heading %}{% endblock %}</h1>
                  </td>
                </tr>
                <tr><td style="padding:0 28px;font-family:Arial,Helvetica,sans-serif;color:#435e53;font-size:15px;line-height:26px;word-wrap:break-word;overflow-wrap:break-word;">{% block content %}{% endblock %}</td></tr>
                <tr><td style="padding:0 28px;font-family:Arial,Helvetica,sans-serif;word-wrap:break-word;">{% block action %}{% endblock %}</td></tr>
                <tr><td style="padding:0 28px 30px;font-family:Arial,Helvetica,sans-serif;color:#576d65;font-size:13px;line-height:22px;word-wrap:break-word;">{% block after_action %}{% endblock %}</td></tr>
              </table>
            </td>
          </tr>
          <tr>
            <td align="left" style="padding:23px 8px 0;font-family:Arial,Helvetica,sans-serif;color:#576d65;font-size:12px;line-height:20px;word-wrap:break-word;">
              {% block footer %}
                <p style="margin:0;">{{ 'service_message'|trans({}, 'emails', emailLocale) }}</p>
              {% endblock %}
              <p style="margin:13px 0 0;color:#435e53;">MYKEYNEST · OptiWebSolutions</p>
              <p style="margin:5px 0 0;"><a href="mailto:contact@key-nest.com" style="color:#435e53;text-decoration:underline;">contact@key-nest.com</a> &nbsp;·&nbsp; <a href="https://key-nest.com/mentions-legales" style="color:#435e53;text-decoration:underline;">{{ 'legal_notice'|trans({}, 'emails', emailLocale) }}</a></p>
              <p style="margin:8px 0 0;color:#576d65;font-size:11px;">© {{ 'now'|date('Y') }} MYKEYNEST</p>
            </td>
          </tr>
        </table>
        <!--[if mso]></td></tr></table><![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>
