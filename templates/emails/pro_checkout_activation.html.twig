{% extends 'emails/layout.html.twig' %}

{% block title %}{{ 'email.subscription.activation_title'|trans({'%plan%': planName|default('PRO')}, null, locale|default('fr')) }}{% endblock %}
{% block preheader %}{{ 'email.subscription.activation_intro'|trans({}, null, locale|default('fr')) }}{% endblock %}
{% block eyebrow %}{{ 'email.subscription.payment_confirmed'|trans({}, null, locale|default('fr')) }}{% endblock %}
{% block heading %}{{ 'email.subscription.activation_title'|trans({'%plan%': planName|default('PRO')}, null, locale|default('fr')) }}{% endblock %}

{% block content %}
  <p style="margin:0;">{{ 'email.subscription.activation_intro'|trans({}, null, locale|default('fr')) }}</p>
  {% include 'emails/_subscription_summary.html.twig' %}
{% endblock %}

{% block action %}
  {% include 'emails/_action.html.twig' with {actionUrl: setup_url, label: 'email.subscription.create_account'|trans({}, null, emailLocale)} %}
{% endblock %}

{% block after_action %}
  <p style="margin:20px 0 0;padding:12px 14px;background:#fff8e7;border-left:3px solid #f59e0b;border-radius:4px;color:#80601f;font-size:12px;line-height:1.6;">Ce lien personnel expire le <strong>{{ expiresAt|date('d/m/Y à H:i') }}</strong>.</p>
{% endblock %}

{% block footer %}
  <p style="margin:0;">{{ 'email.subscription.security_footer'|trans({}, null, locale|default('fr')) }}</p>

{% endblock %}
