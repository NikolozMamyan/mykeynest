{% extends 'emails/layout.html.twig' %}

{% block title %}{{ 'email.subscription.activated_title'|trans({'%plan%': planName|default('PRO')}, null, locale|default('fr')) }}{% endblock %}
{% block preheader %}{{ 'email.subscription.activated_intro'|trans({}, null, locale|default('fr')) }}{% endblock %}
{% block eyebrow %}{{ 'email.subscription.payment_confirmed'|trans({}, null, locale|default('fr')) }}{% endblock %}
{% block heading %}{{ 'email.subscription.activated_title'|trans({'%plan%': planName|default('PRO')}, null, locale|default('fr')) }}{% endblock %}

{% block content %}
  <p style="margin:0;">{{ 'email.subscription.activated_intro'|trans({}, null, locale|default('fr')) }}</p>
  {% include 'emails/_subscription_summary.html.twig' %}
  <p style="margin:0;padding:13px 15px;background:#eefaf5;border-left:3px solid #10b981;border-radius:4px;color:#436058;font-size:13px;line-height:1.6;">{{ 'email.subscription.billing_note'|trans({}, null, locale|default('fr')) }}</p>
{% endblock %}

{% block action %}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:26px;">
    <tr><td style="background:#059669;border-radius:4px;"><a href="{{ login_url }}" style="display:inline-block;padding:13px 23px;color:#fff;font-size:14px;font-weight:700;text-decoration:none;">{{ 'email.subscription.open_app'|trans({}, null, locale|default('fr')) }}</a></td></tr>
  </table>
{% endblock %}

{% block after_action %}
  <p style="margin:18px 0 0;font-size:12px;color:#88938f;"><a href="{{ forgot_password_url }}" style="color:#596579;text-decoration:underline;">Mot de passe oublié ?</a></p>
{% endblock %}

{% block footer %}
  <p style="margin:0;">{{ 'email.subscription.security_footer'|trans({}, null, locale|default('fr')) }}</p>
  <p style="margin:5px 0 0;">© {{ 'now'|date('Y') }} MYKEYNEST</p>
{% endblock %}
