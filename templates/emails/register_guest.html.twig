{% extends 'emails/layout.html.twig' %}

{% block title %}Finalisez votre accès MYKEYNEST{% endblock %}
{% block preheader %}Un accès sécurisé vous attend sur MYKEYNEST.{% endblock %}
{% block eyebrow %}Invitation sécurisée{% endblock %}
{% block heading %}Finalisez votre accès à MYKEYNEST{% endblock %}

{% block content %}
  <p style="margin:0;">Vous avez été invité à consulter un accès partagé en toute sécurité. Créez votre mot de passe pour activer votre espace personnel.</p>
  <p style="margin:22px 0 0;padding:12px 14px;background:#fff8e7;border-left:3px solid #f59e0b;border-radius:4px;color:#80601f;font-size:12px;">Ce lien personnel expire le <strong>{{ expiresAt|date('d/m/Y à H:i') }}</strong>.</p>
{% endblock %}

{% block action %}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:25px;"><tr><td style="background:#059669;border-radius:4px;"><a href="{{ guest_register }}" style="display:inline-block;padding:13px 23px;color:#fff;font-size:14px;font-weight:700;text-decoration:none;">Créer mon compte</a></td></tr></table>
{% endblock %}

{% block after_action %}<p style="margin:16px 0 0;font-size:12px;"><a href="{{ guest_preview }}" style="color:#596579;text-decoration:underline;">Consulter l’invitation avant de créer mon compte</a></p>{% endblock %}
{% block footer %}<p style="margin:0;">Si vous n’êtes pas concerné, ignorez simplement ce message.</p><p style="margin:5px 0 0;">© {{ 'now'|date('Y') }} MYKEYNEST</p>{% endblock %}
