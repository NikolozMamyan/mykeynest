{% extends 'emails/layout.html.twig' %}

{% block title %}Autorisez cette installation MYKEYNEST{% endblock %}
{% block preheader %}Une nouvelle installation de l’extension attend votre confirmation.{% endblock %}
{% block eyebrow %}Nouvelle extension{% endblock %}
{% block heading %}Autorisez cette installation{% endblock %}

{% block content %}
  <p style="margin:0;">Bonjour <strong style="color:#132c25;">{{ user.email }}</strong>, une nouvelle installation de l’extension MYKEYNEST a été détectée.</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;table-layout:fixed;margin:23px 0;background:#f4f7f5;border:1px solid #e0e8e3;border-radius:12px;">
    <tr><td colspan="2" style="padding:9px 15px;color:#132c25;font-size:12px;line-height:21px;word-wrap:break-word;"><span style="display:block;color:#576d65;">Appareil</span>{{ deviceLabel ?: userAgent ?: 'Inconnu' }}</td></tr>
    <tr><td style="word-wrap:break-word;padding:9px 15px;color:#576d65;font-size:12px;">Navigateur</td><td align="right" style="word-wrap:break-word;padding:9px 15px;color:#132c25;font-size:12px;">{{ browserName ?: 'Inconnu' }} {{ browserVersion ?: '' }}</td></tr>
    <tr><td style="word-wrap:break-word;padding:9px 15px;color:#576d65;font-size:12px;">Système</td><td align="right" style="word-wrap:break-word;padding:9px 15px;color:#132c25;font-size:12px;">{{ osName ?: 'Inconnu' }} {{ osVersion ?: '' }}</td></tr>
    <tr><td style="word-wrap:break-word;padding:9px 15px;color:#576d65;font-size:12px;">Adresse IP</td><td align="right" style="word-wrap:break-word;padding:9px 15px;color:#132c25;font-size:12px;">{{ ip ?: 'Inconnue' }}</td></tr>
    <tr><td style="word-wrap:break-word;padding:9px 15px 14px;color:#576d65;font-size:12px;">Date</td><td align="right" style="word-wrap:break-word;padding:9px 15px 14px;color:#132c25;font-size:12px;">{{ requestedAt|date('d/m/Y à H:i') }}</td></tr>
  </table>
{% endblock %}

{% block action %}
  {% include 'emails/_action.html.twig' with {actionUrl: approveUrl, label: 'Autoriser', secondaryUrl: rejectUrl, secondaryLabel: 'Refuser'} %}
{% endblock %}

{% block after_action %}<p style="margin:21px 0 0;color:#576d65;font-size:12px;line-height:1.6;">Les liens expirent dans 15 minutes. L’extension restera inactive tant que vous ne l’avez pas autorisée.</p>{% endblock %}
{% block footer %}<p style="margin:0;">Si cette demande ne vient pas de vous, refusez-la et vérifiez la sécurité de votre compte.</p>{% endblock %}
