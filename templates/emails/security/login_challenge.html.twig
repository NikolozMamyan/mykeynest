{% extends 'emails/layout.html.twig' %}

{% block title %}Validez cette connexion{% endblock %}
{% block preheader %}Une connexion depuis un nouvel appareil attend votre confirmation.{% endblock %}
{% block eyebrow %}Alerte de sécurité{% endblock %}
{% block heading %}Est-ce bien vous ?{% endblock %}

{% block content %}
  <p style="margin:0;">Bonjour <strong style="color:#172033;">{{ user.email }}</strong>, une connexion depuis un appareil non reconnu attend votre confirmation.</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:23px 0;background:#f7faf9;border:1px solid #e1e9e7;border-radius:6px;">
    <tr><td style="padding:9px 15px;color:#748079;font-size:12px;">Adresse IP</td><td align="right" style="padding:9px 15px;color:#172033;font-size:12px;">{{ ip ?: 'Inconnue' }}</td></tr>
    <tr><td style="padding:9px 15px;color:#748079;font-size:12px;">Appareil</td><td align="right" style="max-width:310px;padding:9px 15px;color:#172033;font-size:12px;word-break:break-word;">{{ userAgent ?: 'Inconnu' }}</td></tr>
    <tr><td style="padding:9px 15px 14px;color:#748079;font-size:12px;">Date</td><td align="right" style="padding:9px 15px 14px;color:#172033;font-size:12px;">{{ requestedAt|date('d/m/Y à H:i') }}</td></tr>
  </table>
{% endblock %}

{% block action %}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:4px;"><tr><td style="padding-right:9px;"><a href="{{ approveUrl }}" style="display:inline-block;padding:13px 21px;border-radius:4px;background:#059669;color:#fff;font-size:13px;font-weight:700;text-decoration:none;">Oui, c’est moi</a></td><td><a href="{{ rejectUrl }}" style="display:inline-block;padding:12px 20px;border:1px solid #ef4444;border-radius:4px;color:#dc2626;font-size:13px;font-weight:700;text-decoration:none;">Bloquer la connexion</a></td></tr></table>
{% endblock %}

{% block after_action %}<p style="margin:21px 0 0;color:#88938f;font-size:12px;line-height:1.6;">Les liens expirent dans 15 minutes. Sans validation, aucune nouvelle session ne sera ouverte.</p>{% endblock %}
{% block footer %}<p style="margin:0;">Ne transférez jamais cet e-mail. MYKEYNEST ne vous demandera jamais votre mot de passe.</p><p style="margin:5px 0 0;">© {{ 'now'|date('Y') }} MYKEYNEST</p>{% endblock %}
