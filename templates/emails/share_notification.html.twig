{% extends 'emails/sharing_layout.html.twig' %}
{% set actionUrl = app_url %}
{% block action_label %}{{ 'sharing.open_access'|trans({}, 'emails', emailLocale) }}{% endblock %}
{% block title %}{{ 'sharing.received_heading'|trans({}, 'emails', emailLocale) }}{% endblock %}
{% block preheader %}{{ 'sharing.received_intro'|trans({'%owner%': owner.email, '%count%': credentials|length}, 'emails', emailLocale) }}{% endblock %}
{% block eyebrow %}{{ 'sharing.share_eyebrow'|trans({}, 'emails', emailLocale) }}{% endblock %}
{% block heading %}{{ 'sharing.received_heading'|trans({}, 'emails', emailLocale) }}{% endblock %}
{% block introduction %}{{ 'sharing.received_intro'|trans({'%owner%': owner.email, '%count%': credentials|length}, 'emails', emailLocale) }}{% endblock %}
{% block content %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;table-layout:fixed;border-collapse:collapse;">
    {% for credential in credentials|slice(0, 3) %}
      <tr>
        <td width="46" valign="middle" style="width:46px;padding:10px 0;{{ loop.last ? '' : 'border-bottom:1px solid #e2e8f0;' }}"><span style="display:block;width:36px;height:36px;border:1px solid #d1e6da;border-radius:9px;background-color:#f0fdf4;color:#047857;font-size:16px;font-weight:700;line-height:36px;text-align:center;">{{ credential.name|slice(0, 1)|upper }}</span></td>
        <td style="padding:10px 0;word-wrap:break-word;{{ loop.last ? '' : 'border-bottom:1px solid #e2e8f0;' }}"><strong style="display:block;color:#1e293b;font-size:16px;line-height:23px;">{{ credential.name }}</strong><span style="display:block;color:#475569;font-size:14px;line-height:21px;">{{ credential.domain }}</span></td>
      </tr>
    {% endfor %}
  </table>
  {% if credentials|length > 3 %}<p style="margin:10px 0 0;color:#047857;font-size:15px;font-weight:700;">{{ 'sharing.more_access'|trans({'%count%': credentials|length - 3}, 'emails', emailLocale) }}</p>{% endif %}
  <p style="margin:12px 0 0;color:#475569;font-size:14px;line-height:21px;">{{ 'sharing.permissions'|trans({}, 'emails', emailLocale) }}</p>
{% endblock %}
{% block footer %}{{ 'sharing.share_footer'|trans({}, 'emails', emailLocale) }}{% endblock %}
