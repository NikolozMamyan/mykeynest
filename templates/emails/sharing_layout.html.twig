{% set emailLocale = locale|default(user.locale|default(guest.locale|default('locale'|trans({}, 'emails')))) %}
<!doctype html>
<html lang="{{ emailLocale }}" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="format-detection" content="telephone=no,date=no,address=no,email=no">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>{% block title %}MYKEYNEST{% endblock %}</title>
  <!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->
</head>
<body bgcolor="#f8fafc" style="margin:0;padding:0;background-color:#f8fafc;color:#1e293b;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <div aria-hidden="true" style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;mso-hide:all;">{% block preheader %}{% endblock %}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f8fafc" style="width:100%;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;">
    <tr><td align="center" style="padding:20px 12px;">
      <!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width:100%;max-width:600px;table-layout:fixed;background-color:#ffffff;border:1px solid #e2e8f0;border-radius:16px;border-spacing:0;">
        <tr><td style="padding:18px 24px;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
            <td width="42" style="width:42px;"><img src="https://key-nest.com/images/email-logo.png" width="27" height="36" alt="" style="display:block;border:0;width:27px;height:36px;"></td>
            <td style="font-family:Arial,Helvetica,sans-serif;color:#1e293b;font-size:23px;line-height:28px;font-weight:800;letter-spacing:-.8px;">MY<span style="color:#059669;">KEY</span>NEST</td>
          </tr></table>
        </td></tr>
        <tr><td bgcolor="#07110f" style="padding:25px 24px 27px;background-color:#07110f;word-wrap:break-word;overflow-wrap:break-word;">
          <p style="margin:0 0 12px;color:#a1e8bc;font-size:14px;line-height:20px;font-weight:700;letter-spacing:1px;text-transform:uppercase;">{% block eyebrow %}MYKEYNEST{% endblock %}</p>
          <h1 style="margin:0;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:32px;line-height:39px;font-weight:700;letter-spacing:-.8px;">{% block heading %}{% endblock %}</h1>
          <p style="margin:12px 0 0;color:#d2e4db;font-size:16px;line-height:24px;">{% block introduction %}{% endblock %}</p>
        </td></tr>
        <tr><td style="padding:22px 24px 0;color:#334155;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:25px;word-wrap:break-word;overflow-wrap:break-word;">{% block content %}{% endblock %}</td></tr>
        <tr><td style="padding:22px 24px 24px;word-wrap:break-word;overflow-wrap:break-word;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-spacing:0;"><tr><td align="center" bgcolor="#059669" style="background-color:#059669;border:1px solid #059669;border-radius:9px;mso-padding-alt:15px 18px;">
            <a href="{{ actionUrl }}" style="display:block;padding:15px 18px;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:22px;font-weight:700;text-decoration:none;text-align:center;border-radius:9px;mso-padding-alt:0;">{% block action_label %}{% endblock %} &nbsp;→</a>
          </td></tr></table>
          {% block after_action %}{% endblock %}
          <p style="margin:17px 0 0;color:#475569;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:21px;">{{ 'sharing.button_help'|trans({}, 'emails', emailLocale) }} <a href="{{ actionUrl }}" style="color:#047857;text-decoration:underline;">{{ 'sharing.open_link'|trans({}, 'emails', emailLocale) }}</a></p>
          <div aria-hidden="true" style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;mso-hide:all;">{{ actionUrl }}</div>
        </td></tr>
      </table>
      <!--[if mso]></td></tr></table><![endif]-->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;table-layout:fixed;"><tr><td style="padding:16px 8px 0;color:#475569;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:21px;">
        <p style="margin:0;">{% block footer %}{{ 'sharing.invitation_footer'|trans({}, 'emails', emailLocale) }}{% endblock %}</p>
        <p style="margin:10px 0 0;">MYKEYNEST · OptiWebSolutions &nbsp;·&nbsp; <a href="mailto:contact@key-nest.com" style="color:#047857;text-decoration:underline;">contact@key-nest.com</a></p>
      </td></tr></table>
    </td></tr>
  </table>
</body>
</html>
