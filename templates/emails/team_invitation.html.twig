{% extends 'emails/sharing_layout.html.twig' %}
{% set actionUrl = guest_register %}
{% block action_label %}{{ 'sharing.join_group'|trans({}, 'emails', emailLocale) }}{% endblock %}
{% block title %}{{ 'sharing.team_title'|trans({'%team%': team.name}, 'emails', emailLocale) }}{% endblock %}
{% block preheader %}{{ 'sharing.team_title'|trans({'%team%': team.name}, 'emails', emailLocale) }}{% endblock %}
{% block eyebrow %}{{ 'sharing.team_eyebrow'|trans({}, 'emails', emailLocale) }}{% endblock %}
{% block heading %}{{ 'sharing.team_heading'|trans({}, 'emails', emailLocale) }}{% endblock %}
{% block introduction %}{{ 'sharing.team_intro'|trans({}, 'emails', emailLocale) }}{% endblock %}
{% block content %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f0fdf4" style="width:100%;table-layout:fixed;background-color:#f0fdf4;border-left:3px solid #059669;"><tr><td style="padding:13px 16px;word-wrap:break-word;">
    <p style="margin:0;color:#1e293b;font-size:20px;line-height:27px;font-weight:700;">{{ team.name }}</p>
    <p style="margin:6px 0 0;color:#334155;font-size:15px;line-height:23px;">{{ 'sharing.invited_email'|trans({}, 'emails', emailLocale) }} : {{ user.email }}</p>
  </td></tr></table>
  <p style="margin:14px 0 0;">{{ 'sharing.team_body'|trans({}, 'emails', emailLocale) }}</p>
  <p style="margin:12px 0 0;color:#475569;font-size:14px;line-height:21px;">{{ 'sharing.expiry'|trans({'%date%': expiresAt|date('d/m/Y H:i')}, 'emails', emailLocale) }}</p>
{% endblock %}
