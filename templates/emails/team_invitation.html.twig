{% extends 'emails/layout.html.twig' %}

{% block title %}Invitation à rejoindre l’équipe {{ team.name }}{% endblock %}
{% block preheader %}Une équipe MYKEYNEST vous invite à collaborer en toute sécurité.{% endblock %}
{% block eyebrow %}Invitation équipe{% endblock %}
{% block heading %}Rejoignez l’équipe {{ team.name }}{% endblock %}

{% block content %}
  <p style="margin:0;">Vous avez été invité à rejoindre cet espace de collaboration MYKEYNEST. Créez votre compte pour accéder aux éléments que l’équipe partagera avec vous.</p>
  <p style="margin:22px 0 0;padding:12px 14px;background:#fff8e7;border-left:3px solid #f59e0b;border-radius:4px;color:#80601f;font-size:12px;">Cette invitation personnelle expire le <strong>{{ expiresAt|date('d/m/Y à H:i') }}</strong>.</p>
{% endblock %}

{% block action %}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:25px;"><tr><td style="background:#059669;border-radius:4px;"><a href="{{ guest_register }}" style="display:inline-block;padding:13px 23px;color:#fff;font-size:14px;font-weight:700;text-decoration:none;">Créer mon compte</a></td></tr></table>
{% endblock %}

{% block footer %}<p style="margin:0;">Si vous n’attendiez pas cette invitation, vous pouvez ignorer cet e-mail.</p><p style="margin:5px 0 0;">© {{ 'now'|date('Y') }} MYKEYNEST</p>{% endblock %}
