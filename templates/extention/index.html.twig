{% extends 'base.html.twig' %}

{% block title %}{{ 'extension.page.meta_title'|trans }}{% endblock %}

{% block body %}
<div class="extension-settings-page"
     data-controller="extension-settings"
     data-extension-settings-checking-value="{{ 'extension.page.status.checking'|trans|e('html_attr') }}"
     data-extension-settings-installed-value="{{ 'extension.page.status.installed'|trans|e('html_attr') }}"
     data-extension-settings-not-found-value="{{ 'extension.page.status.not_found'|trans|e('html_attr') }}"
     data-extension-settings-ready-value="{{ 'extension.page.status.ready'|trans|e('html_attr') }}"
     data-extension-settings-saving-value="{{ 'extension.page.status.saving'|trans|e('html_attr') }}"
     data-extension-settings-saved-value="{{ 'extension.page.status.saved'|trans|e('html_attr') }}"
     data-extension-settings-save-error-value="{{ 'extension.page.status.save_error'|trans|e('html_attr') }}"
     data-extension-settings-update-required-value="{{ 'extension.page.status.update_required'|trans|e('html_attr') }}"
     data-extension-settings-invalid-domain-value="{{ 'extension.page.configuration.exclusions.invalid'|trans|e('html_attr') }}"
     data-extension-settings-remove-label-value="{{ 'extension.page.configuration.exclusions.remove'|trans|e('html_attr') }}">

  <section class="extension-download-card" aria-labelledby="extension-page-title">
    <div class="extension-download-card__content">
      <span class="extension-kicker">
        <span class="extension-kicker__dot"></span>
        {{ 'extension.page.hero.eyebrow'|trans }}
      </span>

      <h1 id="extension-page-title">{{ 'extension.page.hero.title'|trans }}</h1>
      <p>{{ 'extension.page.hero.tagline'|trans }}</p>

      <div class="extension-download-card__actions">
        <a href="{{ chromeWebStoreUrl }}" target="_blank" rel="noopener" class="extension-download-button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 3v12m0 0 4-4m-4 4-4-4" />
            <path d="M5 20h14" />
          </svg>
          {{ 'extension.page.hero.download'|trans }}
        </a>

        <span class="extension-detection-status" data-extension-settings-target="detection" aria-live="polite">
          <span class="extension-detection-status__pulse"></span>
          <span data-extension-settings-target="detectionLabel">{{ 'extension.page.status.checking'|trans }}</span>
        </span>
      </div>

      <small class="extension-download-card__note">{{ 'extension.page.hero.store_note'|trans }}</small>
    </div>

    <div class="extension-download-visual" aria-hidden="true">
      <div class="extension-browser-shell">
        <div class="extension-browser-shell__bar">
          <span></span><span></span><span></span>
          <div class="extension-browser-shell__address"></div>
          <div class="extension-browser-shell__toolbar-mark">
            {% include 'components/parts/_dot_mark.html.twig' with { extraClass: 'mkn-dotmark--extension' } only %}
          </div>
        </div>
        <div class="extension-browser-shell__body">
          <div class="extension-browser-shell__copy">
            <span></span><span></span><span></span>
          </div>
          <div class="extension-browser-shell__popup">
            <div class="extension-browser-shell__popup-head">
              {% include 'components/parts/_dot_mark.html.twig' with { extraClass: 'mkn-dotmark--extension-popup' } only %}
              <strong>MYKEYNEST</strong>
            </div>
            <div class="extension-browser-shell__credential"><i></i><span></span></div>
            <div class="extension-browser-shell__credential"><i></i><span></span></div>
            <div class="extension-browser-shell__button"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="extension-configuration" data-extension-settings-target="configuration" hidden aria-labelledby="extension-configuration-title">
    <div class="extension-configuration__header">
      <div>
        <span class="extension-section-label">{{ 'extension.page.configuration.eyebrow'|trans }}</span>
        <h2 id="extension-configuration-title">{{ 'extension.page.configuration.title'|trans }}</h2>
        <p>{{ 'extension.page.configuration.subtitle'|trans }}</p>
      </div>

      <div class="extension-installation-chip">
        <span class="extension-installation-chip__check">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 10 3 3 7-7" /></svg>
        </span>
        <span>
          <strong>{{ 'extension.page.configuration.connected'|trans }}</strong>
          <small data-extension-settings-target="version">MYKEYNEST</small>
        </span>
      </div>
    </div>

    <div class="extension-mode-grid" role="radiogroup" aria-label="{{ 'extension.page.configuration.aria'|trans }}">
      <label class="extension-mode-card" data-extension-settings-target="card">
        <input type="radio" name="extension-display-mode" value="default"
               data-extension-settings-target="mode"
               data-action="change->extension-settings#selectMode">
        <span class="extension-mode-card__selector" aria-hidden="true"><i></i></span>
        <span class="extension-mode-card__badge">{{ 'extension.page.configuration.recommended'|trans }}</span>
        <span class="extension-mode-card__copy">
          <strong>{{ 'extension.page.configuration.modes.default.title'|trans }}</strong>
          <small>{{ 'extension.page.configuration.modes.default.description'|trans }}</small>
        </span>

        <span class="extension-preview extension-preview--default" aria-hidden="true">
          <span class="extension-preview__browser-bar"><i></i><i></i><i></i><b></b></span>
          <span class="extension-preview__page-lines"><i></i><i></i><i></i></span>
          <span class="extension-preview__popup"><b><img src="{{ asset('images/mykeynest-dot-mark.svg') }}" alt=""></b><i></i><i></i><em></em></span>
        </span>
      </label>

      <label class="extension-mode-card" data-extension-settings-target="card">
        <input type="radio" name="extension-display-mode" value="inline"
               data-extension-settings-target="mode"
               data-action="change->extension-settings#selectMode">
        <span class="extension-mode-card__selector" aria-hidden="true"><i></i></span>
        <span class="extension-mode-card__copy">
          <strong>{{ 'extension.page.configuration.modes.inline.title'|trans }}</strong>
          <small>{{ 'extension.page.configuration.modes.inline.description'|trans }}</small>
        </span>

        <span class="extension-preview extension-preview--inline" aria-hidden="true">
          <span class="extension-preview__browser-bar"><i></i><i></i><i></i><b></b></span>
          <span class="extension-preview__form">
            <i></i><i class="is-focused"><b><img src="{{ asset('images/mykeynest-dot-mark.svg') }}" alt=""></b></i>
            <em><b><img src="{{ asset('images/mykeynest-dot-mark.svg') }}" alt=""></b><span></span><strong>&rarr;</strong></em>
          </span>
        </span>
      </label>

      <label class="extension-mode-card" data-extension-settings-target="card">
        <input type="radio" name="extension-display-mode" value="off"
               data-extension-settings-target="mode"
               data-action="change->extension-settings#selectMode">
        <span class="extension-mode-card__selector" aria-hidden="true"><i></i></span>
        <span class="extension-mode-card__copy">
          <strong>{{ 'extension.page.configuration.modes.off.title'|trans }}</strong>
          <small>{{ 'extension.page.configuration.modes.off.description'|trans }}</small>
        </span>

        <span class="extension-preview extension-preview--off" aria-hidden="true">
          <span class="extension-preview__browser-bar"><i></i><i></i><i></i><b></b></span>
          <span class="extension-preview__quiet-page"><i></i><i></i><i></i></span>
          <span class="extension-preview__quiet-badge"><b><img src="{{ asset('images/mykeynest-dot-mark.svg') }}" alt=""></b><i></i></span>
        </span>
      </label>
    </div>

    <div class="extension-order-panel">
      <div class="extension-order-panel__intro">
        <span class="extension-order-panel__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M8 6h12M8 12h9M8 18h6M4 5v14m0 0-2.5-2.5M4 19l2.5-2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span>
          <strong>{{ 'extension.page.configuration.order.title'|trans }}</strong>
          <small>{{ 'extension.page.configuration.order.description'|trans }}</small>
        </span>
      </div>

      <div class="extension-order-options" role="radiogroup" aria-label="{{ 'extension.page.configuration.order.aria'|trans }}">
        {% for mode in ['recent', 'domain', 'custom'] %}
          <label class="extension-order-option" data-extension-settings-target="sortCard">
            <input type="radio" name="extension-sort-mode" value="{{ mode }}"
                   data-extension-settings-target="sort"
                   data-action="change->extension-settings#selectSort">
            <span class="extension-order-option__visual extension-order-option__visual--{{ mode }}" aria-hidden="true">
              <i></i><i></i><i></i>
            </span>
            <span>
              <strong>{{ ('extension.page.configuration.order.modes.' ~ mode ~ '.title')|trans }}</strong>
              <small>{{ ('extension.page.configuration.order.modes.' ~ mode ~ '.description')|trans }}</small>
            </span>
            <span class="extension-order-option__check" aria-hidden="true">
              <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2"><path d="m4.5 9 3 3 6-6"/></svg>
            </span>
          </label>
        {% endfor %}
      </div>

      <p class="extension-order-panel__hint">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 5h9M7 10h9M7 15h9M3.5 5h.01M3.5 10h.01M3.5 15h.01" stroke-linecap="round"/></svg>
        {{ 'extension.page.configuration.order.custom_hint'|trans }}
      </p>
    </div>

    <div class="extension-exclusions-panel">
      <div class="extension-exclusions-panel__intro">
        <span class="extension-order-panel__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z"/><path d="M3.6 9h16.8M3.6 15h16.8M12 3c2.2 2.4 3.3 5.4 3.3 9S14.2 18.6 12 21M12 3C9.8 5.4 8.7 8.4 8.7 12s1.1 6.6 3.3 9"/>
          </svg>
        </span>
        <span>
          <strong>{{ 'extension.page.configuration.exclusions.title'|trans }}</strong>
          <small>{{ 'extension.page.configuration.exclusions.description'|trans }}</small>
        </span>
      </div>

      <form class="extension-exclusions-form" data-action="submit->extension-settings#addExclusion">
        <label class="sr-only" for="extension-excluded-domain">{{ 'extension.page.configuration.exclusions.label'|trans }}</label>
        <input id="extension-excluded-domain"
               type="text"
               inputmode="url"
               autocomplete="off"
               placeholder="{{ 'extension.page.configuration.exclusions.placeholder'|trans }}"
               data-extension-settings-target="exclusionInput">
        <button type="submit" data-extension-settings-target="exclusionSubmit">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke-linecap="round"/></svg>
          {{ 'extension.page.configuration.exclusions.add'|trans }}
        </button>
      </form>

      <div class="extension-exclusions-list" data-extension-settings-target="exclusionsList"></div>
      <p class="extension-exclusions-empty" data-extension-settings-target="exclusionsEmpty">
        {{ 'extension.page.configuration.exclusions.empty'|trans }}
      </p>
      <p class="extension-exclusions-note">{{ 'extension.page.configuration.exclusions.note'|trans }}</p>
    </div>

    <div class="extension-configuration__footer">
      <span class="extension-save-status" data-extension-settings-target="feedback" aria-live="polite">
        {{ 'extension.page.status.ready'|trans }}
      </span>
      <span>{{ 'extension.page.configuration.local_note'|trans }}</span>
    </div>
  </section>
</div>
{% endblock %}
