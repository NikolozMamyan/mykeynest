{% extends 'base.html.twig' %}

{% block title %}{{ 'extension_onboarding.title'|trans }}{% endblock %}
{% block breadcrumb %}{% endblock %}

{% block body_class %}public-page extension-onboarding-page{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/pages/public-shell.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/pages/extension-onboarding.css') }}">
{% endblock %}

{% block body %}
  {% set onboardingClientTranslations = {
    checking_title: 'extension_onboarding.checking.title'|trans,
    checking_message: 'extension_onboarding.checking.message'|trans,
    detected_title: 'extension_onboarding.checking.detected_title'|trans,
    detected_message: 'extension_onboarding.checking.detected_message'|trans,
    connecting_title: 'extension_onboarding.checking.connecting_title'|trans,
    connecting_message: 'extension_onboarding.checking.connecting_message'|trans,
    success_title: 'extension_onboarding.checking.success_title'|trans,
    success_message: 'extension_onboarding.checking.success_message'|trans,
    store_message: 'extension_onboarding.checking.store_message'|trans,
    waiting_install: 'extension_onboarding.checking.waiting_install'|trans,
    interrupted: 'extension_onboarding.checking.interrupted'|trans,
    not_detected: 'extension_onboarding.errors.not_detected'|trans,
    timeout: 'extension_onboarding.errors.timeout'|trans,
    no_response: 'extension_onboarding.errors.no_response'|trans,
    connection_failed: 'extension_onboarding.errors.connection_failed'|trans,
    pairing_failed: 'extension_onboarding.errors.pairing_failed'|trans,
    retry: 'extension_onboarding.errors.retry'|trans
  } %}
  <section class="extension-onboarding{{ isReconnect ? ' is-checking' : '' }}"
           id="extensionOnboarding"
           data-extension-id="{{ extensionId|e('html_attr') }}"
           data-reconnect="{{ isReconnect ? '1' : '0' }}"
           data-status-url="{{ path('api_extension_pairing_status') }}"
           data-start-url="{{ path('api_extension_pairing_start') }}"
           data-complete-url="{{ path('api_extension_pairing_complete') }}"
           data-start-csrf="{{ csrf_token('extension_pairing_start') }}"
           data-complete-csrf="{{ csrf_token('extension_pairing_complete') }}"
           data-translations="{{ onboardingClientTranslations|json_encode|e('html_attr') }}">
    {% include 'components/parts/_public_auth_header.html.twig' %}
    <div class="onboarding-install" id="installView">
      <div class="onboarding-layout">
        <div class="onboarding-copy">
          <span class="onboarding-copy__eyebrow">{{ 'extension_onboarding.step'|trans }}</span>
          <h1>{{ 'extension_onboarding.heading'|trans }} <span>{{ 'extension_onboarding.heading_accent'|trans }}</span></h1>
          <p class="onboarding-copy__lead">
            {{ 'extension_onboarding.lead'|trans }}
          </p>

          <ul class="onboarding-benefits">
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>{{ 'extension_onboarding.benefit_autofill'|trans }}</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>{{ 'extension_onboarding.benefit_pairing'|trans }}</span></li>
          </ul>

          {% if isMobileDevice %}
            <div class="onboarding-mobile-notice">
              <strong><i class="fa-solid fa-desktop"></i> {{ 'extension_onboarding.mobile_title'|trans }}</strong>
              {{ 'extension_onboarding.mobile_text'|trans }}
            </div>

            <form method="post" action="{{ path('app_extension_onboarding_defer') }}" class="onboarding-actions">
              <input type="hidden" name="_token" value="{{ csrf_token('extension_onboarding_defer') }}">
              <button class="btn btn-primary onboarding-button" type="submit">{{ 'extension_onboarding.mobile_continue'|trans }} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
            </form>
          {% else %}
            <div class="onboarding-actions">
              <a href="{{ chromeWebStoreUrl }}" target="_blank" rel="noopener" class="btn btn-primary onboarding-button" id="installExtensionButton">
                <i class="fa-brands fa-chrome" aria-hidden="true"></i> {{ 'extension_onboarding.install'|trans }}
              </a>
              <button type="button" class="btn btn-outline onboarding-button" id="retryPairingButton">
                {{ 'extension_onboarding.already_installed'|trans }}
              </button>
            </div>

            <p class="onboarding-install-status" id="installStatus" aria-live="polite">
              <i class="fa-solid fa-wand-magic-sparkles"></i> {{ 'extension_onboarding.install_status'|trans }}
            </p>
          {% endif %}
        </div>
        <div class="onboarding-visual" aria-hidden="true">
          <span class="onboarding-visual__label"><i class="fa-solid fa-shield-halved"></i> {{ 'extension_onboarding.eyebrow'|trans }}</span>
          {% include 'components/parts/_extension_browser_preview.html.twig' %}
          <div class="onboarding-visual__caption">
            <strong>{{ 'extension_onboarding.visual.title'|trans }}</strong>
            <p>{{ 'extension_onboarding.visual.text'|trans }}</p>
          </div>
        </div>
      </div>
      <p class="onboarding-privacy"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{ 'extension_onboarding.privacy'|trans }}</p>
    </div>

    {% if not isMobileDevice %}
      <div class="onboarding-checking" id="checkingView" aria-hidden="true">
        <div class="onboarding-checking__content" role="status" aria-live="polite">
          <div class="spinner-stage" aria-hidden="true">
            <div class="bound"></div>
            <div class="main_spinner">
              <div class="center_mass"></div>
              <div class="dot dot_1"></div>
              <div class="dot dot_2"></div>
            </div>
            <div class="spinner-result spinner-result--success"><i class="fa-solid fa-check"></i></div>
            <div class="spinner-result spinner-result--error"><i class="fa-solid fa-xmark"></i></div>
          </div>

          <h2 id="pairingStatusTitle">{{ 'extension_onboarding.checking.title'|trans }}</h2>
          <p class="onboarding-checking__message" id="pairingStatusMessage">{{ 'extension_onboarding.checking.message'|trans }}</p>

          <div class="onboarding-checking__actions">
            <button type="button" class="btn btn-primary onboarding-button" id="checkingRetryButton" hidden>
              <i class="fa-solid fa-rotate"></i> {{ 'extension_onboarding.checking.retry'|trans }}
            </button>
            <button type="button" class="btn btn-outline onboarding-button" id="backToInstallButton">
              {{ 'extension_onboarding.checking.back'|trans }}
            </button>
            <a href="{{ path('app_dashboard') }}" class="btn btn-primary onboarding-button" id="continueButton" hidden>
              {{ 'extension_onboarding.checking.continue'|trans }} <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>

          <div class="onboarding-progress" aria-label="{{ 'extension_onboarding.checking.progress_aria'|trans }}">
            <span class="onboarding-progress__dot is-active" data-step="install"></span>
            <span class="onboarding-progress__dot" data-step="detect"></span>
            <span class="onboarding-progress__dot" data-step="connect"></span>
          </div>
        </div>
      </div>
    {% endif %}
  </section>

  {% if not isMobileDevice %}
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const root = document.getElementById('extensionOnboarding');
        const installView = document.getElementById('installView');
        const checkingView = document.getElementById('checkingView');
        const statusTitle = document.getElementById('pairingStatusTitle');
        const statusMessage = document.getElementById('pairingStatusMessage');
        const installStatus = document.getElementById('installStatus');
        const retryButton = document.getElementById('retryPairingButton');
        const checkingRetryButton = document.getElementById('checkingRetryButton');
        const backButton = document.getElementById('backToInstallButton');
        const installButton = document.getElementById('installExtensionButton');
        const continueButton = document.getElementById('continueButton');
        const extensionId = root.dataset.extensionId;
        const isReconnect = root.dataset.reconnect === '1';
        const translations = JSON.parse(root.dataset.translations || '{}');
        const installReloadKey = 'mykeynest.extension-install-reload';
        const verificationReloadDelay = 1500;
        let pairingInProgress = false;
        let pairingCompleted = false;
        let verificationReloadTimer = null;
        let completionPollTimer = null;

        const setStep = (name) => {
          const order = ['install', 'detect', 'connect'];
          const currentIndex = order.indexOf(name);
          root.querySelectorAll('[data-step]').forEach((step) => {
            const index = order.indexOf(step.dataset.step);
            step.classList.toggle('is-active', index === currentIndex);
            step.classList.toggle('is-complete', index < currentIndex || pairingCompleted);
          });
        };

        const showChecking = () => {
          root.classList.add('is-checking');
          installView.setAttribute('aria-hidden', 'true');
          checkingView.setAttribute('aria-hidden', 'false');
        };

        const showInstall = () => {
          window.sessionStorage.removeItem(installReloadKey);
          window.clearTimeout(verificationReloadTimer);
          verificationReloadTimer = null;
          root.classList.remove('is-checking', 'has-error', 'has-success');
          installView.setAttribute('aria-hidden', 'false');
          checkingView.setAttribute('aria-hidden', 'true');
          checkingRetryButton.hidden = true;
          backButton.hidden = false;
          continueButton.hidden = true;
          setStep('install');
        };

        const setStatus = (title, message, type = 'info') => {
          statusTitle.textContent = title;
          statusMessage.textContent = message;
          root.classList.toggle('has-success', type === 'success');
          root.classList.toggle('has-error', type === 'error');
          checkingRetryButton.hidden = type !== 'error';
          backButton.hidden = type === 'success';
          continueButton.hidden = type !== 'success';
        };

        const beginChecking = () => {
          showChecking();
          setStep('detect');
          setStatus(translations.checking_title, translations.checking_message);
        };

        const finishPairing = (redirectUrl = continueButton.href) => {
          if (pairingCompleted) return;

          pairingCompleted = true;
          window.sessionStorage.removeItem(installReloadKey);
          window.clearTimeout(verificationReloadTimer);
          window.clearInterval(completionPollTimer);
          verificationReloadTimer = null;
          completionPollTimer = null;
          setStep('connect');
          setStatus(translations.success_title, translations.success_message, 'success');
          window.setTimeout(() => window.location.replace(redirectUrl || continueButton.href), 250);
        };

        const scheduleVerificationReload = () => {
          if (pairingCompleted || !root.classList.contains('is-checking')) return;

          window.clearTimeout(verificationReloadTimer);
          verificationReloadTimer = window.setTimeout(() => {
            if (pairingCompleted || root.classList.contains('has-error')) return;
            const reloadUrl = new URL(window.location.href);
            reloadUrl.searchParams.set('_extension_check', Date.now().toString());
            window.location.replace(reloadUrl.toString());
          }, verificationReloadDelay);
        };

        const pollCompletionState = async () => {
          if (pairingCompleted) return;

          try {
            const response = await fetch(root.dataset.statusUrl, {
              method: 'GET',
              credentials: 'include',
              cache: 'no-store',
              headers: {
                'Accept': 'application/json',
                'Cache-Control': 'no-cache'
              }
            });
            if (!response.ok) return;

            const data = await response.json();
            if (data.completed) {
              showChecking();
              finishPairing(data.redirectUrl);
            }
          } catch (error) {
            // Le pairing actif reste la source principale ; le polling est un filet de sécurité.
          }
        };

        const sendDirectToExtension = (message, timeoutMs) => new Promise((resolve, reject) => {
          if (!window.chrome?.runtime?.sendMessage) {
            reject(new Error(translations.not_detected));
            return;
          }

          const timeout = window.setTimeout(() => reject(new Error(translations.timeout)), timeoutMs);

          try {
            window.chrome.runtime.sendMessage(extensionId, message, (response) => {
              window.clearTimeout(timeout);
              if (window.chrome.runtime.lastError) {
                reject(new Error(window.chrome.runtime.lastError.message));
                return;
              }
              if (!response) {
                reject(new Error(translations.no_response));
                return;
              }
              resolve(response);
            });
          } catch (error) {
            window.clearTimeout(timeout);
            reject(error);
          }
        });

        const sendViaContentScript = (message, timeoutMs) => new Promise((resolve, reject) => {
          const requestId = window.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(16).slice(2)}`;
          const timeout = window.setTimeout(() => {
            window.removeEventListener('message', handleResponse);
            reject(new Error(translations.not_detected));
          }, timeoutMs);

          const handleResponse = (event) => {
            if (
              event.source !== window ||
              event.origin !== window.location.origin ||
              event.data?.source !== 'MYKEYNEST_EXTENSION' ||
              event.data?.type !== 'MYKEYNEST_EXTENSION_RESPONSE' ||
              event.data?.requestId !== requestId
            ) return;

            window.clearTimeout(timeout);
            window.removeEventListener('message', handleResponse);
            if (!event.data.response) {
              reject(new Error(translations.no_response));
              return;
            }
            resolve(event.data.response);
          };

          window.addEventListener('message', handleResponse);
          window.postMessage({
            source: 'MYKEYNEST_WEB',
            type: 'MYKEYNEST_EXTENSION_REQUEST',
            requestId,
            payload: message
          }, window.location.origin);
        });

        const sendToExtension = async (message, timeoutMs = 8000) => {
          try {
            return await sendDirectToExtension(message, timeoutMs);
          } catch (directError) {
            return sendViaContentScript(message, timeoutMs);
          }
        };

        const jsonRequest = async (url, csrf, payload) => {
          const response = await fetch(url, {
            method: 'POST',
            credentials: 'include',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
              'X-CSRF-TOKEN': csrf
            },
            body: JSON.stringify(payload)
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || translations.connection_failed);
          return data;
        };

        const detectAndPair = async (displayProgress = false) => {
          if (pairingInProgress || pairingCompleted) return;
          pairingInProgress = true;
          let extensionDetected = false;

          window.clearTimeout(verificationReloadTimer);
          verificationReloadTimer = null;

          if (displayProgress) beginChecking();

          try {
            const ping = await sendToExtension({ type: 'MYKEYNEST_EXTENSION_PING' }, 1200);
            if (!ping.ok || !ping.clientId) throw new Error(translations.not_detected);
            extensionDetected = true;

            showChecking();
            setStep('detect');
            setStatus(translations.detected_title, translations.detected_message);

            const start = await jsonRequest(root.dataset.startUrl, root.dataset.startCsrf, {
              clientId: ping.clientId,
              reconnect: isReconnect
            });
            if (start.completed) {
              finishPairing(start.redirectUrl);
              return;
            }

            setStep('connect');
            setStatus(translations.connecting_title, translations.connecting_message);

            const paired = await sendToExtension({
              type: 'MYKEYNEST_EXTENSION_PAIR',
              pairingToken: start.pairingToken
            }, 15000);

            if (!paired.ok) throw new Error(paired.error || translations.pairing_failed);

            const completed = await jsonRequest(root.dataset.completeUrl, root.dataset.completeCsrf, {
              publicId: start.challenge.publicId,
              clientId: ping.clientId
            });

            finishPairing(completed.redirectUrl);
          } catch (error) {
            if (!extensionDetected) {
              if (root.classList.contains('is-checking')) {
                setStep('detect');
                setStatus(translations.checking_title, '');
                window.sessionStorage.setItem(installReloadKey, 'checking');
                scheduleVerificationReload();
              } else {
                installStatus.innerHTML = `<i class="fa-solid fa-circle-info"></i> ${translations.waiting_install}`;
              }
            } else {
              window.sessionStorage.removeItem(installReloadKey);
              window.clearTimeout(verificationReloadTimer);
              showChecking();
              setStatus(translations.interrupted, error.message || translations.retry, 'error');
            }
          } finally {
            pairingInProgress = false;
          }
        };

        retryButton.addEventListener('click', () => {
          window.sessionStorage.setItem(installReloadKey, 'checking');
          detectAndPair(true);
        });
        checkingRetryButton.addEventListener('click', () => {
          window.sessionStorage.setItem(installReloadKey, 'checking');
          detectAndPair(true);
        });
        backButton.addEventListener('click', showInstall);
        installButton.addEventListener('click', () => {
          window.sessionStorage.setItem(installReloadKey, 'pending');
          beginChecking();
          statusMessage.textContent = translations.store_message;
        });

        const resumePairing = () => {
          if (window.sessionStorage.getItem(installReloadKey) === 'pending') {
            window.sessionStorage.setItem(installReloadKey, 'checking');
            detectAndPair(true);
            return;
          }

          detectAndPair(root.classList.contains('is-checking'));
        };

        if (window.sessionStorage.getItem(installReloadKey) === 'checking') {
          detectAndPair(true);
        } else {
          detectAndPair(false);
        }
        if (!isReconnect) {
          completionPollTimer = window.setInterval(pollCompletionState, 500);
          pollCompletionState();
        }
        window.setInterval(() => {
          if (!root.classList.contains('has-error')) detectAndPair(false);
        }, 1500);
        window.addEventListener('focus', resumePairing);
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') resumePairing();
        });
      });
    </script>
  {% endif %}
{% endblock %}
