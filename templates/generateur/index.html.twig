{% extends 'base.html.twig' %}

{% block title %}{{ 'generator.meta_title'|trans }}{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/pages/password-generator.css') }}">
{% endblock %}

{% block body %}
<div
  class="generator-page"
  data-controller="generator"
  data-generator-t-options-title-value="{{ 'generator.toast.options'|trans }}"
  data-generator-t-choose-one-type-value="{{ 'generator.toast.choose_one_type'|trans }}"
  data-generator-t-copied-title-value="{{ 'generator.toast.copied_title'|trans }}"
  data-generator-t-copied-msg-value="{{ 'generator.toast.copied_msg'|trans }}"
  data-generator-t-cleaned-title-value="{{ 'generator.toast.cleaned_title'|trans }}"
  data-generator-t-cleaned-msg-value="{{ 'generator.toast.cleaned_msg'|trans }}"
  data-generator-t-deleted-title-value="{{ 'generator.toast.deleted_title'|trans }}"
  data-generator-t-deleted-msg-value="{{ 'generator.toast.deleted_msg'|trans }}"
  data-generator-t-name-required-title-value="{{ 'generator.toast.name_required_title'|trans }}"
  data-generator-t-name-required-msg-value="{{ 'generator.toast.name_required_msg'|trans }}"
  data-generator-t-error-title-value="{{ 'generator.toast.error_title'|trans }}"
  data-generator-t-save-failed-value="{{ 'generator.toast.save_failed'|trans }}"
  data-generator-t-draft-title-value="{{ 'generator.toast.draft_title'|trans }}"
  data-generator-t-draft-saved-value="{{ 'generator.toast.draft_saved'|trans }}"
  data-generator-t-converted-title-value="{{ 'generator.toast.converted_title'|trans }}"
  data-generator-t-converted-msg-value="{{ 'generator.toast.converted_msg'|trans }}"
  data-generator-t-failed-value="{{ 'generator.toast.failed'|trans }}"
  data-generator-t-network-error-title-value="{{ 'generator.toast.network_error_title'|trans }}"
  data-generator-t-network-error-msg-value="{{ 'generator.toast.network_error_msg'|trans }}"
  data-generator-t-load-error-value="{{ 'generator.toast.load_error'|trans }}"
  data-generator-t-loading-value="{{ 'generator.list.loading'|trans }}"
  data-generator-t-empty-drafts-value="{{ 'generator.list.empty_drafts'|trans }}"
  data-generator-t-empty-recents-value="{{ 'generator.list.empty_recents'|trans }}"
  data-generator-t-entropy-empty-value="{{ 'generator.entropy_empty'|trans }}"
  data-generator-t-strength-empty-value="{{ 'generator.strength_empty'|trans }}"
  data-generator-t-entropy-template-value="{{ 'generator.entropy'|trans({'%bits%': '__BITS__'}) }}"
  data-generator-t-strength-template-value="{{ 'generator.strength'|trans({'%label%': '__LABEL__'}) }}"
  data-generator-t-strength-strong-value="{{ 'generator.strength_labels.strong'|trans }}"
  data-generator-t-strength-medium-value="{{ 'generator.strength_labels.medium'|trans }}"
  data-generator-t-strength-weak-value="{{ 'generator.strength_labels.weak'|trans }}"
  data-generator-t-copy-value="{{ 'generator.copy'|trans }}"
  data-generator-t-save-current-value="{{ 'generator.save_current'|trans }}"
  data-generator-t-convert-value="{{ 'generator.convert'|trans }}"
>
  <header class="generator-hero">
    <div class="generator-hero__icon" aria-hidden="true"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
    <div class="generator-hero__copy">
      <span class="generator-eyebrow">{{ 'generator.eyebrow'|trans }}</span>
      <h1>{{ 'generator.title'|trans }}</h1>
      <p>{{ 'generator.subtitle'|trans }}</p>
    </div>
    <div class="generator-private-badge">
      <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
      <span><strong>{{ 'generator.private_badge.title'|trans }}</strong>{{ 'generator.private_badge.text'|trans }}</span>
    </div>
  </header>

  <div class="generator-layout">
    <main class="generator-panel generator-panel--builder">
      <div class="generator-panel__heading">
        <div><span class="generator-step">01</span><h2>{{ 'generator.output.title'|trans }}</h2></div>
        <span class="generator-local-pill"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{ 'generator.output.local'|trans }}</span>
      </div>

      <div class="generator-output" data-generator-target="outputContainer">
        <span class="generator-output__label">{{ 'generator.output.label'|trans }}</span>
        <output class="generator-output__value" data-generator-target="output" aria-live="polite"></output>
        <div class="generator-output__actions">
          <button type="button" class="generator-icon-button" title="{{ 'generator.regenerate'|trans }}" aria-label="{{ 'generator.regenerate'|trans }}" data-action="click->generator#generatePassword"><i class="fa-solid fa-rotate" aria-hidden="true"></i></button>
          <button type="button" class="generator-button generator-button--primary" data-action="click->generator#copyPassword"><i class="fa-regular fa-copy" aria-hidden="true"></i><span data-generator-target="copyLabel">{{ 'generator.copy'|trans }}</span></button>
        </div>
      </div>

      <div class="generator-strength">
        <div class="generator-strength__top"><span id="strengthLabel">{{ 'generator.strength_empty'|trans }}</span><span id="entropyLabel">{{ 'generator.entropy_empty'|trans }}</span></div>
        <div class="generator-meter" data-generator-target="meter" role="progressbar" aria-label="{{ 'generator.strength_meter'|trans }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div></div></div>
      </div>

      <section class="generator-presets" aria-labelledby="generator-presets-title">
        <div class="generator-section-heading">
          <div><span class="generator-step">02</span><h2 id="generator-presets-title">{{ 'generator.presets.title'|trans }}</h2></div>
          <p>{{ 'generator.presets.help'|trans }}</p>
        </div>
        <div class="generator-preset-list">
          <button type="button" class="generator-preset" data-preset="balanced" data-action="click->generator#applyPreset"><i class="fa-solid fa-feather" aria-hidden="true"></i><span><strong>{{ 'generator.presets.balanced.title'|trans }}</strong><small>{{ 'generator.presets.balanced.text'|trans }}</small></span></button>
          <button type="button" class="generator-preset is-active" data-preset="strong" data-action="click->generator#applyPreset"><i class="fa-solid fa-shield" aria-hidden="true"></i><span><strong>{{ 'generator.presets.strong.title'|trans }}</strong><small>{{ 'generator.presets.strong.text'|trans }}</small></span></button>
          <button type="button" class="generator-preset" data-preset="maximum" data-action="click->generator#applyPreset"><i class="fa-solid fa-fingerprint" aria-hidden="true"></i><span><strong>{{ 'generator.presets.maximum.title'|trans }}</strong><small>{{ 'generator.presets.maximum.text'|trans }}</small></span></button>
        </div>
      </section>

      <section class="generator-customize" aria-labelledby="generator-customize-title">
        <div class="generator-section-heading">
          <div><span class="generator-step">03</span><h2 id="generator-customize-title">{{ 'generator.customize.title'|trans }}</h2></div>
          <p>{{ 'generator.customize.help'|trans }}</p>
        </div>

        <div class="generator-length">
          <div><label for="gen-length">{{ 'generator.password_length'|trans }}</label><small>{{ 'generator.length_help'|trans }}</small></div>
          <input class="generator-length__number" type="number" min="8" max="64" value="20" inputmode="numeric" aria-label="{{ 'generator.password_length'|trans }}" data-generator-target="lengthNumber" data-action="change->generator#updateLengthFromNumber">
          <input id="gen-length" class="generator-range" type="range" min="8" max="64" value="20" data-generator-target="lengthInput" data-action="input->generator#updateLength">
          <span class="generator-length__value" data-generator-target="lengthValue">20</span>
        </div>

        <div class="generator-options">
          {% set options = [
            {target: 'uppercase', icon: 'A', label: 'generator.uppercase'},
            {target: 'lowercase', icon: 'a', label: 'generator.lowercase'},
            {target: 'numbers', icon: '12', label: 'generator.numbers'},
            {target: 'symbols', icon: '#', label: 'generator.symbols'}
          ] %}
          {% for option in options %}
            <label class="generator-option">
              <span class="generator-option__icon" aria-hidden="true">{{ option.icon }}</span><span>{{ option.label|trans }}</span>
              <input type="checkbox" checked data-generator-target="{{ option.target }}" data-action="change->generator#optionChanged"><span class="generator-switch" aria-hidden="true"></span>
            </label>
          {% endfor %}
          <label class="generator-option generator-option--wide">
            <span class="generator-option__icon" aria-hidden="true"><i class="fa-solid fa-eye-slash"></i></span>
            <span><strong>{{ 'generator.ambiguous.title'|trans }}</strong><small>{{ 'generator.ambiguous.text'|trans }}</small></span>
            <input type="checkbox" checked data-generator-target="ambiguous" data-action="change->generator#optionChanged"><span class="generator-switch" aria-hidden="true"></span>
          </label>
        </div>
      </section>

      <div class="generator-primary-actions">
        <button type="button" class="generator-button generator-button--generate" data-action="click->generator#generatePassword"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>{{ 'generator.generate'|trans }}</button>
        <button type="button" class="generator-button generator-button--secondary" data-action="click->generator#openSaveCurrent"><i class="fa-regular fa-bookmark" aria-hidden="true"></i>{{ 'generator.save_current'|trans }}</button>
      </div>
    </main>

    <aside class="generator-panel generator-panel--history">
      <div class="generator-panel__heading generator-panel__heading--history">
        <div><span class="generator-step">{{ 'generator.history.eyebrow'|trans }}</span><h2>{{ 'generator.history.title'|trans }}</h2></div>
        <button type="button" class="generator-icon-button generator-icon-button--danger" title="{{ 'generator.history.delete_all'|trans }}" aria-label="{{ 'generator.history.delete_all'|trans }}" data-generator-target="historyClear" data-action="click->generator#confirmClearAll"><i class="fa-regular fa-trash-can" aria-hidden="true"></i></button>
      </div>
      <p class="generator-history-intro">{{ 'generator.history.subtitle'|trans }}</p>
      <div class="generator-tabs" role="tablist" aria-label="{{ 'generator.history.title'|trans }}">
        <button type="button" class="active" role="tab" aria-selected="true" data-action="click->generator#showRecents">{{ 'generator.history.tabs.recents'|trans }}</button>
        <button type="button" role="tab" aria-selected="false" data-action="click->generator#showDrafts">{{ 'generator.history.tabs.drafts'|trans }}</button>
      </div>
      <div class="generator-history-list" data-generator-target="list"></div>
      <div class="generator-security-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p><strong>{{ 'generator.history.note_title'|trans }}</strong>{{ 'generator.history.tooltip'|trans }}</p></div>
    </aside>
  </div>

  <div class="generator-toast-wrap" data-generator-target="toastWrap" aria-live="polite" aria-atomic="true"></div>

  <div class="generator-modal-backdrop" id="saveModal" hidden data-action="click->generator#closeOnBackdrop">
    <div class="generator-modal" role="dialog" aria-modal="true" aria-labelledby="save-modal-title">
      <div class="generator-modal__icon"><i class="fa-regular fa-bookmark" aria-hidden="true"></i></div><h3 id="save-modal-title">{{ 'generator.modals.save.title'|trans }}</h3><p>{{ 'generator.modals.save.text'|trans }}</p>
      <label for="draft-name">{{ 'generator.modals.save.label'|trans }}</label><input id="draft-name" type="text" maxlength="120" placeholder="{{ 'generator.modals.save.placeholder'|trans }}" data-generator-target="saveName" data-action="keydown.enter->generator#saveDraft">
      <div class="generator-modal__actions"><button type="button" class="generator-button generator-button--secondary" data-action="click->generator#closeModal">{{ 'generator.modals.save.cancel'|trans }}</button><button type="button" class="generator-button generator-button--primary" data-action="click->generator#saveDraft">{{ 'generator.modals.save.confirm'|trans }}</button></div>
    </div>
  </div>

  <div class="generator-modal-backdrop" id="convertModal" hidden data-action="click->generator#closeOnBackdrop">
    <div class="generator-modal" role="dialog" aria-modal="true" aria-labelledby="convert-modal-title">
      <div class="generator-modal__icon"><i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i></div><h3 id="convert-modal-title">{{ 'generator.modals.convert.title'|trans }}</h3><p>{{ 'generator.modals.convert.text'|trans }}</p>
      <label>{{ 'generator.modals.convert.name'|trans }}<input type="text" data-generator-target="credName"></label><label>{{ 'generator.modals.convert.domain'|trans }}<input type="text" inputmode="url" data-generator-target="credDomain"></label><label>{{ 'generator.modals.convert.username'|trans }}<input type="text" autocomplete="username" data-generator-target="credUsername"></label>
      <div class="generator-modal__actions"><button type="button" class="generator-button generator-button--secondary" data-action="click->generator#closeModal">{{ 'generator.modals.convert.cancel'|trans }}</button><button type="button" class="generator-button generator-button--primary" data-action="click->generator#convertDraft">{{ 'generator.modals.convert.confirm'|trans }}</button></div>
    </div>
  </div>

  <div class="generator-modal-backdrop" id="confirmModal" hidden data-action="click->generator#closeOnBackdrop">
    <div class="generator-modal" role="alertdialog" aria-modal="true" aria-labelledby="clear-modal-title">
      <div class="generator-modal__icon generator-modal__icon--danger"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></div><h3 id="clear-modal-title">{{ 'generator.modals.confirm_clear.title'|trans }}</h3><p>{{ 'generator.modals.confirm_clear.text'|trans }}</p>
      <div class="generator-modal__actions"><button type="button" class="generator-button generator-button--secondary" data-action="click->generator#closeModal">{{ 'generator.modals.confirm_clear.cancel'|trans }}</button><button type="button" class="generator-button generator-button--danger" data-action="click->generator#clearAllRecents">{{ 'generator.modals.confirm_clear.confirm'|trans }}</button></div>
    </div>
  </div>
</div>
{% endblock %}
