{% extends 'guest/layout.html.twig' %}
{% block title %}{{ 'guest_register.title_page'|trans }} · MYKEYNEST{% endblock %}
{% block content %}
<main class="ga-registration" data-controller="guest-access" data-guest-access-translations-value="{{ {mismatch: 'guest_register.validation.passwords_not_match'|trans, match: 'guest_register.validation.passwords_match'|trans, min: 'guest_register.strength.min'|trans, weak: 'guest_register.strength.weak'|trans, medium: 'guest_register.strength.medium'|trans, strong: 'guest_register.strength.strong'|trans}|json_encode|e('html_attr') }}">
    <aside class="ga-welcome">
        <div class="ga-welcome-top"><span class="ga-dark-badge"><span></span>{{ 'guest_access.invitation_badge'|trans }}</span><div class="ga-emblem" aria-hidden="true"><img src="{{ asset('images/mykeynest-dot-mark.svg') }}" alt="" width="45" height="60"></div></div>
        <div><p class="ga-eyebrow">{{ 'guest_access.welcome_eyebrow'|trans }}</p><h1>{{ 'guest_access.welcome_title'|trans }}<br><span>{{ 'guest_access.welcome_accent'|trans }}</span></h1><p class="ga-welcome-description">{{ 'guest_access.welcome_description'|trans }}</p></div>
        <ol class="ga-steps"><li><span>✓</span><div><strong>{{ 'guest_access.step_invited'|trans }}</strong><p>{{ user.email }}</p></div></li><li class="is-current"><span>2</span><div><strong>{{ 'guest_access.step_password'|trans }}</strong><p>{{ 'guest_access.step_password_help'|trans }}</p></div></li><li><span>3</span><div><strong>{{ 'guest_access.step_ready'|trans }}</strong><p>{{ 'guest_access.step_ready_help'|trans }}</p></div></li></ol>
        <p class="ga-dark-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/></svg>{{ 'guest_access.personal_link'|trans }}</p>
    </aside>
    <section class="ga-activation" aria-labelledby="activation-title">
        <div class="ga-form-heading"><p class="ga-eyebrow">{{ 'guest_access.activation'|trans }}</p><h2 id="activation-title">{{ 'guest_access.activation_title'|trans }}</h2><p>{{ 'guest_access.activation_description'|trans }}</p></div>
        {% for type in ['error', 'success'] %}{% for message in app.flashes(type) %}<p class="ga-flash is-{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</p>{% endfor %}{% endfor %}
        <div class="ga-recipient"><span class="ga-avatar">{{ user.email|slice(0, 1)|upper }}</span><div><span>{{ 'guest_register.form.email_readonly_label'|trans }}</span><strong>{{ user.email }}</strong></div><span class="ga-recipient-check" aria-hidden="true">✓</span></div>
        <form method="post" class="ga-form" data-action="submit->guest-access#validateRegistration">
            <input type="hidden" name="token" value="{{ token }}">
            <div class="ga-field"><label for="company">{{ 'auth.register.form.company_label'|trans }}</label><input type="text" id="company" name="company" value="{{ user.company }}" autocomplete="organization" placeholder="{{ 'auth.register.form.company_placeholder'|trans }}" required></div>
            <div class="ga-field"><label for="password">{{ 'guest_register.form.password_label'|trans }}</label><div class="ga-password-input"><input type="password" id="password" name="password" autocomplete="new-password" minlength="8" placeholder="{{ 'guest_register.form.password_placeholder'|trans }}" required data-guest-access-target="password" data-action="input->guest-access#checkPassword"><button type="button" aria-controls="password" aria-pressed="false" data-action="guest-access#toggleInput" data-show="{{ 'guest_access.show'|trans }}" data-hide="{{ 'guest_access.hide'|trans }}">{{ 'guest_access.show'|trans }}</button></div><div class="ga-strength-track" aria-hidden="true"><span data-guest-access-target="strength"></span></div><small class="ga-password-hint" data-guest-access-target="strengthLabel">{{ 'guest_register.form.password_hint_default'|trans }}</small></div>
            <div class="ga-field"><label for="password_confirm">{{ 'guest_register.form.password_confirm_label'|trans }}</label><div class="ga-password-input"><input type="password" id="password_confirm" name="password_confirm" autocomplete="new-password" placeholder="{{ 'guest_register.form.password_confirm_placeholder'|trans }}" required aria-describedby="password-match" data-guest-access-target="confirmation" data-action="input->guest-access#checkPassword"><button type="button" aria-controls="password_confirm" aria-pressed="false" data-action="guest-access#toggleInput" data-show="{{ 'guest_access.show'|trans }}" data-hide="{{ 'guest_access.hide'|trans }}">{{ 'guest_access.show'|trans }}</button></div><small id="password-match" class="ga-match" data-guest-access-target="match" aria-live="polite"></small></div>
            <button type="submit" class="ga-button ga-button-primary">{{ 'guest_access.activate'|trans }}<span aria-hidden="true">→</span></button>
        </form>
        <p class="ga-login">{{ 'guest_register.form.already_account'|trans }} <a href="{{ path('show_login') }}">{{ 'guest_register.form.login_link'|trans }}</a></p>
    </section>
</main>
{% endblock %}
