{% extends 'base_auth.html.twig' %}

{% block title %}Créer mon compte{% endblock %}
{% block body_class %}auth-form-page{% endblock %}

{% block body %}


<div class="auth-container">
  <div class="register-wrapper">

    {# ── Left column – Hero ── #}
    <div class="register-hero">
      <div class="hero-content">

        <div class="hero-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"/>
          </svg>
        </div>

        <h1>{{ 'guest_register.hero.title'|trans }}</h1>
        <p>{{ 'guest_register.hero.subtitle'|trans }}</p>

        <div class="guest-info-card">
          <div class="card-label">{{ 'guest_register.hero.guest_card_label'|trans }}</div>
          <div class="card-value">{{ user.email }}</div>
        </div>

        <div class="hero-features">
          <div class="feature-item">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {{ 'guest_register.hero.features.secure_access'|trans }}
          </div>

          <div class="feature-item">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
            </svg>
            {{ 'guest_register.hero.features.e2ee'|trans }}
          </div>

          <div class="feature-item">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {{ 'guest_register.hero.features.one_time_link'|trans }}
          </div>
        </div>

      </div>
    </div>

    {# ── Right column – Form ── #}
    <div class="register-form-section">


      <div class="form-header">
        <h2>{{ 'guest_register.form.header_title'|trans }}</h2>
        <p>{{ 'guest_register.form.header_subtitle'|trans }}</p>
      </div>

      {# Flash messages #}
      {% for message in app.flashes('error') %}
        <div class="flash-error">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>{{ message }}</span>
        </div>
      {% endfor %}

      {% for message in app.flashes('success') %}
        <div class="flash-success">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>{{ message }}</span>
        </div>
      {% endfor %}

      {# Email pre-filled (read-only) #}
      <div class="email-display" aria-label="{{ 'guest_register.form.email_readonly_label'|trans }}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <span>{{ user.email }}</span>
      </div>

      <form class="register-form" method="post" novalidate>
        <input type="hidden" name="token" value="{{ token }}">
        <div class="form-group">
          <label for="company">{{ 'auth.register.form.company_label'|trans }}</label>
          <input
            type="text"
            id="company"
            name="company"
            placeholder="{{ 'auth.register.form.company_placeholder'|trans }}"
            required
          >
        </div>
        <div class="form-group">
          <label for="password">{{ 'guest_register.form.password_label'|trans }}</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="{{ 'guest_register.form.password_placeholder'|trans }}"
            required
            autocomplete="new-password"
            minlength="8"
            oninput="updateStrength(this.value)"
          >
          <div class="password-strength" aria-hidden="true">
            <div class="password-strength-bar" id="strengthBar"></div>
          </div>
          <span class="strength-hint" id="strengthHint">{{ 'guest_register.form.password_hint_default'|trans }}</span>
        </div>

        <div class="form-group">
          <label for="password_confirm">{{ 'guest_register.form.password_confirm_label'|trans }}</label>
          <input
            type="password"
            id="password_confirm"
            name="password_confirm"
            placeholder="{{ 'guest_register.form.password_confirm_placeholder'|trans }}"
            required
            autocomplete="new-password"
            oninput="checkMatch()"
          >
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">
          {{ 'guest_register.form.submit'|trans }}
        </button>

        <p class="auth-hint">
          {{ 'guest_register.form.already_account'|trans }}
          <a href="{{ path('show_login') }}">{{ 'guest_register.form.login_link'|trans }}</a>
        </p>
      </form>

    </div>
  </div>
</div>

<script>
  // Small i18n bridge for the JS strength labels
  window.I18N = {
    strength: {
      min: "{{ 'guest_register.strength.min'|trans|e('js') }}",
      very_weak: "{{ 'guest_register.strength.very_weak'|trans|e('js') }}",
      weak: "{{ 'guest_register.strength.weak'|trans|e('js') }}",
      medium: "{{ 'guest_register.strength.medium'|trans|e('js') }}",
      strong: "{{ 'guest_register.strength.strong'|trans|e('js') }}",
      very_strong: "{{ 'guest_register.strength.very_strong'|trans|e('js') }}"
    }
  };

  const strengthBar   = document.getElementById('strengthBar');
  const strengthHint  = document.getElementById('strengthHint');
  const submitBtn     = document.getElementById('submitBtn');
  const confirmInput  = document.getElementById('password_confirm');
  const passwordInput = document.getElementById('password');

  function getStrength(password) {
    let score = 0;
    if (password.length >= 8) score++;
    if (password.length >= 12) score++;
    if (/[A-Z]/.test(password)) score++;
    if (/[0-9]/.test(password)) score++;
    if (/[^A-Za-z0-9]/.test(password)) score++;
    return score;
  }

  function updateStrength(value) {
    const score = getStrength(value);
    const levels = [
      { width: '0%',   color: '#e2e8f0', label: window.I18N.strength.min },
      { width: '20%',  color: '#ef4444', label: window.I18N.strength.very_weak },
      { width: '40%',  color: '#f59e0b', label: window.I18N.strength.weak },
      { width: '60%',  color: '#eab308', label: window.I18N.strength.medium },
      { width: '80%',  color: '#22c55e', label: window.I18N.strength.strong },
      { width: '100%', color: '#059669', label: window.I18N.strength.very_strong }
    ];

    const level = value.length === 0 ? levels[0] : levels[Math.min(score, 5)];
    strengthBar.style.width = level.width;
    strengthBar.style.background = level.color;
    strengthHint.textContent = level.label;

    checkMatch();
  }

  function checkMatch() {
    const pw  = passwordInput.value;
    const cpw = confirmInput.value;

    submitBtn.disabled = !(pw.length >= 8 && pw === cpw);

    if (cpw.length > 0) {
      confirmInput.style.borderColor = pw === cpw ? '#059669' : '#ef4444';
      confirmInput.style.boxShadow = pw === cpw
        ? '0 0 0 3px rgba(5,150,105,0.12)'
        : '0 0 0 3px rgba(239,68,68,0.12)';
    } else {
      confirmInput.style.borderColor = '#e2e8f0';
      confirmInput.style.boxShadow = 'none';
    }
  }

  // Disable submit by default until passwords match
  submitBtn.disabled = true;
</script>

{% endblock %}
