{% extends 'guest/layout.html.twig' %}
{% block title %}{{ 'guest_access.preview_title'|trans }} · MYKEYNEST{% endblock %}
{% block body_class %}guest-preview-page{% endblock %}
{% block content %}
<main class="ga-preview" data-controller="guest-access" data-guest-access-translations-value="{{ {show: 'guest_access.show'|trans, hide: 'guest_access.hide'|trans, copied: 'guest_access.copied'|trans, copyError: 'guest_access.copy_error'|trans}|json_encode|e('html_attr') }}">
    <section class="ga-preview-hero"><div><p class="ga-eyebrow">{{ 'guest_access.share_eyebrow'|trans }}</p><h1>{{ 'guest_access.preview_title'|trans }}</h1><p>{{ 'guest_access.preview_description'|trans }}</p></div><a href="{{ path('app_guest_register', {token: token, email: user.email}) }}" class="ga-button ga-button-primary">{{ 'guest_access.activate'|trans }}<span aria-hidden="true">→</span></a></section>
    {% set firstItem = sharedCredentials|first %}
    <div class="ga-preview-account"><span class="ga-avatar">{{ user.email|slice(0, 1)|upper }}</span><div><span>{{ 'guest_register.hero.guest_card_label'|trans }}</span><strong>{{ user.email }}</strong></div><div class="ga-invitation-actions"><span class="ga-preview-expiry" data-guest-access-target="expiry">{{ 'guest_access.personal_link'|trans }}</span><a class="ga-request-extension" data-guest-access-target="extension" href="{{ firstItem.extensionUrl|default('#') }}" {{ firstItem.extensionUrl|default(null) ? '' : 'hidden' }}>{{ 'share_validity.request_button'|trans }}</a></div></div>
    {% if sharedCredentials is empty %}
        <section class="ga-no-access"><span class="ga-emblem" aria-hidden="true"><img src="{{ asset('images/mykeynest-dot-mark.svg') }}" alt="" width="30" height="40"></span><h2>{{ 'guest_access.empty_title'|trans }}</h2><p>{{ 'guest_access.empty_description'|trans }}</p></section>
    {% else %}
        <div class="ga-preview-workspace">
            <aside class="ga-vault-list"><header><h2>{{ 'guest_access.credentials'|trans }}</h2><span>{{ sharedCredentials|length }}</span></header>
                <div class="ga-vault-search"><label for="guest-search" class="ga-sr-only">{{ 'guest_access.search'|trans }}</label><input type="search" id="guest-search" placeholder="{{ 'guest_access.search'|trans }}" data-action="input->guest-access#filterCredentials"></div>
                <div class="ga-vault-options" role="tablist" aria-orientation="vertical" aria-label="{{ 'guest_access.credentials'|trans }}">
                    {% for item in sharedCredentials %}<button id="guest-tab-{{ loop.index }}" type="button" role="tab" class="ga-vault-option" aria-controls="guest-credential-{{ loop.index }}" data-index="{{ loop.index }}" data-search="{{ (item.credential.name ~ ' ' ~ item.credential.domain ~ ' ' ~ item.owner.email)|lower }}" data-guest-access-target="choice" data-action="guest-access#selectCredential keydown->guest-access#choiceKeydown"><span class="ga-site-mark">{{ item.credential.name|slice(0, 1)|upper }}</span><span><strong>{{ item.credential.name }}</strong><small>{{ item.credential.domain }}</small></span><span class="ga-choice-arrow" aria-hidden="true">›</span></button>{% endfor %}
                    <p class="ga-search-empty" data-guest-access-target="empty" hidden>{{ 'guest_access.no_results'|trans }}</p>
                </div>
            </aside>
            <div class="ga-mobile-choice"><label for="guest-credential-select">{{ 'guest_access.username'|trans }}</label><select id="guest-credential-select" data-guest-access-target="select" data-action="change->guest-access#selectCredential">{% for item in sharedCredentials %}<option value="{{ loop.index }}">{{ item.credential.name }} · {{ item.credential.domain }}</option>{% endfor %}</select></div>
            <section class="ga-credential-details">
                {% for item in sharedCredentials %}
                    {% set expired = item.expired|default(item.sharedAccess.expired) %}
                    <article id="guest-credential-{{ loop.index }}" role="tabpanel" aria-labelledby="guest-tab-{{ loop.index }}" tabindex="0" data-index="{{ loop.index }}" data-guest-access-target="credential" data-extension-url="{{ item.extensionUrl|default('') }}" data-validity-label="{{ item.sharedAccess.expiresAt ? (expired ? 'share_validity.expired' : 'share_validity.until')|trans ~ ' ' ~ item.sharedAccess.expiresAt|date('d/m/Y H:i', 'Europe/Paris') : 'guest_access.personal_link'|trans }}">
                        <header class="ga-detail-heading"><span class="ga-site-mark">{{ item.credential.name|slice(0, 1)|upper }}</span><div><h2>{{ item.credential.name }}</h2><p>{{ item.credential.domain }}</p></div><span class="ga-access-badge">{{ (item.canRevealPassword ? 'guest_access.reveal_allowed' : 'guest_access.extension_only')|trans }}</span></header>
                        <p class="ga-shared-by">{{ 'guest_access.shared_by'|trans }} <strong>{{ item.owner.company ?: item.owner.email }}</strong>{% if item.owner.company %}<span>{{ item.owner.email }}</span>{% endif %}</p>
                        {% if expired %}<div class="ga-expired-access" role="status"><strong>{{ 'share_validity.expired'|trans }}</strong><p>{{ 'share_validity.expired_help'|trans }}</p></div>{% else %}
                        <dl class="ga-secret-fields">
                            <div><dt>{{ 'guest_access.username'|trans }}</dt><dd><span>{{ item.credential.username ?: '—' }}</span>{% if item.credential.username %}<button type="button" class="ga-copy-button" data-copy="{{ item.credential.username }}" data-action="guest-access#copy">{{ 'guest_access.copy'|trans }}</button>{% endif %}</dd></div>
                            <div><dt>{{ 'guest_register.form.password_label'|trans }}</dt><dd>{% if item.canRevealPassword %}<span class="ga-secret" data-password-hidden>••••••••••••</span><span class="ga-secret" data-password-visible hidden>{{ item.decryptedPassword }}</span><div class="ga-secret-actions"><button type="button" class="ga-copy-button" aria-pressed="false" data-action="guest-access#toggleSecret">{{ 'guest_access.show'|trans }}</button><button type="button" class="ga-copy-button" data-copy="{{ item.decryptedPassword }}" data-action="guest-access#copy">{{ 'guest_access.copy'|trans }}</button></div>{% else %}<span class="ga-restricted">{{ 'credential_access.restricted_message'|trans }}</span><a href="{{ path('app_guest_register', {token: token, email: user.email}) }}" class="ga-extension-cta">{{ 'share_validity.activate_extension'|trans }} <span aria-hidden="true">→</span></a>{% endif %}</dd></div>
                        </dl>
                        {% endif %}
                        <p class="ga-detail-note">{{ 'guest_access.shared_on'|trans({'%date%': item.sharedAccess.createdAt|date('d/m/Y H:i')}) }} · {{ 'guest_access.permission_note'|trans }}</p>
                    </article>
                {% endfor %}
            </section>
        </div>
    {% endif %}
    <div class="ga-toast" role="status" aria-live="polite" aria-atomic="true" data-guest-access-target="toast" hidden></div>
</main>
{% endblock %}
