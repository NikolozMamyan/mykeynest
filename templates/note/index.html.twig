{% extends 'base.html.twig' %}

{% block title %}{{ 'note.index.meta.title'|trans }}{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/pages/note-board.css') }}">
{% endblock %}

{% block body %}
  {% set statusConfig = {
    'todo': { title: ('note.index.board.statuses.todo'|trans), class: 'todo' },
    'in_progress': { title: ('note.index.board.statuses.in_progress'|trans), class: 'in-progress' },
    'done': { title: ('note.index.board.statuses.done'|trans), class: 'done' }
  } %}

  <div
    class="notes-page"
    data-controller="note-board"
    data-note-board-open-create-value="{{ (form.vars.submitted and not form.vars.valid) ? 'true' : 'false' }}"
    data-note-board-copy-success-value="{{ 'note.index.details.copied'|trans|e('html_attr') }}"
    data-note-board-copy-error-value="{{ 'note.index.details.copy_error'|trans|e('html_attr') }}"
    data-note-board-saving-value="{{ 'note.index.details.saving'|trans|e('html_attr') }}"
    data-note-board-save-error-value="{{ 'note.index.details.save_error'|trans|e('html_attr') }}"
  >
    <header class="notes-hero">
      <div class="notes-hero__copy">
        <span class="notes-eyebrow">
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          {{ isPersonalWorkspace ? ('note.index.header.personal_workspace'|trans) : team.name }}
        </span>
        <h1 class="notes-title">{{ 'note.index.header.title'|trans }}</h1>
        <p class="notes-subtitle">{{ 'note.index.header.subtitle'|trans }}</p>
      </div>

      <div class="notes-hero__actions">
        <label class="notes-workspace">
          <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
          <span class="sr-only">{{ 'note.index.workspace.label'|trans }}</span>
          <select data-action="change->note-board#navigateWorkspace" aria-label="{{ 'note.index.workspace.label'|trans }}">
            <option value="{{ path('app_note') }}" {{ isPersonalWorkspace ? 'selected' : '' }}>{{ 'note.index.workspace.selector_personal'|trans }}</option>
            {% for workspaceTeam in myTeams %}
              <option value="{{ path('app_note', { teamId: workspaceTeam.id }) }}" {{ team and workspaceTeam.id == team.id ? 'selected' : '' }}>{{ workspaceTeam.name }}</option>
            {% endfor %}
          </select>
        </label>

        {% if canCreateNote %}
          <button type="button" class="notes-primary-action" data-action="click->note-board#openCreate">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>{{ 'note.index.actions.new_note'|trans }}
          </button>
        {% endif %}
      </div>
    </header>

    <section class="notes-summary" aria-label="{{ 'note.index.stats.label'|trans }}">
      <button type="button" class="notes-summary-card" data-note-board-target="filter" data-filter="all" data-action="click->note-board#setFilter" aria-pressed="false">
        <span class="notes-summary-card__icon"><i class="fa-regular fa-note-sticky" aria-hidden="true"></i></span>
        <strong>{{ noteStats.total }}</strong><span>{{ 'note.index.stats.total'|trans }}</span>
      </button>
      <button type="button" class="notes-summary-card notes-summary-card--danger" data-note-board-target="filter" data-filter="overdue" data-action="click->note-board#setFilter" aria-pressed="false">
        <span class="notes-summary-card__icon"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span>
        <strong>{{ noteStats.overdue }}</strong><span>{{ 'note.index.stats.overdue'|trans }}</span>
      </button>
      <button type="button" class="notes-summary-card notes-summary-card--warning" data-note-board-target="filter" data-filter="soon" data-action="click->note-board#setFilter" aria-pressed="false">
        <span class="notes-summary-card__icon"><i class="fa-regular fa-calendar" aria-hidden="true"></i></span>
        <strong>{{ noteStats.dueSoon }}</strong><span>{{ 'note.index.stats.due_soon'|trans }}</span>
      </button>
      <div class="notes-summary-card notes-summary-card--success">
        <span class="notes-summary-card__icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
        <strong>{{ noteStats.done }}</strong><span>{{ 'note.index.stats.completed'|trans }}</span>
      </div>
    </section>

    {% if not canCreateNote %}
      <div class="notes-permission-hint" role="note">
        <i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>{{ 'note.index.permissions.team_member'|trans }}</span>
      </div>
    {% endif %}

    <section class="notes-toolbar" aria-label="{{ 'note.index.toolbar.label'|trans }}">
      <label class="notes-search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <span class="sr-only">{{ 'note.index.search.label'|trans }}</span>
        <input type="search" autocomplete="off" placeholder="{{ 'note.index.search.placeholder'|trans }}" data-note-board-target="search" data-action="input->note-board#search">
        <kbd>/</kbd>
      </label>

      <div class="notes-filters" role="group" aria-label="{{ 'note.index.filters.label'|trans }}">
        <button type="button" class="notes-filter is-active" data-note-board-target="filter" data-filter="all" data-action="click->note-board#setFilter" aria-pressed="true">{{ 'note.index.filters.all'|trans }}</button>
        <button type="button" class="notes-filter" data-note-board-target="filter" data-filter="assigned" data-action="click->note-board#setFilter" aria-pressed="false">{{ 'note.index.filters.assigned'|trans }} <span>{{ noteStats.assignedToMe }}</span></button>
        <button type="button" class="notes-filter" data-note-board-target="filter" data-filter="overdue" data-action="click->note-board#setFilter" aria-pressed="false">{{ 'note.index.filters.overdue'|trans }}</button>
        <button type="button" class="notes-filter" data-note-board-target="filter" data-filter="soon" data-action="click->note-board#setFilter" aria-pressed="false">{{ 'note.index.filters.due_soon'|trans }}</button>
      </div>

      <label class="notes-sort">
        <i class="fa-solid fa-arrow-down-wide-short" aria-hidden="true"></i>
        <span class="sr-only">{{ 'note.index.sort.label'|trans }}</span>
        <select data-note-board-target="sort" data-action="change->note-board#sort" aria-label="{{ 'note.index.sort.label'|trans }}">
          <option value="recent">{{ 'note.index.sort.recent'|trans }}</option>
          <option value="due">{{ 'note.index.sort.due'|trans }}</option>
          <option value="title">{{ 'note.index.sort.title'|trans }}</option>
        </select>
      </label>
    </section>

    {% if noteStats.total > 0 %}
      <section class="notes-board" data-note-board-target="board" aria-label="{{ 'note.index.board.label'|trans }}">
        {% for statusKey, config in statusConfig %}
          <section class="notes-column notes-column--{{ config.class }}" data-note-board-target="column" data-status="{{ statusKey }}">
            <header class="notes-column__header">
              <h2 class="notes-column__title"><span class="notes-column__dot" aria-hidden="true"></span>{{ config.title }}</h2>
              <span class="notes-column__count" data-note-board-target="columnCount">{{ notesByStatus[statusKey]|length }}</span>
            </header>

            <div class="notes-column__body">
              {% for note in notesByStatus[statusKey] %}
                {% set isOwner = note.createdBy and note.createdBy.id == app.user.id %}
                {% set isAssignee = note.isAssignedTo(app.user) %}
                {% set isOverdue = note.dueAt and note.dueAt < now and statusKey != 'done' %}
                {% set isDueSoon = note.dueAt and note.dueAt >= now and note.dueAt <= nextWeek and statusKey != 'done' %}
                {% set searchText = note.title ~ ' ' ~ (note.content ?? '') ~ ' ' ~ (note.createdBy.email ?? '') %}
                {% for assignment in note.assignments %}{% set searchText = searchText ~ ' ' ~ assignment.assignee.email %}{% endfor %}

                <article
                  class="note-card {{ isOverdue ? 'note-card--overdue' : (isDueSoon ? 'note-card--soon' : '') }}"
                  data-note-board-target="card"
                  data-status="{{ statusKey }}"
                  data-assigned="{{ isAssignee ? '1' : '0' }}"
                  data-due="{{ note.dueAt ? note.dueAt|date('U') : '' }}"
                  data-updated="{{ note.updatedAt ? note.updatedAt|date('U') : '' }}"
                  data-title="{{ note.title|lower|e('html_attr') }}"
                  data-search="{{ searchText|e('html_attr') }}"
                  data-note-title="{{ note.title|e('html_attr') }}"
                  data-note-content="{{ (note.content ?? '')|e('html_attr') }}"
                  data-empty-content="{{ 'note.index.details.no_content'|trans|e('html_attr') }}"
                  data-note-status-label="{{ config.title|e('html_attr') }}"
                  data-note-due-label="{{ note.dueAt ? note.dueAt|date('d/m/Y H:i') : ('note.index.card.no_due_date'|trans) }}"
                  data-note-due-input="{{ note.dueAt ? note.dueAt|date('Y-m-d\\TH:i') : '' }}"
                  data-note-owner="{{ (note.createdBy.email ?? '')|e('html_attr') }}"
                  data-note-can-edit="{{ isOwner ? '1' : '0' }}"
                  data-note-update-url="{{ isOwner ? path('app_note_update', { id: note.id }) : '' }}"
                  data-note-update-token="{{ isOwner ? csrf_token('update_note_' ~ note.id) : '' }}"
                >
                  <div class="note-card__top">
                    <span class="note-card__scope">
                      <i class="fa-solid {{ note.team ? 'fa-building' : 'fa-user-shield' }}" aria-hidden="true"></i>
                      <span>{{ note.team ? note.team.name : ('note.index.card.private'|trans) }}</span>
                    </span>
                    {% if isOwner %}
                      <form method="post" action="{{ path('app_note_delete', { id: note.id }) }}" data-action="submit->note-board#confirmDelete" data-confirm="{{ 'note.index.board.delete.confirm'|trans|e('html_attr') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_note_' ~ note.id) }}">
                        <button type="submit" class="notes-icon-action notes-icon-action--danger" title="{{ 'note.index.board.delete.title'|trans }}" aria-label="{{ 'note.index.board.delete.title'|trans }}"><i class="fa-regular fa-trash-can" aria-hidden="true"></i></button>
                      </form>
                    {% endif %}
                  </div>

                  <button type="button" class="note-card__open" data-action="click->note-board#openDetails" aria-label="{{ 'note.index.details.open'|trans }} — {{ note.title }}">
                    <h3 class="note-card__title">{{ note.title }}</h3>
                    {% if note.content %}
                      <p class="note-card__description">{{ note.content|u.truncate(180, '…') }}</p>
                    {% else %}
                      <p class="note-card__empty-copy">{{ 'note.index.card.empty_content'|trans }}</p>
                    {% endif %}
                  </button>

                  <div class="note-card__meta">
                    {% if note.dueAt %}
                      <span class="note-meta-chip {{ isOverdue ? 'note-meta-chip--danger' : (isDueSoon ? 'note-meta-chip--warning' : '') }}">
                        <i class="fa-regular fa-calendar" aria-hidden="true"></i>{% if isOverdue %}{{ 'note.index.card.overdue'|trans }} · {% endif %}{{ note.dueAt|date('d/m') }}
                      </span>
                    {% endif %}
                    {% if isAssignee %}<span class="note-meta-chip note-meta-chip--mine"><i class="fa-solid fa-user-check" aria-hidden="true"></i>{{ 'note.index.card.assigned_to_you'|trans }}</span>{% endif %}
                    {% if note.content %}<span class="note-meta-chip"><i class="fa-solid fa-align-left" aria-hidden="true"></i>{{ note.content|length }} {{ 'note.index.card.characters'|trans }}</span>{% endif %}
                  </div>

                  <div class="note-card__people">
                    <div class="note-avatars" aria-label="{{ 'note.index.board.table.assigned'|trans }}">
                      {% if note.assignments|length > 0 %}
                        {% for assignment in note.assignments|slice(0, 4) %}
                          {% if isOwner %}
                            <form method="post" action="{{ path('app_note_unassign', { id: note.id, userId: assignment.assignee.id }) }}">
                              <input type="hidden" name="_token" value="{{ csrf_token('unassign_note_' ~ note.id) }}">
                              <button type="submit" class="note-avatar note-avatar--removable" title="{{ 'note.index.board.assign.remove'|trans({ '%email%': assignment.assignee.email }) }}" aria-label="{{ 'note.index.board.assign.remove'|trans({ '%email%': assignment.assignee.email }) }}">
                                {% if assignment.assignee.avatar %}<img src="{{ asset('uploads/avatars/' ~ assignment.assignee.avatar) }}" alt="">{% else %}{{ assignment.assignee.email|first|upper }}{% endif %}
                              </button>
                            </form>
                          {% else %}
                            <span class="note-avatar" title="{{ assignment.assignee.email }}">
                              {% if assignment.assignee.avatar %}<img src="{{ asset('uploads/avatars/' ~ assignment.assignee.avatar) }}" alt="{{ assignment.assignee.email }}">{% else %}{{ assignment.assignee.email|first|upper }}{% endif %}
                            </span>
                          {% endif %}
                        {% endfor %}
                        {% if note.assignments|length > 4 %}<span class="note-avatar">+{{ note.assignments|length - 4 }}</span>{% endif %}
                      {% else %}
                        <span class="note-avatar note-avatar--empty">{{ 'note.index.board.badges.unassigned'|trans }}</span>
                      {% endif %}
                    </div>

                    <div class="note-card__controls">
                      {% if isOwner %}
                        <form method="post" action="{{ path('app_note_assign', { id: note.id }) }}">
                          <input type="hidden" name="_token" value="{{ csrf_token('assign_note_' ~ note.id) }}">
                          <select name="assignee_id" class="note-assign-select" data-action="change->note-board#submitSelect" aria-label="{{ 'note.index.board.assign.placeholder'|trans }}">
                            <option value="">{{ 'note.index.board.assign.placeholder'|trans }}</option>
                            {% if not team %}
                              {% if not note.isAssignedTo(app.user) %}<option value="{{ app.user.id }}">{{ 'note.index.board.assign.yourself'|trans }}</option>{% endif %}
                            {% else %}
                              {% for teamUser in teamUsers %}{% if not note.isAssignedTo(teamUser) %}<option value="{{ teamUser.id }}">{{ teamUser.email|split('@')[0] }}</option>{% endif %}{% endfor %}
                            {% endif %}
                          </select>
                        </form>
                      {% endif %}

                      <form method="post" action="{{ path('app_note_status', { id: note.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('status_note_' ~ note.id) }}">
                        <select name="status" class="note-status-select" data-action="change->note-board#submitSelect" aria-label="{{ 'note.index.board.table.status'|trans }}">
                          {% for value, statusConfigItem in statusConfig %}<option value="{{ value }}" {{ statusKey == value ? 'selected' : '' }}>{{ statusConfigItem.title }}</option>{% endfor %}
                        </select>
                      </form>
                    </div>
                  </div>
                </article>
              {% endfor %}

              <div class="notes-column-empty"><div><i class="fa-solid fa-wind" aria-hidden="true"></i><p>{{ 'note.index.board.empty_column'|trans }}</p></div></div>
            </div>
          </section>
        {% endfor %}
      </section>

      <div class="notes-no-results" data-note-board-target="noResults" hidden>
        <span class="notes-no-results__icon"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
        <h2>{{ 'note.index.empty.no_results_title'|trans }}</h2>
        <p>{{ 'note.index.empty.no_results_text'|trans }}</p>
        <button type="button" class="notes-secondary-action" data-action="click->note-board#resetFilters">{{ 'note.index.empty.reset'|trans }}</button>
      </div>
    {% else %}
      <div class="notes-no-results">
        <span class="notes-no-results__icon"><i class="fa-regular fa-note-sticky" aria-hidden="true"></i></span>
        <h2>{{ 'note.index.empty.first_title'|trans }}</h2>
        <p>{{ canCreateNote ? ('note.index.empty.first_text'|trans) : ('note.index.empty.member_text'|trans) }}</p>
        {% if canCreateNote %}<button type="button" class="notes-primary-action" data-action="click->note-board#openCreate"><i class="fa-solid fa-plus" aria-hidden="true"></i>{{ 'note.index.actions.new_note'|trans }}</button>{% endif %}
      </div>
    {% endif %}

    <dialog class="notes-dialog" data-note-board-target="detailsModal" data-action="click->note-board#closeOnBackdrop">
      <header class="notes-dialog__header">
        <div class="notes-dialog__heading"><span class="notes-dialog__eyebrow">{{ 'note.index.details.eyebrow'|trans }}</span><h2 class="notes-dialog__title" data-note-board-target="detailsTitle"></h2></div>
        <div class="notes-dialog__header-actions">
          <button type="button" class="notes-icon-action" data-note-board-target="editButton" data-action="click->note-board#enterEdit" aria-label="{{ 'note.index.details.edit'|trans }}"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i></button>
          <button type="button" class="notes-icon-action" data-action="click->note-board#closeDetails" aria-label="{{ 'note.index.details.close'|trans }}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </div>
      </header>
      <div class="notes-dialog__body">
        <div class="notes-dialog__view">
          <div class="notes-dialog__meta">
            <span class="note-meta-chip"><i class="fa-solid fa-bars-progress" aria-hidden="true"></i><span data-note-board-target="detailsStatus"></span></span>
            <span class="note-meta-chip"><i class="fa-regular fa-calendar" aria-hidden="true"></i><span data-note-board-target="detailsDue"></span></span>
            <span class="note-meta-chip"><i class="fa-regular fa-user" aria-hidden="true"></i><span data-note-board-target="detailsOwner"></span></span>
          </div>
          <div class="notes-dialog__content" data-note-board-target="detailsContent"></div>
        </div>

        <form class="notes-dialog__edit" data-note-board-target="editForm" data-action="submit->note-board#saveDetails" hidden>
          <div class="notes-form-field"><label for="note-edit-title">{{ 'note.form.title.label'|trans }}</label><input id="note-edit-title" type="text" maxlength="255" required data-note-board-target="editTitle"></div>
          <div class="notes-form-field"><label for="note-edit-content">{{ 'note.form.content.label'|trans }}</label><textarea id="note-edit-content" rows="8" maxlength="50000" data-note-board-target="editContent"></textarea></div>
          <div class="notes-form-field"><label for="note-edit-due">{{ 'note.form.due_at.label'|trans }}</label><input id="note-edit-due" type="datetime-local" data-note-board-target="editDue"></div>
        </form>
      </div>
      <footer class="notes-dialog__footer">
        <span class="notes-copy-feedback" data-note-board-target="copyFeedback editFeedback" role="status"></span>
        <div class="notes-dialog__view-actions">
          <button type="button" class="notes-secondary-action" data-note-board-target="copyButton" data-action="click->note-board#copyDetails"><i class="fa-regular fa-copy" aria-hidden="true"></i>{{ 'note.index.details.copy'|trans }}</button>
          <button type="button" class="notes-primary-action" data-action="click->note-board#closeDetails">{{ 'note.index.details.close'|trans }}</button>
        </div>
        <div class="notes-dialog__edit-actions" hidden>
          <button type="button" class="notes-secondary-action" data-action="click->note-board#cancelEdit">{{ 'note.index.modal.cancel'|trans }}</button>
          <button type="submit" class="notes-primary-action" data-note-board-target="saveButton" data-action="click->note-board#submitEdit"><i class="fa-solid fa-check" aria-hidden="true"></i>{{ 'note.index.details.save'|trans }}</button>
        </div>
      </footer>
    </dialog>

    {% if canCreateNote %}
      <dialog class="notes-dialog" data-note-board-target="createModal" data-action="click->note-board#closeOnBackdrop">
        {{ form_start(form, { attr: { class: 'notes-create-form' } }) }}
          <header class="notes-dialog__header">
            <div class="notes-dialog__heading"><span class="notes-dialog__eyebrow">{{ isPersonalWorkspace ? ('note.index.header.personal_workspace'|trans) : team.name }}</span><h2 class="notes-dialog__title">{{ 'note.index.modal.title'|trans }}</h2></div>
            <button type="button" class="notes-icon-action" data-action="click->note-board#closeCreate" aria-label="{{ 'note.index.modal.cancel'|trans }}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
          </header>
          <div class="notes-dialog__body">
            <div class="notes-form-grid">
              <div class="notes-form-field notes-form-field--wide">{{ form_label(form.title) }}{{ form_widget(form.title, { attr: { placeholder: ('note.form.title.placeholder'|trans) } }) }}<div class="notes-form-errors">{{ form_errors(form.title) }}</div></div>
              <div class="notes-form-field notes-form-field--wide">{{ form_label(form.content) }}{{ form_widget(form.content, { attr: { placeholder: ('note.form.content.placeholder'|trans) } }) }}<div class="notes-form-errors">{{ form_errors(form.content) }}</div></div>
              <div class="notes-form-field">{{ form_label(form.status) }}{{ form_widget(form.status) }}<div class="notes-form-errors">{{ form_errors(form.status) }}</div></div>
              <div class="notes-form-field">{{ form_label(form.dueAt) }}{{ form_widget(form.dueAt) }}<div class="notes-form-errors">{{ form_errors(form.dueAt) }}</div></div>
            </div>
            {{ form_rest(form) }}
          </div>
          <footer class="notes-dialog__footer">
            <span class="notes-copy-feedback"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{ 'note.index.modal.visibility_hint'|trans }}</span>
            <div>
              <button type="button" class="notes-secondary-action" data-action="click->note-board#closeCreate">{{ 'note.index.modal.cancel'|trans }}</button>
              <button type="submit" class="notes-primary-action"><i class="fa-solid fa-check" aria-hidden="true"></i>{{ 'note.index.modal.create'|trans }}</button>
            </div>
          </footer>
        {{ form_end(form, { render_rest: false }) }}
      </dialog>
    {% endif %}
  </div>
{% endblock %}
