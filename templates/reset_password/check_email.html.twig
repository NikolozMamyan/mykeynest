{% extends 'base_auth.html.twig' %}

{% block title %}{{ 'reset_password.check.meta_title'|trans }}{% endblock %}
{% block robots %}noindex,nofollow,noarchive{% endblock %}
{% block body_class %}reset-password-page{% endblock %}

{% block body %}
<main class="reset-password-main">
    <section class="reset-password-card reset-password-card--centered" aria-labelledby="reset-check-title">
        <header class="reset-password-header">
            <span class="reset-password-icon reset-password-icon--success" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m21 3-7.2 18-3.9-7.9L2 9.2 21 3Z"/><path d="m9.9 13.1 4.3-4.3"/></svg>
            </span>
            <span class="reset-password-eyebrow">{{ 'reset_password.common.eyebrow'|trans }}</span>
            <h1 id="reset-check-title">{{ 'reset_password.check.title'|trans }}</h1>
            <p>{{ 'reset_password.check.subtitle'|trans }}</p>
        </header>

        <div class="reset-password-expiry">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            {{ 'reset_password.check.expiry'|trans({
                '%duration%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')
            }) }}
        </div>

        <ol class="reset-password-steps">
            <li><span>1</span><p>{{ 'reset_password.check.step_1'|trans }}</p></li>
            <li><span>2</span><p>{{ 'reset_password.check.step_2'|trans }}</p></li>
            <li><span>3</span><p>{{ 'reset_password.check.step_3'|trans }}</p></li>
        </ol>

        <p class="reset-password-retry">
            {{ 'reset_password.check.not_received'|trans }}
            <a href="{{ path('app_forgot_password_request') }}">{{ 'reset_password.check.try_again'|trans }}</a>
        </p>

        <a class="reset-password-back" href="{{ path('show_login') }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5"/><path d="m10 7-5 5 5 5"/></svg>
            {{ 'reset_password.common.back_to_login'|trans }}
        </a>
    </section>
</main>
{% endblock %}
