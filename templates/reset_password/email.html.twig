{% extends 'emails/layout.html.twig' %}

{% block title %}{{ 'reset_password.email.subject'|trans }}{% endblock %}
{% block preheader %}{{ 'reset_password.email.preheader'|trans }}{% endblock %}
{% block eyebrow %}{{ 'reset_password.email.eyebrow'|trans }}{% endblock %}
{% block heading %}{{ 'reset_password.email.heading'|trans }}{% endblock %}

{% block content %}
  <p style="margin:0;">{{ 'reset_password.email.intro'|trans }}</p>
  <p style="margin:22px 0 0;padding:12px 14px;background:#fff8e7;border-left:3px solid #f59e0b;border-radius:4px;color:#80601f;font-size:12px;">{{ 'reset_password.email.expiry'|trans({ '%duration%': '<strong>' ~ (resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')) ~ '</strong>' })|raw }}</p>
{% endblock %}

{% block action %}
  {% include 'emails/_action.html.twig' with {actionUrl: url('app_reset_password', {token: resetToken.token}), label: 'reset_password.email.action'|trans} %}
{% endblock %}

{% block footer %}<p style="margin:0;">{{ 'reset_password.email.ignore'|trans }}</p>{% endblock %}
