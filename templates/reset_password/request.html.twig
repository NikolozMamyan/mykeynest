{% extends 'base_auth.html.twig' %}

{% block title %}{{ 'reset_password.request.meta_title'|trans }}{% endblock %}
{% block robots %}noindex,nofollow,noarchive{% endblock %}
{% block body_class %}reset-password-page{% endblock %}

{% block body %}
<main class="reset-password-main">
    <section class="reset-password-card" aria-labelledby="reset-request-title">
        <header class="reset-password-header">
            <span class="reset-password-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <span class="reset-password-eyebrow">{{ 'reset_password.common.eyebrow'|trans }}</span>
            <h1 id="reset-request-title">{{ 'reset_password.request.title'|trans }}</h1>
            <p>{{ 'reset_password.request.subtitle'|trans }}</p>
        </header>

        {% for flashError in app.flashes('reset_password_error') %}
            <div class="reset-password-alert reset-password-alert--danger" role="alert">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5"/><path d="M12 16.5h.01"/></svg>
                <span>{{ flashError }}</span>
            </div>
        {% endfor %}

        {{ form_start(requestForm, {
            attr: {
                class: 'reset-password-form',
                novalidate: 'novalidate'
            }
        }) }}
            {{ form_errors(requestForm) }}

            <div class="reset-password-field">
                {{ form_label(requestForm.email, 'reset_password.request.email_label') }}
                <div class="reset-password-input-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                    {{ form_widget(requestForm.email, {
                        attr: {
                            placeholder: 'reset_password.request.email_placeholder'|trans,
                            autofocus: 'autofocus'
                        }
                    }) }}
                </div>
                {{ form_errors(requestForm.email) }}
            </div>

            <button type="submit" class="reset-password-submit">
                <span>{{ 'reset_password.request.submit'|trans }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="m14 7 5 5-5 5"/></svg>
            </button>
        {{ form_end(requestForm) }}

        <div class="reset-password-note">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 2.8 8.1 7 10 4.2-1.9 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-5"/></svg>
            <p>{{ 'reset_password.request.privacy_note'|trans }}</p>
        </div>

        <a class="reset-password-back" href="{{ path('show_login') }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5"/><path d="m10 7-5 5 5 5"/></svg>
            {{ 'reset_password.common.back_to_login'|trans }}
        </a>
    </section>
</main>
{% endblock %}
