{% extends 'base_auth.html.twig' %}

{% block title %}{{ 'reset_password.reset.meta_title'|trans }}{% endblock %}
{% block robots %}noindex,nofollow,noarchive{% endblock %}
{% block body_class %}reset-password-page{% endblock %}

{% block body %}
<main class="reset-password-main">
    <section class="reset-password-card" aria-labelledby="reset-password-title">
        <header class="reset-password-header">
            <span class="reset-password-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="15" r="4"/><path d="m11 12 8-8"/><path d="m15 8 2 2"/><path d="m17 6 2 2"/></svg>
            </span>
            <span class="reset-password-eyebrow">{{ 'reset_password.common.eyebrow'|trans }}</span>
            <h1 id="reset-password-title">{{ 'reset_password.reset.title'|trans }}</h1>
            <p>{{ 'reset_password.reset.subtitle'|trans }}</p>
        </header>

        {{ form_start(resetForm, {
            attr: {
                class: 'reset-password-form',
                novalidate: 'novalidate'
            }
        }) }}
            {{ form_errors(resetForm) }}

            <div class="reset-password-field"
                 data-controller="password-strength"
                 data-password-strength-weak-value="{{ 'reset_password.reset.strength.weak'|trans }}"
                 data-password-strength-medium-value="{{ 'reset_password.reset.strength.medium'|trans }}"
                 data-password-strength-strong-value="{{ 'reset_password.reset.strength.strong'|trans }}"
                 data-password-strength-prefix-value="{{ 'reset_password.reset.strength.prefix'|trans }}">
                {{ form_label(resetForm.plainPassword.first, 'reset_password.reset.password_label') }}
                <div class="reset-password-input-wrap" data-controller="password-toggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                    {{ form_widget(resetForm.plainPassword.first, {
                        attr: {
                            placeholder: 'reset_password.reset.password_placeholder'|trans,
                            'data-password-toggle-target': 'input',
                            'data-password-strength-target': 'input',
                            'data-action': 'input->password-strength#check',
                            autofocus: 'autofocus'
                        }
                    }) }}
                    <button type="button"
                            class="reset-password-toggle"
                            data-action="click->password-toggle#toggle"
                            aria-label="{{ 'reset_password.reset.toggle_password'|trans }}">
                        <svg data-password-toggle-target="showIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                        <svg data-password-toggle-target="hideIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" hidden><path d="m3 3 18 18"/><path d="M10.6 6.1A9.7 9.7 0 0 1 12 6c6 0 9.5 6 9.5 6a16.8 16.8 0 0 1-2.1 2.8"/><path d="M6.2 6.2C3.8 8 2.5 12 2.5 12s3.5 6 9.5 6a9.8 9.8 0 0 0 3-.5"/></svg>
                    </button>
                </div>
                {{ form_errors(resetForm.plainPassword.first) }}

                <div class="reset-password-strength"
                     data-password-strength-target="container"
                     hidden>
                    <span class="reset-password-strength__track">
                        <span data-password-strength-target="progressBar"></span>
                    </span>
                    <small data-password-strength-target="feedback"></small>
                </div>
            </div>

            <div class="reset-password-field">
                {{ form_label(resetForm.plainPassword.second, 'reset_password.reset.confirm_label') }}
                <div class="reset-password-input-wrap" data-controller="password-toggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                    {{ form_widget(resetForm.plainPassword.second, {
                        attr: {
                            placeholder: 'reset_password.reset.confirm_placeholder'|trans,
                            'data-password-toggle-target': 'input'
                        }
                    }) }}
                    <button type="button"
                            class="reset-password-toggle"
                            data-action="click->password-toggle#toggle"
                            aria-label="{{ 'reset_password.reset.toggle_password'|trans }}">
                        <svg data-password-toggle-target="showIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                        <svg data-password-toggle-target="hideIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" hidden><path d="m3 3 18 18"/><path d="M10.6 6.1A9.7 9.7 0 0 1 12 6c6 0 9.5 6 9.5 6a16.8 16.8 0 0 1-2.1 2.8"/><path d="M6.2 6.2C3.8 8 2.5 12 2.5 12s3.5 6 9.5 6a9.8 9.8 0 0 0 3-.5"/></svg>
                    </button>
                </div>
                {{ form_errors(resetForm.plainPassword.second) }}
            </div>

            <ul class="reset-password-requirements" aria-label="{{ 'reset_password.reset.requirements_aria'|trans }}">
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 12 4 4 10-10"/></svg>{{ 'reset_password.reset.requirement_length'|trans }}</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 12 4 4 10-10"/></svg>{{ 'reset_password.reset.requirement_unique'|trans }}</li>
            </ul>

            <button type="submit" class="reset-password-submit">
                <span>{{ 'reset_password.reset.submit'|trans }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 12 4 4 10-10"/></svg>
            </button>
        {{ form_end(resetForm) }}

        <a class="reset-password-back" href="{{ path('show_login') }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5"/><path d="m10 7-5 5 5 5"/></svg>
            {{ 'reset_password.common.back_to_login'|trans }}
        </a>
    </section>
</main>
{% endblock %}
