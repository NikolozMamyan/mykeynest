<!DOCTYPE html>
{% set state = state|default('pending') %}
{% set poll = poll is defined ? poll : true %}
{% set messages = {} %}
{% for name in ['pending', 'approved', 'rejected', 'expired', 'missing', 'unavailable', 'completed', 'different_device'] %}
  {% set messages = messages|merge({ (name): {
    title: ('login_verification.' ~ name ~ '.title')|trans,
    status: ('login_verification.' ~ name ~ '.status')|trans,
    message: ('login_verification.' ~ name ~ '.message')|trans
  } }) %}
{% endfor %}
{% set messages = messages|merge({ finishing: 'login_verification.finishing'|trans, check: 'login_verification.check'|trans, retry: 'login_verification.retry'|trans }) %}
<html lang="{{ app.request.locale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta name="referrer" content="no-referrer">
  <meta name="theme-color" content="#f3f7f5">
  <title>{{ messages[state].title }} · MYKEYNEST</title>
  {% include 'components/parts/_theme_boot.html.twig' %}
  <link rel="icon" href="{{ asset('icon-192.png') }}">
  {{ importmap('public') }}
  <link rel="stylesheet" href="{{ asset('styles/pages/public-shell.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/pages/pending-login.css') }}">
</head>
<body class="public-page login-verification">
  {% include 'components/parts/_public_auth_header.html.twig' %}
  <main class="verification-wrapper">
    <section class="verification-card" data-controller="pending-login" data-state="{{ state }}"
      data-pending-login-poll-value="{{ poll ? 'true' : 'false' }}"
      data-pending-login-messages-value="{{ messages|json_encode|e('html_attr') }}" aria-labelledby="verification-title">
      <div class="verification-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 7 9 6 9-6"/></svg>
      </div>
      <h1 id="verification-title" data-pending-login-target="title">{{ messages[state].title }}</h1>
      <p class="verification-email" data-pending-login-target="email" hidden></p>
      <div class="verification-feedback" role="status" aria-live="polite" aria-atomic="true">
        <span class="verification-status" data-pending-login-target="status">{{ messages[state].status }}</span>
        <p data-pending-login-target="message">{{ messages[state].message }}</p>
      </div>
      <ol class="verification-steps" data-pending-login-target="steps" {{ state != 'pending' ? 'hidden' : '' }}>
        <li>{{ 'login_verification.step_email'|trans }}</li>
        <li>{{ 'login_verification.step_confirm'|trans }}</li>
        <li>{{ 'login_verification.step_return'|trans }}</li>
      </ol>
      <p class="verification-hint" data-pending-login-target="hint" {{ state != 'pending' ? 'hidden' : '' }}>{{ 'login_verification.spam'|trans }}</p>
      <div class="verification-actions">
        <button type="button" class="verification-button verification-button--primary" data-pending-login-target="retry" data-action="pending-login#checkStatus" {{ not poll ? 'hidden' : '' }}>{{ messages.check }}</button>
        <a class="verification-button" href="{{ path('show_login', { lang: app.request.locale }) }}">{{ 'login_verification.restart'|trans }}</a>
      </div>
      <noscript><p class="verification-hint">{{ 'login_verification.javascript'|trans }}</p></noscript>
    </section>
  </main>
</body>
</html>
