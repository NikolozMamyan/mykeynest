{% extends 'base.html.twig' %}

{% block title %}{{ 'subscription.page_title'|trans }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/pages/subscription.css') }}">
{% endblock %}

{% block body %}
{% set currentCode = currentPlan.code|default('free')|lower %}
{% set ownsSubscription = subscription and subscription.active %}
{% set stripeManaged = ownsSubscription and subscription.stripeSubscriptionId %}
{% set ownedPlan = ownsSubscription ? subscription.planCode|lower : null %}
{% set hasCompanyAccess = currentCode == 'team' and not ownsSubscription %}

<main class="subscription-shell">
  <header class="subscription-heading">
    <span class="subscription-eyebrow"><i class="fa-solid fa-sparkles"></i> {{ 'subscription.redesign.eyebrow'|trans }}</span>
    <h1>{{ 'subscription.redesign.title'|trans }}</h1>
    <p>{{ 'subscription.redesign.subtitle'|trans }}</p>
  </header>

  {% if currentCode != 'free' %}
    <section class="subscription-current {{ subscription and subscription.cancelAtPeriodEnd ? 'is-ending' : '' }}">
      <div class="subscription-current__icon"><i class="fa-solid {{ currentCode == 'team' ? 'fa-building-shield' : 'fa-crown' }}"></i></div>
      <div class="subscription-current__content">
        <span class="subscription-current__label">{{ hasCompanyAccess ? 'subscription.redesign.company_access'|trans : 'subscription.redesign.current_plan'|trans }}</span>
        <h2>MYKEYNEST {{ currentCode|upper }}</h2>
        {% if hasCompanyAccess %}
          <p>{{ 'subscription.redesign.company_access_help'|trans }}</p>
        {% elseif ownsSubscription and not stripeManaged %}
          <p><i class="fa-solid fa-user-shield"></i> {{ 'subscription.manage.admin_managed'|trans }}</p>
        {% elseif subscription.cancelAtPeriodEnd %}
          <p class="subscription-ending-message"><i class="fa-solid fa-calendar-xmark"></i> {{ 'subscription.manage.ends_on'|trans({'%date%': subscription.currentPeriodEnd ? subscription.currentPeriodEnd|date('d/m/Y') : '—'}) }}</p>
        {% else %}
          <p><i class="fa-regular fa-calendar-check"></i> {{ 'subscription.manage.renews_on'|trans({'%date%': subscription and subscription.currentPeriodEnd ? subscription.currentPeriodEnd|date('d/m/Y') : '—'}) }}</p>
        {% endif %}
      </div>

      {% if stripeManaged %}
        <div class="subscription-current__actions">
          <a href="{{ path('app_subscription_portal') }}" class="subscription-action secondary"><i class="fa-solid fa-receipt"></i> {{ 'subscription.manage.billing_portal'|trans }}</a>
          {% if subscription.cancelAtPeriodEnd %}
            <form method="post" action="{{ path('app_subscription_resume') }}">
              <input type="hidden" name="_token" value="{{ csrf_token('subscription_resume') }}">
              <button class="subscription-action primary" type="submit"><i class="fa-solid fa-rotate-left"></i> {{ 'subscription.manage.resume'|trans }}</button>
            </form>
          {% endif %}
        </div>
      {% elseif ownsSubscription %}
        <div class="subscription-current__actions">
          <span class="subscription-action is-static"><i class="fa-solid fa-user-shield"></i> {{ 'subscription.manage.admin_managed'|trans }}</span>
        </div>
      {% endif %}
    </section>
  {% endif %}

  <section class="subscription-offers" aria-labelledby="subscriptionOffersTitle">
    <div class="subscription-offers__heading">
      <div><span>{{ 'subscription.redesign.offers_eyebrow'|trans }}</span><h2 id="subscriptionOffersTitle">{{ 'subscription.redesign.offers_title'|trans }}</h2></div>
      <p><i class="fa-solid fa-calendar-days"></i> {{ 'subscription.redesign.monthly_billing'|trans }}</p>
    </div>

    <div class="subscription-plan-grid">
      <article class="subscription-plan-card is-pro {{ ownedPlan == 'pro' ? 'is-current' : '' }}">
        <div class="subscription-plan-card__top">
          <span class="subscription-plan-kicker">{{ 'landing.pricing.showcase.pro.eyebrow'|trans }}</span>
          {% if ownedPlan == 'pro' %}<span class="subscription-plan-state">{{ 'subscription.redesign.active_badge'|trans }}</span>{% endif %}
          <h3>PRO</h3>
          <p>{{ 'landing.pricing.showcase.pro.target'|trans }}</p>
          <div class="subscription-plan-price"><strong>6,99€</strong><span>{{ 'landing.pricing.showcase.per_user_month'|trans }}</span></div>
          {% if ownedPlan == 'pro' %}
            <button class="subscription-plan-cta is-disabled" type="button" disabled>{{ 'subscription.redesign.current_offer'|trans }}</button>
          {% elseif ownedPlan == 'team' and stripeManaged %}
            <a class="subscription-plan-cta is-secondary" href="{{ path('app_subscription_portal') }}">{{ 'subscription.manage.change_to_pro'|trans }}</a>
            <small class="subscription-plan-note">{{ 'subscription.manage.downgrade_note'|trans }}</small>
          {% elseif ownedPlan == 'team' %}
            <button class="subscription-plan-cta is-disabled" type="button" disabled>{{ 'subscription.manage.admin_managed'|trans }}</button>
          {% elseif currentCode == 'team' %}
            <button class="subscription-plan-cta is-disabled" type="button" disabled>{{ 'subscription.redesign.included_in_team'|trans }}</button>
          {% else %}
            <a class="subscription-plan-cta" href="{{ path('app_subscription_checkout_pro') }}">{{ 'subscription.plans.pro.cta_upgrade'|trans }}</a>
          {% endif %}
        </div>
        <div class="subscription-plan-included"><i class="fa-regular fa-user"></i> {{ 'landing.pricing.showcase.pro.included'|trans }}</div>
        <ul>
          <li><i class="fa-solid fa-check"></i><span>{{ 'subscription.plans.limits.credentials_unlimited'|trans }}</span></li>
          <li><i class="fa-solid fa-check"></i><span>{{ 'subscription.plans.limits.shares_unlimited'|trans }}</span></li>
          <li><i class="fa-solid fa-check"></i><span>{{ 'subscription.plans.features.all_tools'|trans }}</span></li>
          <li><i class="fa-solid fa-check"></i><span>{{ 'landing.pricing.showcase.pro.support'|trans }}</span></li>
        </ul>
      </article>

      <article class="subscription-plan-card is-team {{ currentCode == 'team' ? 'is-current' : '' }}">
        <div class="subscription-plan-card__top">
          <span class="subscription-plan-kicker">{{ 'landing.pricing.showcase.team.eyebrow'|trans }}</span>
          {% if currentCode == 'team' %}<span class="subscription-plan-state">{{ hasCompanyAccess ? 'subscription.redesign.company_badge'|trans : 'subscription.redesign.active_badge'|trans }}</span>{% endif %}
          <h3>TEAM</h3>
          <p>{{ 'landing.pricing.showcase.team.target'|trans }}</p>
          <div class="subscription-plan-price"><strong>5,49€</strong><span>{{ 'landing.pricing.showcase.per_user_month'|trans }}</span></div>
          {% if ownedPlan == 'pro' and stripeManaged %}
            <form class="subscription-upgrade-form" method="post" action="{{ path('app_subscription_upgrade_team') }}" onsubmit="return confirm('{{ 'subscription.manage.upgrade_confirm'|trans|e('js') }}');">
              <input type="hidden" name="_token" value="{{ csrf_token('subscription_upgrade_team') }}">
              <label for="teamUpgradeQuantity">{{ 'subscription.manage.team_seats'|trans }}</label>
              <div>
                <input id="teamUpgradeQuantity" type="number" name="quantity" min="{{ teamMinimumSeats }}" max="{{ teamMaximumSeats }}" value="{{ teamMinimumSeats }}" required>
                <button class="subscription-plan-cta" type="submit">{{ 'subscription.manage.upgrade_team'|trans }}</button>
              </div>
              <small><i class="fa-solid fa-bolt"></i> {{ 'subscription.manage.upgrade_proration'|trans }}</small>
            </form>
          {% elseif ownedPlan == 'pro' %}
            <button class="subscription-plan-cta is-disabled" type="button" disabled>{{ 'subscription.manage.admin_managed'|trans }}</button>
          {% elseif currentCode == 'team' %}
            <button class="subscription-plan-cta is-disabled" type="button" disabled>{{ 'subscription.redesign.current_offer'|trans }}</button>
          {% else %}
            <a class="subscription-plan-cta" href="{{ path('app_subscription_checkout_team') }}">{{ 'subscription.plans.team.cta_upgrade'|trans }}</a>
          {% endif %}
        </div>
        <div class="subscription-plan-included"><i class="fa-solid fa-users"></i> {{ 'landing.pricing.showcase.team.included'|trans }}</div>
        <ul>
          <li><i class="fa-solid fa-check"></i><span>{{ 'subscription.plans.limits.credentials_unlimited'|trans }}</span></li>
          <li><i class="fa-solid fa-check"></i><span>{{ 'subscription.plans.limits.shares_unlimited'|trans }}</span></li>
          <li><i class="fa-solid fa-check"></i><span>{{ 'subscription.plans.team.centralized_admin'|trans }}</span></li>
          <li><i class="fa-solid fa-check"></i><span>{{ 'subscription.plans.limits.extension_installations_unlimited'|trans }}</span></li>
        </ul>
      </article>
    </div>
  </section>

  <div class="subscription-security-note"><i class="fa-brands fa-stripe"></i><span>{{ 'subscription.redesign.stripe_note'|trans }}</span></div>
</main>
{% endblock %}
