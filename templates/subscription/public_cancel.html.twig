{% extends 'base_auth.html.twig' %}

{% block title %}Paiement annule | MYKEYNEST{% endblock %}

{% block body %}
<section class="public-status-page">
  <div class="public-status-card">
    <div class="public-status-icon public-status-icon--cancel">
      <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
    </div>
    <h1>Paiement annule</h1>
    <p>Aucun paiement n a ete finalise. Vous pouvez relancer le checkout {{ plan|upper }} quand vous voulez.</p>
    <div class="public-status-actions">
      <a href="{{ path(retryRoute) }}" class="btn btn-primary">Reessayer</a>
      <a href="{{ path('app_landing') }}#pricing" class="btn btn-outline">Retour au pricing</a>
    </div>
  </div>
</section>
{% endblock %}
