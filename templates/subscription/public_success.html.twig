{% extends 'base_auth.html.twig' %}

{% block title %}Paiement confirme | MYKEYNEST{% endblock %}

{% block body %}
<section class="public-status-page">
  <div class="public-status-card">
    <div class="public-status-icon">
      <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
    </div>
    <h1>Paiement confirme</h1>
    <p>Votre abonnement {{ plan|upper }} {{ synchronized ? 'est actif' : 'est en cours d activation' }}. Si vous venez de payer sans compte existant, un email vient de vous etre envoye pour definir votre mot de passe.</p>
    <p>Si vous aviez deja un compte, vous recevrez un email de confirmation et vous pouvez vous reconnecter normalement.</p>
    <div class="public-status-actions">
      <a href="{{ path('show_login') }}" class="btn btn-primary">Se connecter</a>
      <a href="{{ path('app_landing') }}" class="btn btn-outline">Retour au site</a>
    </div>
  </div>
</section>
{% endblock %}
