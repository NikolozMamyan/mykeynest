{% macro member_row(member) %}
    <div class="tc-member" data-team-create-target="memberRow" data-index="{{ member.vars.name }}">
        <span class="tc-member-avatar" aria-hidden="true"><i class="fa-regular fa-user"></i></span>
        <div class="tc-member-email">
            {{ form_label(member.email, null, {label_attr: {class: 'tc-sr-only'}}) }}
            {{ form_widget(member.email, {attr: {class: 'tc-input', 'data-action': 'input->team-create#sync', autocomplete: 'off'}}) }}
            {{ form_errors(member.email) }}
        </div>
        <div class="tc-member-role">
            {{ form_label(member.role, null, {label_attr: {class: 'tc-sr-only'}}) }}
            {{ form_widget(member.role, {attr: {class: 'tc-select', 'data-action': 'change->team-create#sync'}}) }}
            {{ form_errors(member.role) }}
        </div>
        <button type="button" class="tc-icon-button" data-action="team-create#removeMember" aria-label="{{ 'teams.wizard.remove'|trans }}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
{% endmacro %}

{% macro automatic_members(emails, ownerEmail, currentUserEmail) %}
    {% for email in emails %}
        <div class="tc-auto-member">
            <span class="tc-member-avatar" aria-hidden="true"><i class="fa-solid {{ email == ownerEmail ? 'fa-crown' : 'fa-user-shield' }}"></i></span>
            <div>
                <strong>{{ (email == ownerEmail ? 'teams.wizard.owner' : 'teams.show.members.add.role_admin')|trans }}{% if email == currentUserEmail %}<span class="tc-you">{{ 'teams.wizard.you'|trans }}</span>{% endif %}</strong>
                <small>{{ email }}</small>
            </div>
        </div>
    {% endfor %}
{% endmacro %}

{% import _self as fields %}
{% set messages = {} %}
{% for key in ['invalid_email', 'duplicate_email', 'selected_count', 'empty_name', 'no_members', 'no_credentials', 'remove', 'restricted_title', 'reveal_title', 'creating'] %}
    {% set messages = messages|merge({(key): ('teams.wizard.' ~ key)|trans}) %}
{% endfor %}
{% set initialStep = form.credentials.vars.errors|length or form.canRevealPassword.vars.errors|length ? 1 : 0 %}

{{ form_start(form, {attr: {
    class: 'tc-form',
    'data-controller': 'team-create',
    'data-action': 'submit->team-create#submit',
    'data-turbo': 'false',
    'data-team-create-messages-value': messages|json_encode,
    'data-team-create-automatic-members-value': automaticMembers|json_encode,
    'data-team-create-step-value': initialStep
}}) }}
    <ol class="tc-steps" aria-label="{{ 'teams.wizard.steps_label'|trans }}">
        {% for key in ['people', 'access', 'review'] %}
            <li data-team-create-target="stepItem">
                <button type="button" data-action="team-create#goToStep" data-step="{{ loop.index0 }}" aria-controls="tc-step-{{ loop.index0 }}">
                    <span class="tc-step-number">{{ loop.index }}</span>
                    <span><strong>{{ ('teams.wizard.step_' ~ key)|trans }}</strong><small>{{ ('teams.wizard.step_' ~ key ~ '_hint')|trans }}</small></span>
                </button>
            </li>
        {% endfor %}
    </ol>

    <div class="tc-workspace">
        <div class="tc-card">
            {% if form.vars.errors|length %}<div class="tc-errors" role="alert">{{ form_errors(form) }}</div>{% endif %}

            <section class="tc-panel" id="tc-step-0" data-team-create-target="panel" aria-labelledby="tc-title-0">
                <div class="tc-panel-heading"><span class="tc-section-icon"><i class="fa-solid fa-user-group" aria-hidden="true"></i></span><div><h2 id="tc-title-0" tabindex="-1">{{ 'teams.wizard.people_title'|trans }}</h2><p>{{ 'teams.wizard.people_help'|trans }}</p></div></div>
                <div class="tc-identity">
                  <div class="tc-field">
                    {{ form_label(form.name, null, {label_attr: {class: 'tc-label'}}) }}
                    {{ form_widget(form.name, {attr: {class: 'tc-input tc-name', placeholder: 'teams.new.form.name_placeholder'|trans, 'data-team-create-target': 'name', 'data-action': 'input->team-create#sync', autocomplete: 'off'}}) }}
                    {{ form_errors(form.name) }}
                  </div>
                  <div class="tc-automatic-members">{{ fields.automatic_members(automaticMembers, teamOwnerEmail, currentUserEmail) }}</div>
                </div>

                <div class="tc-section-label"><h3>{{ 'teams.wizard.members_title'|trans }}</h3><span class="tc-badge" data-team-create-target="memberCount">0</span></div>

                <div class="tc-member-editor">
                    <label class="tc-sr-only" for="tc-email">{{ 'teams.wizard.email_label'|trans }}</label>
                    <div class="tc-add-row">
                        <input id="tc-email" class="tc-input" type="text" inputmode="email" autocomplete="off" placeholder="{{ 'teams.wizard.email_placeholder'|trans }}" data-team-create-target="emailInput" data-action="keydown->team-create#emailKeydown">
                        <button class="tc-button tc-button-secondary" type="button" data-action="team-create#addMembers"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{ 'teams.wizard.add'|trans }}</button>
                    </div>
                    <button class="tc-text-button" type="button" data-action="team-create#toggleBulk" aria-expanded="false" aria-controls="tc-bulk"><i class="fa-regular fa-copy" aria-hidden="true"></i> {{ 'teams.wizard.bulk_toggle'|trans }}</button>
                    <div id="tc-bulk" class="tc-bulk" data-team-create-target="bulkPanel" hidden>
                        <label class="tc-label" for="tc-bulk-emails">{{ 'teams.wizard.bulk_label'|trans }}</label>
                        <textarea id="tc-bulk-emails" class="tc-input" rows="3" placeholder="{{ 'teams.wizard.bulk_placeholder'|trans }}" data-team-create-target="bulkInput"></textarea>
                        <p class="tc-help">{{ 'teams.wizard.bulk_help'|trans }}</p>
                        <button class="tc-button tc-button-secondary" type="button" data-action="team-create#addBulk"><i class="fa-solid fa-users" aria-hidden="true"></i> {{ 'teams.wizard.bulk_add'|trans }}</button>
                    </div>
                    <p class="tc-inline-error" data-team-create-target="memberFeedback" role="alert" hidden></p>
                </div>

                <div class="tc-members" data-team-create-target="members" data-prototype="{{ fields.member_row(form.members.vars.prototype)|e('html_attr') }}">
                    {% for member in form.members %}{{ fields.member_row(member) }}{% endfor %}
                </div>
                {% do form.members.setRendered %}
                {{ form_errors(form.members) }}
                <div class="tc-empty-members" data-team-create-target="emptyMembers"><i class="fa-regular fa-paper-plane" aria-hidden="true"></i><span>{{ 'teams.wizard.members_empty'|trans }}</span></div>
                <details class="tc-details">
                    <summary><i class="fa-regular fa-circle-question" aria-hidden="true"></i> {{ 'teams.wizard.invitation_details'|trans }} <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
                    <p class="tc-footnote">{{ 'teams.wizard.members_help'|trans }}</p>
                    <p class="tc-footnote">{{ 'teams.wizard.invitation_help'|trans }}</p>
                    <p class="tc-footnote">{{ 'teams.wizard.license_help'|trans }}</p>
                </details>
            </section>

            <section class="tc-panel" id="tc-step-1" data-team-create-target="panel" aria-labelledby="tc-title-1">
                <div class="tc-panel-heading"><span class="tc-section-icon"><i class="fa-solid fa-key" aria-hidden="true"></i></span><div><h2 id="tc-title-1" tabindex="-1">{{ 'teams.wizard.access_title'|trans }}</h2><p>{{ 'teams.wizard.access_help'|trans }}</p></div></div>
                <div class="tc-permission">
                    <label class="tc-switch-label" for="{{ form.canRevealPassword.vars.id }}">
                        <span class="tc-permission-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
                        <span><strong>{{ 'teams.wizard.reveal_toggle'|trans }}</strong><small>{{ 'teams.wizard.reveal_toggle_help'|trans }}</small></span>
                        {{ form_widget(form.canRevealPassword, {attr: {class: 'tc-switch', 'data-team-create-target': 'reveal', 'data-action': 'change->team-create#sync'}}) }}
                    </label>
                    {{ form_errors(form.canRevealPassword) }}
                </div>

                <div class="tc-section-label"><h3>{{ 'teams.wizard.credentials_title'|trans }}</h3><span class="tc-badge" data-team-create-target="selectionCount" aria-live="polite"></span></div>
                {% if form.credentials|length %}
                  <div class="tc-picker-toolbar">
                    <div class="tc-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input class="tc-input" type="search" aria-label="{{ 'teams.wizard.search'|trans }}" placeholder="{{ 'teams.wizard.search'|trans }}" data-team-create-target="search" data-action="input->team-create#filterCredentials"></div>
                    <div class="tc-selection-tools"><button type="button" class="tc-text-button" data-action="team-create#selectAll">{{ 'teams.wizard.select_all'|trans }}</button><button type="button" class="tc-text-button" data-action="team-create#clearSelection">{{ 'teams.wizard.clear_selection'|trans }}</button></div>
                  </div>
                    <div class="tc-credentials">
                        {% for key, choice in form.credentials %}
                            {% set credential = form.credentials.vars.choices[key].data %}
                            <label class="tc-credential" for="{{ choice.vars.id }}" data-team-create-target="credential" data-name="{{ credential.name }}" data-search="{{ (credential.name ~ ' ' ~ credential.domain ~ ' ' ~ credential.username)|lower }}">
                                <span class="tc-credential-avatar" aria-hidden="true">
                                    <span class="tc-favicon-letter">{{ credential.name|slice(0, 1)|upper }}</span>
                                    {% if credential.domain is not empty and '.' in credential.domain and ' ' not in credential.domain %}
                                        <img src="https://www.google.com/s2/favicons?domain={{ credential.domain|url_encode }}&amp;sz=64" alt="" width="28" height="28" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-team-create-target="favicon" data-action="load->team-create#faviconLoaded error->team-create#faviconError">
                                    {% endif %}
                                </span>
                                <span class="tc-credential-info"><strong>{{ credential.name }}</strong><small>{{ credential.domain }}</small></span>
                                {{ form_widget(choice, {attr: {'data-action': 'change->team-create#sync'}}) }}
                                <span class="tc-credential-account"><i class="fa-regular fa-user" aria-hidden="true"></i><span>{{ credential.username }}</span></span>
                            </label>
                        {% endfor %}
                    </div>
                    <div class="tc-empty-members" data-team-create-target="noResults" hidden><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><span>{{ 'teams.wizard.no_results'|trans }}</span></div>
                {% else %}
                    <div class="tc-empty-catalog"><span class="tc-section-icon"><i class="fa-solid fa-key" aria-hidden="true"></i></span><h3>{{ 'teams.wizard.catalog_empty'|trans }}</h3><p>{{ 'teams.wizard.catalog_help'|trans }}</p></div>
                {% endif %}
                {% do form.credentials.setRendered %}
                {{ form_errors(form.credentials) }}
                {# <p class="tc-footnote"><i class="fa-solid fa-sliders" aria-hidden="true"></i> {{ 'teams.wizard.access_later'|trans }}</p> #}
            </section>

            <section class="tc-panel" id="tc-step-2" data-team-create-target="panel" aria-labelledby="tc-title-2">
                <div class="tc-panel-heading"><span class="tc-section-icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span><div><h2 id="tc-title-2" tabindex="-1">{{ 'teams.wizard.review_title'|trans }}</h2><p>{{ 'teams.wizard.review_help'|trans }}</p></div></div>
                <div class="tc-review-name"><span class="tc-preview-avatar" data-team-create-target="initials" aria-hidden="true">G</span><div><small>{{ 'teams.form.name_label'|trans }}</small><h3 data-team-create-target="previewName"></h3></div><button class="tc-text-button" type="button" data-step="0" data-action="team-create#goToStep">{{ 'teams.wizard.edit'|trans }}</button></div>
                <div class="tc-review-grid">
                <div class="tc-review-section"><div class="tc-section-label"><h3>{{ 'teams.wizard.members_title'|trans }}</h3><button class="tc-text-button" type="button" data-step="0" data-action="team-create#goToStep">{{ 'teams.wizard.edit'|trans }}</button></div>{{ fields.automatic_members(automaticMembers, teamOwnerEmail, currentUserEmail) }}<ul class="tc-review-members" data-team-create-target="reviewMembers"></ul></div>
                <div class="tc-review-section"><div class="tc-section-label"><h3>{{ 'teams.wizard.credentials_title'|trans }}</h3><button class="tc-text-button" type="button" data-step="1" data-action="team-create#goToStep">{{ 'teams.wizard.edit'|trans }}</button></div><div class="tc-review-credentials" data-team-create-target="reviewCredentials"></div></div>
                </div>
                <div class="tc-review-permission"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><strong data-team-create-target="permissionText">{{ 'teams.wizard.restricted_title'|trans }}</strong></div>
            </section>

            <footer class="tc-footer">
                <button type="button" class="tc-button tc-button-secondary" data-team-create-target="previous" data-action="team-create#previous" hidden><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> {{ 'teams.wizard.previous'|trans }}</button>
                <span class="tc-footer-note"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{ 'teams.wizard.footer_note'|trans }}</span>
                <button type="button" class="tc-button tc-button-primary" data-team-create-target="next" data-action="team-create#next" hidden>{{ 'teams.wizard.next'|trans }} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                <button type="submit" class="tc-button tc-button-primary" data-team-create-target="submit"><i class="fa-solid fa-check" aria-hidden="true"></i> {{ 'teams.new.form.submit_create_team'|trans }}</button>
            </footer>
        </div>

    </div>
{{ form_end(form) }}
