{% extends 'base.html.twig' %}

{% block title %}{{ 'teams.page_title'|trans }}{% endblock %}

{% block body %}
{% set currentPlanCode = currentPlan.code|default('free') %}
<div class="teams-container">
    <div class="page-header">
        <div class="header-content">
            <div class="header-title">
                <svg class="header-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                <h1>{{ 'teams.header.title'|trans }}</h1>
            </div>
            <p class="header-subtitle">
                {{ (organization and organization.active ? 'teams.header.subtitle_team' : 'teams.header.subtitle_personal')|trans }}
            </p>
        </div>

        {% if canCreateTeam %}
            <a href="{{ path('app_team_new') }}" class="btn-primary-action">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 4v16m8-8H4"/>
                </svg>
                {{ 'teams.header.new_team'|trans }}
            </a>
        {% else %}
            <div class="btn-primary-action btn-disabled" title="{{ 'teams.header.limit_hint'|trans }}">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                {{ 'teams.header.new_team'|trans }}
            </div>
        {% endif %}
    </div>

    {% if organization and seatSummary %}
        {% set seatPercent = seatSummary.purchased > 0 ? ((seatSummary.used / seatSummary.purchased) * 100)|round : 100 %}
        <section class="company-hub {{ organization.active ? '' : 'is-suspended' }}">
            <header class="company-hub__header">
                <div class="company-workspace-icon"><i class="fa-solid fa-building-shield"></i></div>
                <div class="company-hub__identity">
                    <span class="company-workspace-eyebrow">{{ 'teams.organization.eyebrow'|trans }}</span>
                    <h2>{{ 'teams.organization.title'|trans({'%name%': organization.name}) }}</h2>
                    <p>{{ 'teams.organization.workspace_note'|trans }}</p>
                </div>
                <span class="company-workspace-status {{ organization.active ? 'is-active' : 'is-suspended' }}">
                    <i class="fa-solid fa-circle"></i> {{ (organization.active ? 'teams.organization.active' : 'teams.organization.suspended')|trans }}
                </span>
            </header>

            <div class="company-license-overview">
                <div class="company-license-overview__top">
                    <div class="company-license-overview__identity">
                        <span class="company-license-overview__icon"><i class="fa-solid fa-ticket"></i></span>
                        <div>
                            <strong>{{ 'teams.organization.capacity_title'|trans }}</strong>
                            <span>{{ 'teams.organization.used'|trans({'%used%': seatSummary.used, '%purchased%': seatSummary.purchased}) }}</span>
                        </div>
                    </div>
                    <span class="company-license-available {{ seatSummary.available == 0 ? 'is-empty' : '' }}">
                        {{ 'teams.organization.available_seats'|trans({'%count%': seatSummary.available}) }}
                    </span>
                </div>
                <div class="company-seat-progress" role="progressbar" aria-valuemin="0" aria-valuemax="{{ seatSummary.purchased }}" aria-valuenow="{{ seatSummary.used }}"><span style="width: {{ seatPercent > 100 ? 100 : seatPercent }}%"></span></div>
                <div class="company-license-overview__meta">
                    <span><i class="fa-solid fa-circle-check"></i> {{ 'teams.organization.active_members'|trans({'%count%': seatSummary.active}) }}</span>
                    <span><i class="fa-regular fa-clock"></i> {{ 'teams.organization.pending_members'|trans({'%count%': seatSummary.pending}) }}</span>
                    <span><i class="fa-solid fa-user-tag"></i> {{ 'teams.organization.guests'|trans({'%used%': seatSummary.guests, '%limit%': seatSummary.guestLimit}) }}</span>
                </div>
                {% if seatSummary.overCapacity %}<p class="company-seat-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{ 'teams.organization.over_capacity'|trans }}</p>{% endif %}
            </div>

            <div class="company-hub__body {{ canManageOrganization ? '' : 'is-member-view' }}">
                <section class="company-directory">
                    <div class="company-panel-heading">
                        <div><span>{{ 'teams.organization.directory_eyebrow'|trans }}</span><h3>{{ 'teams.organization.members_title'|trans }}</h3></div>
                        <small>{{ organization.members|length }}</small>
                    </div>
                    <div class="company-members-list">
                        {% for member in organization.members %}
                            {% set roleKey = 'teams.organization.role_' ~ member.role.value|lower %}
                            {% set statusKey = 'teams.organization.member_status_' ~ member.status.value|lower %}
                            <div class="company-member-row">
                                <span class="company-member-avatar">{{ member.user.email|slice(0, 1)|upper }}</span>
                                <span class="company-member-identity">
                                    <strong>{{ member.user.email }}</strong>
                                    <small><span class="member-status-dot is-{{ member.status.value|lower }}"></span>{{ statusKey|trans }}</small>
                                </span>
                                {% if organization.owner and app.user and organization.owner.id == app.user.id and member.role.value in ['ADMIN', 'MEMBER'] %}
                                    <form class="company-member-role" method="post" action="{{ path('app_team_company_member_role', {id: member.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('update_company_role_' ~ member.id) }}">
                                        <label class="sr-only" for="company-role-{{ member.id }}">{{ 'teams.organization.role_label'|trans }}</label>
                                        <select id="company-role-{{ member.id }}" name="role" onchange="this.form.requestSubmit()">
                                            <option value="MEMBER" {{ member.role.value == 'MEMBER' ? 'selected' : '' }}>{{ 'teams.organization.role_member'|trans }}</option>
                                            <option value="ADMIN" {{ member.role.value == 'ADMIN' ? 'selected' : '' }}>{{ 'teams.organization.role_admin'|trans }}</option>
                                        </select>
                                    </form>
                                {% else %}
                                    <span class="company-role-label">{{ roleKey|trans }}</span>
                                {% endif %}
                                {% if canManageOrganization and member.role.value != 'OWNER' %}
                                    <form method="post" action="{{ path('app_team_company_member_remove', {id: member.id}) }}" onsubmit="return confirm('{{ 'teams.organization.remove_confirm'|trans|e('js') }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('remove_company_member_' ~ member.id) }}">
                                        <button class="company-member-remove" type="submit" title="{{ 'teams.organization.remove'|trans }}" aria-label="{{ 'teams.organization.remove'|trans }}"><i class="fa-solid fa-user-minus"></i></button>
                                    </form>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </section>

                {% if canManageOrganization %}
                    <aside class="company-actions">
                        {% if organizationInviteForm %}
                            <div class="company-action-card">
                                <div class="company-action-card__icon"><i class="fa-solid fa-user-plus"></i></div>
                                <h3>{{ 'teams.organization.invite_card_title'|trans }}</h3>
                                {% if seatSummary.available > 0 %}
                                    <p>{{ 'teams.organization.invite.description'|trans }}</p>
                                    <div class="company-license-auto-note">
                                        <i class="fa-solid fa-ticket" aria-hidden="true"></i>
                                        <span>{{ 'teams.organization.invite.auto_license'|trans }}</span>
                                    </div>
                                    {{ form_start(organizationInviteForm, {'attr': {'class': 'company-invite-form'}}) }}
                                        <div class="company-invite-field">
                                            {{ form_label(organizationInviteForm.email, null, {'label_attr': {'class': 'sr-only'}}) }}
                                            {{ form_widget(organizationInviteForm.email, {'attr': {'placeholder': 'teams.organization.invite.email_placeholder'|trans, 'autocomplete': 'email'}}) }}
                                            {{ form_errors(organizationInviteForm.email) }}
                                        </div>
                                        <button type="submit"><i class="fa-solid fa-paper-plane"></i> {{ 'teams.organization.invite.submit'|trans }}</button>
                                    {{ form_end(organizationInviteForm) }}
                                    <small class="company-role-help">{{ 'teams.organization.invite.role_after_invite'|trans }}</small>
                                {% else %}
                                    <p>{{ 'teams.organization.invite.no_license'|trans }}</p>
                                    {% if organization.owner and app.user and organization.owner.id == app.user.id and seatSummary.purchased < seatMaximum %}
                                        <form class="company-quick-license-form" method="post" action="{{ path('app_team_company_seats_update') }}" onsubmit="return confirm('{{ 'teams.organization.add_license_confirm'|trans|e('js') }}');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('update_company_seats_' ~ organization.id) }}">
                                            <input type="hidden" name="quantity" value="{{ seatSummary.purchased + 1 }}">
                                            <button type="submit"><i class="fa-solid fa-plus"></i> {{ 'teams.organization.add_one_license'|trans }}</button>
                                        </form>
                                    {% elseif seatSummary.purchased >= seatMaximum %}
                                        <small class="company-role-help">{{ 'teams.organization.maximum_reached'|trans({'%maximum%': seatMaximum}) }}</small>
                                    {% else %}
                                        <small class="company-role-help">{{ 'teams.organization.ask_owner_license'|trans }}</small>
                                    {% endif %}
                                {% endif %}
                            </div>
                        {% endif %}

                        {% if organization.owner and app.user and organization.owner.id == app.user.id and organization.active %}
                            <details class="company-license-settings">
                                <summary>
                                    <span><i class="fa-solid fa-sliders"></i> {{ 'teams.organization.billing_title'|trans }}</span>
                                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                                </summary>
                                <form class="company-seat-form" method="post" action="{{ path('app_team_company_seats_update') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('update_company_seats_' ~ organization.id) }}">
                                    <div><label for="company-seat-quantity">{{ 'teams.organization.billing_quantity'|trans }}</label><small>{{ 'teams.organization.billing_help'|trans }}</small></div>
                                    <div class="company-seat-form__controls">
                                        <input id="company-seat-quantity" type="number" name="quantity" min="{{ seatSummary.used > seatMinimum ? seatSummary.used : seatMinimum }}" max="{{ seatMaximum }}" value="{{ seatSummary.purchased }}" required>
                                        <button type="submit">{{ 'teams.organization.billing_submit'|trans }}</button>
                                    </div>
                                </form>
                            </details>
                        {% endif %}
                    </aside>
                {% else %}
                    <aside class="company-action-card company-member-access-card"><div class="company-action-card__icon"><i class="fa-solid fa-id-badge"></i></div><h3>{{ 'teams.organization.member_access_title'|trans }}</h3><p>{{ 'teams.organization.member_access_help'|trans }}</p></aside>
                {% endif %}
            </div>
        </section>
    {% elseif not organization %}
        <section class="enterprise-plan-card is-{{ currentPlanCode }}">
            <div class="enterprise-plan-card__icon">
                <i class="{{ currentPlanCode == 'team' ? 'fa-solid fa-spinner fa-spin' : 'fa-solid fa-building-shield' }}"></i>
            </div>
            <div class="enterprise-plan-card__content">
                <span class="enterprise-plan-card__eyebrow">{{ 'teams.personal.eyebrow'|trans({'%plan%': currentPlan.label|default('Free')}) }}</span>
                <h2>{{ ('teams.personal.' ~ currentPlanCode ~ '_title')|trans }}</h2>
                <p>{{ ('teams.personal.' ~ currentPlanCode ~ '_description')|trans }}</p>
                {% if currentPlanCode != 'team' %}
                    <div class="enterprise-plan-card__features">
                        <span><i class="fa-solid fa-layer-group"></i> {{ (teamLimit is null ? 'teams.personal.groups_unlimited' : 'teams.personal.groups_limit')|trans({'%limit%': teamLimit}) }}</span>
                        <span><i class="fa-solid fa-users-gear"></i> {{ 'teams.personal.centralized_members'|trans }}</span>
                        <span><i class="fa-solid fa-ticket"></i> {{ 'teams.personal.automatic_licenses'|trans }}</span>
                    </div>
                {% endif %}
            </div>
            {% if currentPlanCode != 'team' %}
                <a href="{{ path('app_subscription') }}" class="enterprise-plan-card__cta">
                    {{ 'teams.personal.discover_team'|trans }} <i class="fa-solid fa-arrow-right"></i>
                </a>
            {% endif %}
        </section>
    {% endif %}

    {# Upgrade banner shown when the active plan limit is reached. #}
    {% if teamLimit is not null and ownedTeamsCount >= teamLimit %}
        <div class="pro-upgrade-banner">
            <div class="pro-banner-content">
                <div class="pro-banner-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>
                <div class="pro-banner-text">
                    <h3>{{ 'teams.pro_banner.title'|trans|default('Limite atteinte !') }}</h3>
                    <p>{{ 'teams.pro_banner.description'|trans({'%limit%': teamLimit}) }}</p>
                </div>
            </div>
            <a href="{{ path('app_subscription') }}" class="btn-upgrade-pro">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                </svg>
                {{ 'teams.pro_banner.action'|trans|default('Passer à PRO') }}
            </a>
        </div>
    {% endif %}

    <div class="groups-section-heading">
        <div>
            <span>{{ 'teams.groups.eyebrow'|trans }}</span>
            <h2>{{ 'teams.groups.title'|trans }}</h2>
            <p>{{ 'teams.groups.description'|trans }}</p>
        </div>
        <strong>{{ 'teams.groups.count'|trans({'%count%': teams|length}) }}</strong>
    </div>

    {% if teams is empty %}
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
            </div>

            <h2>{{ 'teams.empty.title'|trans }}</h2>
            <p>{{ 'teams.empty.description'|trans }}</p>

            {% if canCreateTeam %}
                <a href="{{ path('app_team_new') }}" class="btn-primary-action">
                    {{ 'teams.empty.action'|trans }}
                </a>
            {% endif %}
        </div>
    {% else %}
        <div class="teams-grid">
            {% for team in teams %}
                <div class="team-card">
                    {% set currentMember = null %}
                    {% for member in team.members %}
                        {% if member.user and app.user and member.user.id == app.user.id %}
                            {% set currentMember = member %}
                        {% endif %}
                    {% endfor %}

                    <div class="team-card-header">
                        <div class="team-avatar">
                            {{ team.name|slice(0, 2)|upper }}
                        </div>

                        <div class="team-info">
                            <h3 class="team-name">{{ team.name }}</h3>

                            <div class="team-meta">
                                <span class="meta-item">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                                    </svg>

                                    {{ team.members|length }}
                                    {{ team.members|length > 1
                                        ? 'teams.card.members_plural'|trans
                                        : 'teams.card.members'|trans
                                    }}
                                </span>

                                <span class="meta-item">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    {{ team.createdAt|date('d/m/Y') }}
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="team-card-body">
                        <div class="owner-badge">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            {{ team.owner.email ?? 'teams.card.owner_fallback'|trans }}
                        </div>
                    </div>

                    <div class="team-card-footer">
                        <a href="{{ path('app_team_show', { id: team.id }) }}" class="btn-view-team">
                            {{ 'teams.card.view'|trans }}
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>

                        {% if currentMember and currentMember.role != constant('App\\Enum\\TeamRole::OWNER') %}
                            <form method="post"
                                  action="{{ path('app_team_leave', {id: team.id}) }}"
                                  class="team-card-leave-form"
                                  onsubmit="return confirm('{{ 'teams.card.leave_confirm'|trans|e('js') }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('leave_team_' ~ team.id) }}">
                                <button type="submit" class="btn-leave-team-card">
                                    {{ 'teams.card.leave'|trans }}
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

<style>
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.company-workspace-card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(340px, .95fr);
    gap: 1px;
    margin-bottom: 2rem;
    overflow: hidden;
    border: 1px solid var(--glass-card-border);
    border-radius: var(--border-radius);
    background: var(--glass-card-border);
    box-shadow: var(--glass-card-shadow);
}

.company-workspace-card.is-member-view {
    grid-template-columns: 1fr;
}

.company-workspace-main,
.company-members-panel {
    padding: 1.5rem;
    background: var(--glass-card-bg);
    backdrop-filter: var(--glass-card-blur);
}

.company-workspace-heading {
    display: flex;
    align-items: center;
    gap: .9rem;
}

.company-workspace-icon {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: var(--border-radius-sm);
    color: white;
    background: var(--color-primary);
}

.company-workspace-eyebrow {
    color: var(--color-text-medium);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.company-workspace-heading h2,
.company-members-panel h3 {
    margin: .15rem 0 0;
    color: var(--color-text-dark);
}

.company-workspace-status {
    margin-left: auto;
    padding: .3rem .55rem;
    border-radius: 999px;
    font-size: .72rem;
    font-weight: 700;
}

.company-workspace-status.is-active {
    color: #047857;
    background: rgba(16, 185, 129, .12);
}

.company-workspace-status.is-suspended {
    color: #b45309;
    background: rgba(245, 158, 11, .12);
}

.company-seat-overview {
    margin-top: 1.5rem;
}

.company-seat-title,
.company-seat-meta,
.company-member-row,
.company-seat-form {
    display: flex;
    align-items: center;
}

.company-seat-title {
    justify-content: space-between;
    color: var(--color-text-dark);
}

.company-seat-title span,
.company-seat-meta,
.company-workspace-note,
.company-seat-form small {
    color: var(--color-text-medium);
    font-size: .82rem;
}

.company-seat-progress {
    height: 7px;
    margin: .7rem 0;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-bg-hover);
}

.company-seat-progress span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-primary);
}

.company-seat-meta {
    flex-wrap: wrap;
    gap: .45rem 1rem;
}

.company-seat-warning {
    margin: .9rem 0 0;
    color: #b45309;
    font-size: .84rem;
}

.company-workspace-note {
    margin: 1.25rem 0 0;
}

.company-members-panel h3 {
    font-size: 1rem;
}

.company-invite-description {
    margin: .35rem 0 .8rem;
    color: var(--color-text-medium);
    font-size: .78rem;
    line-height: 1.45;
}

.company-invite-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 128px auto;
    gap: .45rem;
    padding-bottom: .9rem;
    border-bottom: 1px solid var(--color-border);
}

.company-invite-field {
    min-width: 0;
}

.company-invite-field input,
.company-invite-field select {
    width: 100%;
    min-height: 38px;
    padding: .55rem .65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-dark);
    background: var(--glass-card-bg);
}

.company-invite-form button {
    min-height: 38px;
    padding: .55rem .75rem;
    border: 0;
    border-radius: var(--border-radius-sm);
    color: white;
    font-weight: 700;
    background: var(--color-primary);
    cursor: pointer;
}

.company-members-list {
    display: grid;
    gap: .4rem;
    max-height: 238px;
    margin-top: .9rem;
    overflow: auto;
}

@media (max-width: 720px) {
    .company-invite-form {
        grid-template-columns: 1fr;
    }
}

.company-member-row {
    gap: .7rem;
    min-width: 0;
    padding: .55rem;
    border-radius: var(--border-radius-sm);
    background: var(--color-bg-light);
}

.company-member-avatar {
    display: grid;
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    place-items: center;
    border-radius: 50%;
    color: var(--color-primary);
    font-weight: 800;
    background: rgba(16, 185, 129, .12);
}

.company-member-identity {
    display: grid;
    min-width: 0;
    flex: 1;
}

.company-member-identity strong {
    overflow: hidden;
    color: var(--color-text-dark);
    font-size: .86rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.company-member-identity small {
    color: var(--color-text-medium);
    font-size: .72rem;
}

.company-member-remove {
    border: 0;
    color: #dc2626;
    font-size: .75rem;
    background: transparent;
    cursor: pointer;
}

.company-member-role select {
    max-width: 118px;
    padding: .35rem .45rem;
    border: 1px solid var(--glass-card-border);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-dark);
    font-size: .75rem;
    background: var(--glass-card-bg);
}

.company-seat-form {
    gap: .6rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
}

.company-seat-form div {
    display: grid;
    flex: 1;
}

.company-seat-form label {
    color: var(--color-text-dark);
    font-size: .82rem;
    font-weight: 700;
}

.company-seat-form input {
    width: 72px;
    padding: .55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    background: var(--color-white);
    color: var(--color-text-dark);
}

.company-seat-form button {
    padding: .6rem .8rem;
    border: 0;
    border-radius: var(--border-radius-sm);
    color: white;
    font-weight: 700;
    background: var(--color-primary);
    cursor: pointer;
}

.company-hub {
    margin-bottom: 2rem;
    overflow: hidden;
    border: 1px solid var(--glass-card-border);
    border-radius: var(--border-radius);
    background: var(--glass-card-bg);
    box-shadow: var(--glass-card-shadow);
    backdrop-filter: var(--glass-card-blur);
}

.company-hub__header {
    display: flex;
    align-items: center;
    gap: .9rem;
    padding: 1.35rem 1.45rem;
    border-bottom: 1px solid var(--color-border);
}

.company-hub__identity {
    min-width: 0;
    flex: 1;
}

.company-hub__identity h2 {
    margin: .15rem 0 0;
    color: var(--color-text-dark);
    font-size: 1.2rem;
}

.company-hub__identity p {
    margin: .25rem 0 0;
    color: var(--color-text-medium);
    font-size: .76rem;
}

.company-workspace-status i {
    margin-right: .25rem;
    font-size: .42rem;
    vertical-align: middle;
}

.company-hub__metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-border);
}

.company-metric {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding: 1rem 1.2rem;
    background: color-mix(in srgb, var(--glass-card-bg) 92%, var(--color-bg-light));
}

.company-metric span {
    color: var(--color-text-medium);
    font-size: .72rem;
    font-weight: 650;
}

.company-metric strong {
    color: var(--color-text-dark);
    font-size: 1.25rem;
    letter-spacing: -.04em;
}

.company-metric strong small {
    color: var(--color-text-light);
    font-size: .72rem;
    font-weight: 600;
}

.company-metric.is-primary strong {
    color: var(--color-primary);
}

.company-hub__capacity {
    padding: .85rem 1.45rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-light) 65%, transparent);
}

.company-hub__capacity > div:first-child {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-text-dark);
    font-size: .75rem;
}

.company-hub__capacity > div:first-child span {
    color: var(--color-text-medium);
}

.company-hub__capacity .company-seat-progress {
    height: 5px;
    margin: .55rem 0 0;
}

.company-hub__body {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(285px, .75fr);
    gap: 0;
}

.company-hub__body.is-member-view {
    grid-template-columns: minmax(0, 1.4fr) minmax(250px, .6fr);
}

.company-directory {
    min-width: 0;
    padding: 1.35rem 1.45rem;
}

.company-panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: .9rem;
}

.company-panel-heading span {
    color: var(--color-text-medium);
    font-size: .67rem;
    font-weight: 750;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.company-panel-heading h3 {
    margin: .15rem 0 0;
    color: var(--color-text-dark);
    font-size: 1rem;
}

.company-panel-heading > small {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 50%;
    color: var(--color-primary);
    font-size: .72rem;
    font-weight: 800;
    background: rgba(16, 185, 129, .1);
}

.company-hub .company-members-list {
    max-height: 390px;
    margin: 0;
}

.company-hub .company-member-row {
    min-height: 54px;
    padding: .65rem .7rem;
    border: 1px solid transparent;
    background: color-mix(in srgb, var(--color-bg-light) 72%, transparent);
}

.company-hub .company-member-row:hover {
    border-color: var(--glass-card-border);
    background: var(--glass-card-bg);
}

.company-member-identity small {
    display: flex;
    align-items: center;
    gap: .35rem;
}

.member-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #94a3b8;
}

.member-status-dot.is-active {
    background: #10b981;
}

.member-status-dot.is-pending {
    background: #f59e0b;
}

.company-role-label {
    color: var(--color-text-medium);
    font-size: .72rem;
    font-weight: 650;
}

.company-hub .company-member-remove {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: var(--border-radius-sm);
    color: var(--color-text-light);
}

.company-hub .company-member-remove:hover {
    color: #dc2626;
    background: rgba(220, 38, 38, .08);
}

.company-actions,
.company-member-access-card {
    display: grid;
    align-content: start;
    gap: .8rem;
    padding: 1.35rem;
    border-left: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-light) 55%, transparent);
}

.company-action-card,
.company-seat-form {
    display: block;
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--glass-card-border);
    border-radius: var(--border-radius);
    background: var(--glass-card-bg);
    box-shadow: 0 7px 22px rgba(15, 23, 42, .04);
}

.company-action-card__icon {
    display: grid;
    width: 32px;
    height: 32px;
    margin-bottom: .7rem;
    place-items: center;
    border-radius: var(--border-radius-sm);
    color: var(--color-primary);
    font-size: .8rem;
    background: rgba(16, 185, 129, .1);
}

.company-action-card h3,
.company-seat-form label {
    display: block;
    margin: 0;
    color: var(--color-text-dark);
    font-size: .86rem;
    font-weight: 750;
}

.company-action-card > p,
.company-seat-form small {
    display: block;
    margin: .35rem 0 .8rem;
    color: var(--color-text-medium);
    font-size: .71rem;
    line-height: 1.5;
}

.company-hub .company-invite-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: .5rem;
    padding: 0;
    border: 0;
}

.company-hub .company-invite-field input,
.company-hub .company-invite-field select {
    min-height: 40px;
    background: var(--color-white);
}

.company-hub .company-invite-form button {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: .5rem;
}

.company-hub .company-seat-form {
    padding-top: 1rem;
}

.company-seat-form__controls {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: .5rem;
}

.company-hub .company-seat-form input,
.company-hub .company-seat-form button {
    width: 100%;
    min-height: 38px;
}

.company-member-access-card {
    align-self: stretch;
    border: 0;
    border-left: 1px solid var(--color-border);
    border-radius: 0;
    box-shadow: none;
}

.company-license-overview {
    padding: 1rem 1.45rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-light) 65%, transparent);
}

.company-license-overview__top,
.company-license-overview__identity,
.company-license-overview__meta {
    display: flex;
    align-items: center;
}

.company-license-overview__top {
    justify-content: space-between;
    gap: 1rem;
}

.company-license-overview__identity {
    min-width: 0;
    gap: .7rem;
}

.company-license-overview__identity > div {
    display: grid;
    gap: .12rem;
}

.company-license-overview__identity strong {
    color: var(--color-text-dark);
    font-size: .84rem;
}

.company-license-overview__identity span:not(.company-license-overview__icon) {
    color: var(--color-text-medium);
    font-size: .74rem;
}

.company-license-overview__icon {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    place-items: center;
    border-radius: var(--border-radius-sm);
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 11%, transparent);
}

.company-license-available {
    padding: .4rem .6rem;
    border-radius: 999px;
    color: #047857;
    font-size: .7rem;
    font-weight: 750;
    background: rgba(16, 185, 129, .11);
    white-space: nowrap;
}

.company-license-available.is-empty {
    color: #b45309;
    background: rgba(245, 158, 11, .12);
}

.company-license-overview__meta {
    flex-wrap: wrap;
    gap: .45rem 1rem;
    color: var(--color-text-medium);
    font-size: .72rem;
}

.company-license-overview__meta i {
    margin-right: .22rem;
    color: var(--color-primary);
}

.company-license-auto-note {
    display: flex;
    align-items: flex-start;
    gap: .5rem;
    margin: .65rem 0;
    padding: .65rem .7rem;
    border-radius: var(--border-radius-sm);
    color: var(--color-primary);
    font-size: .71rem;
    font-weight: 650;
    line-height: 1.4;
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
}

.company-license-auto-note i {
    margin-top: .12rem;
}

.company-role-help {
    display: block;
    margin-top: .65rem;
    color: var(--color-text-medium);
    font-size: .68rem;
    line-height: 1.45;
}

.company-quick-license-form button,
.enterprise-plan-card__cta {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    border: 0;
    border-radius: var(--border-radius-sm);
    color: #fff;
    font-weight: 750;
    background: var(--color-primary);
    cursor: pointer;
}

.company-quick-license-form button {
    width: 100%;
    padding: .65rem .8rem;
}

.company-license-settings {
    border: 1px solid var(--glass-card-border);
    border-radius: var(--border-radius);
    background: var(--glass-card-bg);
}

.company-license-settings > summary {
    display: flex;
    min-height: 44px;
    padding: .75rem .85rem;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    color: var(--color-text-dark);
    font-size: .76rem;
    font-weight: 750;
    list-style: none;
    cursor: pointer;
}

.company-license-settings > summary::-webkit-details-marker {
    display: none;
}

.company-license-settings > summary span i {
    margin-right: .4rem;
    color: var(--color-primary);
}

.company-license-settings > summary > i {
    color: var(--color-text-light);
    font-size: .65rem;
    transition: transform .18s ease;
}

.company-license-settings[open] > summary > i {
    transform: rotate(180deg);
}

.company-license-settings .company-seat-form {
    margin: 0;
    padding: .2rem .85rem .85rem;
    border: 0;
    border-top: 1px solid var(--color-border);
    border-radius: 0;
    box-shadow: none;
}

.enterprise-plan-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    margin-bottom: 2rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--glass-card-border);
    border-radius: var(--border-radius);
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 8%, var(--glass-card-bg)), var(--glass-card-bg));
    box-shadow: var(--glass-card-shadow);
}

.enterprise-plan-card__icon {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border-radius: var(--border-radius);
    color: var(--color-primary);
    font-size: 1.05rem;
    background: color-mix(in srgb, var(--color-primary) 11%, transparent);
}

.enterprise-plan-card__content {
    min-width: 0;
}

.enterprise-plan-card__eyebrow,
.groups-section-heading > div > span {
    color: var(--color-primary);
    font-size: .67rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.enterprise-plan-card h2 {
    margin: .18rem 0 .3rem;
    color: var(--color-text-dark);
    font-size: 1rem;
}

.enterprise-plan-card p {
    margin: 0;
    color: var(--color-text-medium);
    font-size: .78rem;
    line-height: 1.5;
}

.enterprise-plan-card__features {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem .9rem;
    margin-top: .75rem;
    color: var(--color-text-medium);
    font-size: .7rem;
}

.enterprise-plan-card__features i {
    margin-right: .28rem;
    color: var(--color-primary);
}

.enterprise-plan-card__cta {
    padding: .7rem .9rem;
    font-size: .76rem;
    text-decoration: none;
    white-space: nowrap;
}

.groups-section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1rem;
}

.groups-section-heading h2 {
    margin: .15rem 0 .18rem;
    color: var(--color-text-dark);
    font-size: 1.1rem;
}

.groups-section-heading p {
    margin: 0;
    color: var(--color-text-medium);
    font-size: .78rem;
}

.groups-section-heading > strong {
    padding: .4rem .6rem;
    border-radius: 999px;
    color: var(--color-primary);
    font-size: .7rem;
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
    white-space: nowrap;
}

.teams-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2.5rem;
    gap: 2rem;
}

.header-content {
    flex: 1;
}

.header-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
}

.header-icon {
    width: 40px;
    height: 40px;
    color: var(--color-primary);
}

.header-title h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text-dark);
    margin: 0;
}

.header-subtitle {
    color: var(--color-text-medium);
    font-size: 1rem;
    margin: 0;
}

.btn-primary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--border-radius-sm);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: var(--shadow-green);
    white-space: nowrap;
}

.btn-primary-action:hover {
    background: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(5, 150, 105, 0.4);
}

.btn-primary-action svg {
    width: 20px;
    height: 20px;
}

/* Disabled Button */
.btn-disabled {
    background: #e5e7eb;
    color: #9ca3af;
    cursor: not-allowed;
    box-shadow: none;
    opacity: 0.6;
}

.btn-disabled:hover {
    background: #e5e7eb;
    transform: none;
    box-shadow: none;
}

/* PRO Upgrade Banner */
.pro-upgrade-banner {
    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
    border: 2px solid #fbbf24;
    border-radius: var(--border-radius);
    padding: 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    box-shadow: 0 4px 12px rgba(251, 191, 36, 0.2);
    animation: slideDown 0.4s ease-out;
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.pro-banner-content {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: 1;
}

.pro-banner-icon {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
}

.pro-banner-icon svg {
    width: 28px;
    height: 28px;
    color: white;
}

.pro-banner-text h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #92400e;
    margin: 0 0 0.25rem 0;
}

.pro-banner-text p {
    font-size: 0.95rem;
    color: #78350f;
    margin: 0;
    line-height: 1.5;
}

.btn-upgrade-pro {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    color: white;
    border: none;
    border-radius: var(--border-radius-sm);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.btn-upgrade-pro:hover {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.5);
}

.btn-upgrade-pro svg {
    width: 20px;
    height: 20px;
}

/* Empty State */
.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--glass-card-bg);
    border-radius: var(--border-radius);
    border: 1px solid var(--glass-card-border);
    box-shadow: var(--glass-card-shadow);
    -webkit-backdrop-filter: var(--glass-card-blur);
    backdrop-filter: var(--glass-card-blur);
}

.empty-state-icon {
    display: inline-flex;
    padding: 1.5rem;
    background: var(--background-gradient);
    border-radius: 50%;
    margin-bottom: 1.5rem;
}

.empty-state-icon svg {
    width: 48px;
    height: 48px;
    color: var(--color-primary);
}

.empty-state h2 {
    font-size: 1.5rem;
    color: var(--color-text-dark);
    margin-bottom: 0.5rem;
}

.empty-state p {
    color: var(--color-text-medium);
    margin-bottom: 2rem;
}

/* Teams Grid */
.teams-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
}

.team-card {
    background: var(--glass-card-bg);
    border-radius: var(--border-radius);
    box-shadow: var(--glass-card-shadow);
    transition: all 0.3s ease;
    overflow: hidden;
    border: 1px solid var(--glass-card-border);
    -webkit-backdrop-filter: var(--glass-card-blur);
    backdrop-filter: var(--glass-card-blur);
}

.team-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
}

.team-card-header {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--background-gradient);
}

.team-avatar {
    width: 56px;
    height: 56px;
    border-radius: var(--border-radius-sm);
    background: var(--color-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.25rem;
    flex-shrink: 0;
}

.team-info {
    flex: 1;
    min-width: 0;
}

.team-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-dark);
    margin: 0 0 0.5rem 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.team-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
}

.meta-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-text-medium);
    font-size: 0.875rem;
}

.meta-item svg {
    width: 16px;
    height: 16px;
}

.team-card-body {
    padding: 1.25rem 1.5rem;
}

.owner-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--color-bg-light);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-medium);
    font-size: 0.875rem;
}

.owner-badge svg {
    width: 18px;
    height: 18px;
    color: var(--color-primary);
}

.team-card-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
}

.btn-view-team {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
}

.btn-view-team:hover {
    gap: 0.75rem;
    color: var(--color-primary);
}

.btn-view-team svg {
    width: 16px;
    height: 16px;
}

.team-card-leave-form {
    margin: 0;
}

.btn-leave-team-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1rem;
    background: var(--color-white);
    color: var(--color-danger-start);
    border: 1.5px solid #fecaca;
    border-radius: var(--border-radius-sm);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-leave-team-card:hover {
    background: #fff1f2;
    border-color: #fca5a5;
}

[data-theme="dark"] .btn-primary-action:hover {
    background: var(--color-primary);
}

[data-theme="dark"] .btn-disabled,
[data-theme="dark"] .btn-disabled:hover {
    background: var(--color-bg-hover);
    color: var(--color-text-light);
}

[data-theme="dark"] .pro-upgrade-banner {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.18) 0%, rgba(217, 119, 6, 0.22) 100%);
    border-color: rgba(251, 191, 36, 0.4);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
}

[data-theme="dark"] .pro-banner-text h3 {
    color: #fde68a;
}

[data-theme="dark"] .pro-banner-text p {
    color: #fef3c7;
}

[data-theme="dark"] .empty-state,
[data-theme="dark"] .team-card {
    background: var(--glass-card-bg);
}

[data-theme="dark"] .btn-leave-team-card {
    background: var(--color-white);
    border-color: rgba(239, 68, 68, 0.35);
}

[data-theme="dark"] .btn-leave-team-card:hover {
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.5);
}

@media (max-width: 768px) {
    .company-workspace-card {
        grid-template-columns: 1fr;
    }

    .company-seat-form {
        align-items: stretch;
        flex-wrap: wrap;
    }

    .company-hub__header {
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .company-hub__identity {
        flex-basis: calc(100% - 60px);
    }

    .company-hub__metrics {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .company-hub__body,
    .company-hub__body.is-member-view {
        grid-template-columns: 1fr;
    }

    .enterprise-plan-card {
        grid-template-columns: auto minmax(0, 1fr);
    }

    .enterprise-plan-card__cta {
        grid-column: 1 / -1;
        width: 100%;
    }

    .company-actions,
    .company-member-access-card {
        border-top: 1px solid var(--color-border);
        border-left: 0;
    }

    .company-hub .company-member-row {
        flex-wrap: wrap;
    }

    .company-member-identity {
        min-width: calc(100% - 54px);
    }

    .page-header {
        flex-direction: column;
    }
    
    .btn-primary-action {
        width: 100%;
        justify-content: center;
    }
    
    .pro-upgrade-banner {
        flex-direction: column;
        text-align: center;
    }
    
    .pro-banner-content {
        flex-direction: column;
        text-align: center;
    }
    
    .btn-upgrade-pro {
        width: 100%;
        justify-content: center;
    }
    
    .teams-grid {
        grid-template-columns: 1fr;
    }

    .team-card-footer {
        flex-direction: column;
        align-items: stretch;
    }

    .btn-leave-team-card,
    .btn-view-team {
        width: 100%;
        justify-content: center;
    }
}

@media (max-width: 460px) {
    .teams-container {
        padding: 1rem;
    }

    .company-hub__metrics {
        grid-template-columns: 1fr;
    }

    .company-directory,
    .company-actions,
    .company-hub__header,
    .company-hub__capacity,
    .company-license-overview {
        padding-right: 1rem;
        padding-left: 1rem;
    }

    .company-license-overview__top,
    .groups-section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .enterprise-plan-card {
        grid-template-columns: 1fr;
        padding: 1rem;
    }

    .enterprise-plan-card__features {
        display: grid;
    }
}
</style>
{% endblock %}
