{% extends 'base.html.twig' %}

{% block title %}{{ 'teams.page_title'|trans }}{% endblock %}
{% block body_class %}team-workspace-page{% endblock %}
{% block breadcrumb %}{% endblock %}
{% block page_styles %}<link rel="stylesheet" href="{{ asset('styles/pages/team-workspace.css') }}">{% endblock %}

{% block body %}
{% set currentPlanCode = currentPlan.code|default('free') %}
{% set isCompanyOwner = organization and app.user and organization.owner.id == app.user.id %}
<div class="tw-workspace" data-controller="team-workspace">
    <header class="tw-heading">
        <div><span class="tw-eyebrow">{{ 'teams.organization.eyebrow'|trans }}</span><h1>{{ 'teams.header.title'|trans }}</h1><p>{{ (organization and organization.active ? 'teams.header.subtitle_team' : 'teams.header.subtitle_personal')|trans }}</p></div>
        <div class="tw-actions">
            {% if canManageOrganization and organizationInviteForm %}
                <button type="button" class="tw-button tw-button-secondary tw-main-invite" data-dialog="tw-invite-company" data-action="team-workspace#openDialog"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> {{ 'teams.organization.invite_card_title'|trans }}</button>
            {% endif %}
            {% if canCreateTeam %}
                <a href="{{ path('app_team_new') }}" class="tw-button tw-button-primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{ 'teams.header.new_team'|trans }}</a>
            {% else %}
                <a href="{{ path('app_subscription') }}" class="tw-button tw-button-primary" title="{{ (currentPlanCode == 'free' ? 'teams.wizard.paid_required' : 'teams.header.limit_hint')|trans }}"><i class="fa-solid fa-arrow-up-right-dots" aria-hidden="true"></i> {{ 'teams.pro_banner.action'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <div class="tw-feedback">{% include 'components/ui/flash_messages.html.twig' %}</div>

    {% if organization and seatSummary %}
        {% set seatPercent = seatSummary.purchased > 0 ? ((seatSummary.used / seatSummary.purchased) * 100)|round : 100 %}
        <section class="tw-overview" aria-label="{{ 'teams.organization.capacity_title'|trans }}">
            <div class="tw-company-identity"><span class="tw-brand-icon"><i class="fa-solid fa-building-shield" aria-hidden="true"></i></span><div><h2>{{ organization.name }}</h2><span class="tw-status {{ organization.active ? 'is-active' : 'is-suspended' }}"><i class="fa-solid fa-circle" aria-hidden="true"></i> {{ (organization.active ? 'teams.organization.active' : 'teams.organization.suspended')|trans }}</span><span class="tw-mobile-pending"> · {{ 'teams.organization.pending_members'|trans({'%count%': seatSummary.pending}) }}</span></div></div>
            <div class="tw-license-meter"><div><span>{{ 'teams.organization.capacity_title'|trans }}</span><strong>{{ seatSummary.used }} <small>/ {{ seatSummary.purchased }}</small></strong></div><div class="tw-progress" role="progressbar" aria-label="{{ 'teams.organization.capacity_title'|trans }}" aria-valuemin="0" aria-valuemax="{{ seatSummary.purchased }}" aria-valuenow="{{ seatSummary.used > seatSummary.purchased ? seatSummary.purchased : seatSummary.used }}"><span style="width: {{ seatPercent > 100 ? 100 : seatPercent }}%"></span></div></div>
            <div class="tw-metric"><strong>{{ seatSummary.available }}</strong><span>{{ 'teams.organization.metric_available'|trans }}</span></div>
            <div class="tw-metric tw-pending-metric"><strong>{{ seatSummary.pending }}</strong><span>{{ 'teams.organization.metric_pending'|trans }}</span></div>
            {% if isCompanyOwner and organization.active %}
                <button class="tw-button tw-button-secondary tw-manage-licenses" type="button" aria-label="{{ 'teams.workspace.manage_licenses'|trans }}" data-dialog="tw-licenses" data-action="team-workspace#openDialog"><i class="fa-solid fa-sliders" aria-hidden="true"></i><span class="tw-manage-label">{{ 'teams.workspace.manage_licenses'|trans }}</span><span class="tw-manage-short">{{ 'teams.organization.seats'|trans }}</span></button>
            {% endif %}
        </section>
        {% if seatSummary.overCapacity %}<p class="tw-notice tw-notice-warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{ 'teams.organization.over_capacity'|trans }}</p>{% endif %}
        {% if not organization.active %}<p class="tw-notice tw-notice-warning">{{ 'teams.organization.suspended'|trans }} · {{ 'teams.organization.workspace_note'|trans }}</p>{% endif %}
    {% elseif not organization %}
        <section class="tw-plan-overview">
            <span class="tw-brand-icon"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span>
            <div><span class="tw-eyebrow">{{ 'teams.personal.eyebrow'|trans({'%plan%': currentPlan.label|default('Free')}) }}</span><h2>{{ ('teams.personal.' ~ currentPlanCode ~ '_title')|trans }}</h2><p>{{ ('teams.personal.' ~ currentPlanCode ~ '_description')|trans }}</p></div>
            {% if currentPlanCode != 'team' %}<a class="tw-text-link" href="{{ path('app_subscription') }}">{{ 'teams.personal.discover_team'|trans }} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>{% endif %}
        </section>
    {% endif %}

    {% if organization %}
        <div class="tw-tabs" role="tablist" aria-label="{{ 'teams.header.title'|trans }}">
            <button id="tw-groups-tab" type="button" role="tab" aria-controls="tw-groups-panel" data-panel="groups" data-team-workspace-target="tab" data-action="team-workspace#switchPanel keydown->team-workspace#tabKeydown">{{ 'teams.workspace.groups'|trans }} <span>{{ teams|length }}</span></button>
            <button id="tw-members-tab" type="button" role="tab" aria-controls="tw-members-panel" data-panel="members" data-team-workspace-target="tab" data-action="team-workspace#switchPanel keydown->team-workspace#tabKeydown">{{ 'teams.workspace.members'|trans }} <span>{{ organization.members|length }}</span></button>
        </div>
    {% endif %}

    <div class="tw-columns {{ organization ? '' : 'is-single' }}">
        <section class="tw-panel" id="tw-groups-panel" aria-labelledby="tw-groups-title" data-panel="groups" data-team-workspace-target="panel">
            <header class="tw-panel-heading"><div><span class="tw-panel-icon"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span><h2 id="tw-groups-title">{{ 'teams.groups.title'|trans }}</h2><span class="tw-count">{{ teams|length }}</span></div></header>
            {% if teams is not empty %}<div class="tw-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="{{ 'teams.workspace.search_groups'|trans }}" aria-label="{{ 'teams.workspace.search_groups'|trans }}" data-panel="groups" data-team-workspace-target="search" data-action="input->team-workspace#filter"></div>{% endif %}
            <div class="tw-list tw-group-list">
                {% for team in teams %}
                    {% set currentMember = null %}
                    {% for member in team.members %}{% if member.user and app.user and member.user.id == app.user.id %}{% set currentMember = member %}{% endif %}{% endfor %}
                    <article class="tw-group-card" data-team-workspace-target="row" data-panel="groups" data-search="{{ (team.name ~ ' ' ~ team.owner.email)|lower }}">
                        <a href="{{ path('app_team_show', {id: team.id}) }}" class="tw-group-link">
                            <span class="tw-group-avatar">{{ team.name|slice(0, 2)|upper }}</span>
                            <div class="tw-group-identity"><h3>{{ team.name }}</h3><p><i class="fa-solid fa-crown" aria-hidden="true"></i> {{ team.owner.email }}</p></div>
                            <i class="fa-solid fa-arrow-up-right-from-square tw-group-arrow" aria-hidden="true"></i>
                        </a>
                        <div class="tw-group-footer"><span><i class="fa-solid fa-user-group" aria-hidden="true"></i> {{ team.members|length }} {{ (team.members|length > 1 ? 'teams.card.members_plural' : 'teams.card.members')|trans }}</span><small>{{ team.createdAt|date('d/m/Y') }}</small>
                            {% if currentMember and currentMember.role.value != 'OWNER' %}
                                <form method="post" action="{{ path('app_team_leave', {id: team.id}) }}" onsubmit="return confirm('{{ 'teams.card.leave_confirm'|trans|e('js') }}');"><input type="hidden" name="_token" value="{{ csrf_token('leave_team_' ~ team.id) }}"><button class="tw-text-button tw-danger-text" type="submit">{{ 'teams.card.leave'|trans }}</button></form>
                            {% endif %}
                        </div>
                    </article>
                {% else %}
                    <div class="tw-empty"><span class="tw-empty-icon"><i class="fa-solid fa-user-group" aria-hidden="true"></i></span><h3>{{ 'teams.empty.title'|trans }}</h3><p>{{ 'teams.empty.description'|trans }}</p>{% if canCreateTeam %}<a href="{{ path('app_team_new') }}" class="tw-button tw-button-primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{ 'teams.empty.action'|trans }}</a>{% endif %}</div>
                {% endfor %}
                <p class="tw-no-results" data-team-workspace-target="empty" data-panel="groups" hidden>{{ 'teams.workspace.no_results'|trans }}</p>
            </div>
        </section>

        {% if organization %}
            <section class="tw-panel" id="tw-members-panel" aria-labelledby="tw-members-title" data-panel="members" data-team-workspace-target="panel">
                <header class="tw-panel-heading"><div><span class="tw-panel-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></span><h2 id="tw-members-title">{{ 'teams.organization.members_title'|trans }}</h2><span class="tw-count">{{ organization.members|length }}</span></div>{% if canManageOrganization and organizationInviteForm %}<button type="button" class="tw-button tw-button-small tw-button-secondary tw-mobile-invite" data-dialog="tw-invite-company" data-action="team-workspace#openDialog"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> {{ 'teams.workspace.invite'|trans }}</button>{% endif %}</header>
                <div class="tw-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="{{ 'teams.workspace.search_members'|trans }}" aria-label="{{ 'teams.workspace.search_members'|trans }}" data-panel="members" data-team-workspace-target="search" data-action="input->team-workspace#filter"></div>
                <div class="tw-list tw-member-list">
                    {% for member in organization.members %}
                        {% set roleKey = 'teams.organization.role_' ~ member.role.value|lower %}
                        {% set statusKey = 'teams.organization.member_status_' ~ member.status.value|lower %}
                        <div class="tw-person" data-team-workspace-target="row" data-panel="members" data-search="{{ (member.user.email ~ ' ' ~ roleKey|trans ~ ' ' ~ statusKey|trans)|lower }}">
                            <span class="tw-person-avatar">{{ member.user.email|slice(0, 1)|upper }}</span>
                            <div class="tw-person-identity"><strong>{{ member.user.email }}{% if app.user and member.user.id == app.user.id %}<span class="tw-you">{{ 'teams.wizard.you'|trans }}</span>{% endif %}</strong><small><span class="tw-status-dot is-{{ member.status.value|lower }}"></span>{{ statusKey|trans }}</small></div>
                            {% if isCompanyOwner and member.role.value in ['ADMIN', 'MEMBER'] %}
                                <form class="tw-role-form" method="post" action="{{ path('app_team_company_member_role', {id: member.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('update_company_role_' ~ member.id) }}"><label class="tw-sr-only" for="company-role-{{ member.id }}">{{ 'teams.organization.role_label'|trans }}</label><select id="company-role-{{ member.id }}" name="role" onchange="this.form.requestSubmit()"><option value="MEMBER" {{ member.role.value == 'MEMBER' ? 'selected' : '' }}>{{ 'teams.organization.role_member'|trans }}</option><option value="ADMIN" {{ member.role.value == 'ADMIN' ? 'selected' : '' }}>{{ 'teams.organization.role_admin'|trans }}</option></select></form>
                            {% else %}<span class="tw-role">{{ roleKey|trans }}</span>{% endif %}
                            {% if canManageOrganization and member.role.value != 'OWNER' %}
                                <form method="post" action="{{ path('app_team_company_member_remove', {id: member.id}) }}" onsubmit="return confirm('{{ 'teams.organization.remove_confirm'|trans|e('js') }}');"><input type="hidden" name="_token" value="{{ csrf_token('remove_company_member_' ~ member.id) }}"><button class="tw-icon-button tw-danger-text" type="submit" title="{{ 'teams.organization.remove'|trans }}" aria-label="{{ 'teams.organization.remove'|trans }}"><i class="fa-solid fa-user-minus" aria-hidden="true"></i></button></form>
                            {% endif %}
                        </div>
                    {% endfor %}
                    <p class="tw-no-results" data-team-workspace-target="empty" data-panel="members" hidden>{{ 'teams.workspace.no_results'|trans }}</p>
                </div>
                <footer class="tw-panel-footnote"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> {{ (canManageOrganization ? 'teams.organization.workspace_note' : 'teams.organization.member_access_help')|trans }}</footer>
            </section>
        {% endif %}
    </div>

    {% if canManageOrganization and organizationInviteForm %}
        <dialog id="tw-invite-company" class="tw-dialog" aria-labelledby="tw-invite-title" data-team-workspace-target="dialog" data-action="click->team-workspace#dismissDialog">
            <header class="tw-dialog-header"><div><span class="tw-eyebrow">{{ 'teams.organization.eyebrow'|trans }}</span><h2 id="tw-invite-title">{{ 'teams.organization.invite_card_title'|trans }}</h2></div><button class="tw-icon-button" type="button" aria-label="{{ 'teams.workspace.close'|trans }}" data-action="team-workspace#closeDialog"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></header>
            <div class="tw-dialog-body">
                {% if seatSummary.available > 0 %}
                    <p>{{ 'teams.organization.invite.description'|trans }}</p><p class="tw-notice"><i class="fa-solid fa-ticket" aria-hidden="true"></i> {{ 'teams.organization.invite.auto_license'|trans }}</p>
                    {{ form_start(organizationInviteForm, {attr: {class: 'tw-form', 'data-turbo': 'false'}}) }}
                        {{ form_label(organizationInviteForm.email) }}{{ form_widget(organizationInviteForm.email, {attr: {placeholder: 'teams.organization.invite.email_placeholder'|trans, autocomplete: 'email'}}) }}{{ form_errors(organizationInviteForm.email) }}
                        <button type="submit" class="tw-button tw-button-primary"><i class="fa-regular fa-paper-plane" aria-hidden="true"></i> {{ 'teams.organization.invite.submit'|trans }}</button>
                    {{ form_end(organizationInviteForm) }}
                    <p class="tw-help">{{ 'teams.organization.invite.role_after_invite'|trans }}</p>
                {% else %}
                    <p>{{ 'teams.organization.invite.no_license'|trans }}</p>
                    {% if isCompanyOwner and seatSummary.purchased < seatMaximum %}
                        <form method="post" action="{{ path('app_team_company_seats_update') }}" class="tw-form" onsubmit="return confirm('{{ 'teams.organization.add_license_confirm'|trans|e('js') }}');"><input type="hidden" name="_token" value="{{ csrf_token('update_company_seats_' ~ organization.id) }}"><input type="hidden" name="quantity" value="{{ seatSummary.purchased + 1 }}"><button type="submit" class="tw-button tw-button-primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{ 'teams.organization.add_one_license'|trans }}</button></form>
                    {% elseif seatSummary.purchased >= seatMaximum %}<p class="tw-help">{{ 'teams.organization.maximum_reached'|trans({'%maximum%': seatMaximum}) }}</p>
                    {% else %}<p class="tw-help">{{ 'teams.organization.ask_owner_license'|trans }}</p>{% endif %}
                {% endif %}
            </div>
        </dialog>
    {% endif %}

    {% if isCompanyOwner and organization.active %}
        <dialog id="tw-licenses" class="tw-dialog" aria-labelledby="tw-license-title" data-team-workspace-target="dialog" data-action="click->team-workspace#dismissDialog">
            <header class="tw-dialog-header"><div><span class="tw-eyebrow">{{ organization.name }}</span><h2 id="tw-license-title">{{ 'teams.organization.billing_title'|trans }}</h2></div><button class="tw-icon-button" type="button" aria-label="{{ 'teams.workspace.close'|trans }}" data-action="team-workspace#closeDialog"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></header>
            <div class="tw-dialog-body"><p>{{ 'teams.organization.used'|trans({'%used%': seatSummary.used, '%purchased%': seatSummary.purchased}) }}</p>
                <form class="tw-form" method="post" action="{{ path('app_team_company_seats_update') }}"><input type="hidden" name="_token" value="{{ csrf_token('update_company_seats_' ~ organization.id) }}"><label for="company-seat-quantity">{{ 'teams.organization.billing_quantity'|trans }}</label><input id="company-seat-quantity" type="number" name="quantity" min="{{ seatSummary.used > seatMinimum ? seatSummary.used : seatMinimum }}" max="{{ seatMaximum }}" value="{{ seatSummary.purchased }}" required><p class="tw-help">{{ 'teams.organization.billing_help'|trans }}</p><button type="submit" class="tw-button tw-button-primary">{{ 'teams.organization.billing_submit'|trans }}</button></form>
            </div>
        </dialog>
    {% endif %}
</div>
{% endblock %}
