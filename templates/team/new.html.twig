{% extends 'base.html.twig' %}

{% block title %}{{ 'teams.new.page_title'|trans }}{% endblock %}
{% block body_class %}team-create-page{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('styles/pages/team-create.css') }}">
{% endblock %}

{% block body %}
    <div class="team-create">
        <header class="tc-heading">
            <div>
                <span class="tc-eyebrow"><span></span> {{ 'teams.wizard.eyebrow'|trans }}</span>
                <h1>{{ 'teams.wizard.title'|trans }}</h1>
                <p>{{ 'teams.wizard.subtitle'|trans }}</p>
            </div>
            <a href="{{ path('app_team_index') }}" class="tc-back"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> {{ 'teams.new.back'|trans }}</a>
        </header>
        {% include 'team/_form.html.twig' %}
    </div>
{% endblock %}
