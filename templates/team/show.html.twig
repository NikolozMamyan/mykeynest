{% extends 'base.html.twig' %}
{% block title %}{{ 'teams.show.title'|trans({'%name%': team.name}) }}{% endblock %}
{% block body_class %}team-workspace-page{% endblock %}
{% block breadcrumb %}{% endblock %}
{% block page_styles %}
<link rel="stylesheet" href="{{ asset('styles/pages/team-show.css') }}">
<link rel="stylesheet" href="{{ asset('styles/pages/team-workspace.css') }}">
{% endblock %}
{% block body %}
{% set canManage = is_granted('TEAM_MANAGE', team) %}
{% set currentMember = null %}
{% for member in team.members %}{% if member.user and app.user and member.user.id == app.user.id %}{% set currentMember = member %}{% endif %}{% endfor %}
<div class="tw-workspace" data-controller="team-show team-workspace" data-team-show-delete-confirm-value="{{ 'teams.workspace.delete_confirm'|trans }}">
    <header class="tw-heading tw-group-heading">
        <div><a href="{{ path('app_team_index') }}" class="tw-back"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> {{ 'teams.show.back'|trans }}</a><h1>{{ team.name }}</h1><p>{{ 'teams.show.created_at'|trans({'%date%': team.createdAt|date('d/m/Y')}) }}</p></div>
        <div class="tw-actions">
            {% if currentMember and currentMember.role.value != 'OWNER' %}
            <form method="post" action="{{ path('app_team_leave', {id: team.id}) }}" data-action="submit->team-show#confirmForm" data-confirm-message="{{ 'teams.card.leave_confirm'|trans }}"><input type="hidden" name="_token" value="{{ csrf_token('leave_team_' ~ team.id) }}"><button type="submit" class="tw-button tw-button-secondary" aria-label="{{ 'teams.card.leave'|trans }}"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i><span>{{ 'teams.card.leave'|trans }}</span></button></form>
            {% endif %}
            {% if is_granted('TEAM_DELETE', team) %}<button type="button" class="tw-button tw-button-secondary tw-danger-text" aria-label="{{ 'teams.show.delete_team'|trans }}" data-action="team-show#confirmDeleteTeam"><i class="fa-regular fa-trash-can" aria-hidden="true"></i><span>{{ 'teams.show.delete_team'|trans }}</span></button>{% endif %}
        </div>
    </header>
    <div class="tw-feedback">{% include 'components/ui/flash_messages.html.twig' %}</div>
    <section class="tw-overview tw-team-overview" aria-label="{{ 'teams.show.title'|trans({'%name%': team.name}) }}">
        <div class="tw-company-identity"><span class="tw-group-avatar">{{ team.name|slice(0, 2)|upper }}</span><div><strong>{{ 'teams.wizard.owner'|trans }}{% if app.user and team.owner.id == app.user.id %}<span class="tw-you">{{ 'teams.wizard.you'|trans }}</span>{% endif %}</strong><p>{{ team.owner.email }}</p></div></div>
        <div class="tw-metric"><strong>{{ team.members|length }}</strong><span>{{ 'teams.workspace.members'|trans }}</span></div>
        <div class="tw-metric"><strong>{{ team.credentials|length }}</strong><span>{{ 'teams.wizard.accesses'|trans }}</span></div>
        {% if seatSummary %}<div class="tw-metric"><strong>{{ seatSummary.available }}</strong><span>{{ 'teams.workspace.available_licenses'|trans }}</span></div>{% endif %}
    </section>
    <div class="tw-tabs" role="tablist" aria-label="{{ 'teams.show.title'|trans({'%name%': team.name}) }}">
        <button id="tw-credentials-tab" type="button" role="tab" aria-controls="tw-credentials-panel" data-panel="credentials" data-team-workspace-target="tab" data-action="team-workspace#switchPanel keydown->team-workspace#tabKeydown">{{ 'teams.wizard.accesses'|trans }} <span>{{ team.credentials|length }}</span></button>
        <button id="tw-members-tab" type="button" role="tab" aria-controls="tw-members-panel" data-panel="members" data-team-workspace-target="tab" data-action="team-workspace#switchPanel keydown->team-workspace#tabKeydown">{{ 'teams.workspace.members'|trans }} <span>{{ team.members|length }}</span></button>
    </div>
    <div class="tw-columns">
        <section class="tw-panel" id="tw-credentials-panel" aria-labelledby="tw-credentials-title" data-panel="credentials" data-team-workspace-target="panel">
            <header class="tw-panel-heading"><div><span class="tw-panel-icon"><i class="fa-solid fa-key" aria-hidden="true"></i></span><h2 id="tw-credentials-title">{{ 'teams.show.credentials.title'|trans }}</h2><span class="tw-count">{{ team.credentials|length }}</span></div>{% if canManage %}<button type="button" class="tw-button tw-button-small tw-button-secondary" data-action="team-show#openCredentialsModal"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{ 'teams.show.credentials.add'|trans }}</button>{% endif %}</header>
            {% if team.credentials is not empty %}<div class="tw-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="{{ 'teams.workspace.search_credentials'|trans }}" aria-label="{{ 'teams.workspace.search_credentials'|trans }}" data-panel="credentials" data-team-workspace-target="search" data-action="input->team-workspace#filter"></div>{% endif %}
            <div class="tw-list tw-access-list">
                {% for credential in team.credentials %}
                <div class="tw-access-item" data-panel="credentials" data-search="{{ (credential.name ~ ' ' ~ credential.domain ~ ' ' ~ credential.username)|lower }}" data-team-workspace-target="row">
                    <span class="tw-site-logo" aria-hidden="true"><span>{{ credential.name|first|upper }}</span>{% if credential.domain is not empty and '.' in credential.domain and ' ' not in credential.domain %}<img src="https://www.google.com/s2/favicons?domain={{ credential.domain|url_encode }}&amp;sz=64" alt="" width="26" height="26" loading="lazy" referrerpolicy="no-referrer" data-team-workspace-target="favicon" data-action="load->team-workspace#faviconLoaded error->team-workspace#faviconError">{% endif %}</span>
                    <div class="tw-access-identity"><a href="{{ path('credential_show', {id: credential.id}) }}">{{ credential.name }}</a><small>{{ credential.domain }}</small><span>{{ credential.username }}</span></div>
                    {% if canManage %}<form method="post" action="{{ path('app_team_remove_credential', {id: team.id, credentialId: credential.id}) }}" data-action="submit->team-show#confirmForm" data-confirm-message="{{ 'teams.show.credentials.remove_confirm'|trans }}"><input type="hidden" name="_token" value="{{ csrf_token('remove_credential_' ~ credential.id) }}"><button type="submit" class="tw-icon-button tw-danger-text" title="{{ 'teams.show.credentials.remove_title'|trans }}" aria-label="{{ 'teams.show.credentials.remove_title'|trans }}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></form>{% endif %}
                </div>
                {% else %}<div class="tw-empty"><span class="tw-empty-icon"><i class="fa-solid fa-key" aria-hidden="true"></i></span><p>{{ 'teams.show.credentials.empty'|trans }}</p></div>{% endfor %}
                <p class="tw-no-results" data-panel="credentials" data-team-workspace-target="empty" hidden>{{ 'teams.workspace.no_results'|trans }}</p>
            </div>
        </section>
        <section class="tw-panel" id="tw-members-panel" aria-labelledby="tw-members-title" data-panel="members" data-team-workspace-target="panel">
            <header class="tw-panel-heading"><div><span class="tw-panel-icon"><i class="fa-solid fa-user-group" aria-hidden="true"></i></span><h2 id="tw-members-title">{{ 'teams.show.members.title'|trans }}</h2><span class="tw-count">{{ team.members|length }}</span></div>{% if add_member_form %}<button class="tw-button tw-button-small tw-button-secondary" type="button" data-dialog="tw-add-member" data-action="team-workspace#openDialog"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{ 'teams.show.members.add.submit'|trans }}</button>{% endif %}</header>
            {% if team.members is not empty %}<div class="tw-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="{{ 'teams.workspace.search_members'|trans }}" aria-label="{{ 'teams.workspace.search_members'|trans }}" data-panel="members" data-team-workspace-target="search" data-action="input->team-workspace#filter"></div>{% endif %}
            <div class="tw-list tw-member-list">
                {% for member in team.members %}
                <div class="tw-person" data-panel="members" data-search="{{ (member.user.email ~ ' ' ~ ('teams.organization.role_' ~ member.role.value|lower)|trans)|lower }}" data-team-workspace-target="row">
                    {% if member.user.avatar %}<img class="tw-person-avatar" src="{{ asset('uploads/avatars/' ~ member.user.avatar) }}" alt="">{% else %}<span class="tw-person-avatar">{{ member.user.email|first|upper }}</span>{% endif %}
                    <div class="tw-person-identity"><strong>{{ member.user.email }}{% if app.user and member.user.id == app.user.id %}<span class="tw-you">{{ 'teams.wizard.you'|trans }}</span>{% endif %}</strong><small>{{ 'teams.show.members.joined_at'|trans({'%date%': member.joinedAt|date('d/m/Y')}) }}</small></div>
                    <span class="tw-role {{ member.role.value == 'OWNER' ? 'is-owner' : '' }}">{{ ('teams.organization.role_' ~ member.role.value|lower)|trans }}</span>
                    {% if canManage and member.role.value != 'OWNER' %}<form method="post" action="{{ path('app_team_remove_member', {id: team.id, memberId: member.id}) }}" data-action="submit->team-show#confirmForm" data-confirm-message="{{ 'teams.show.members.remove_confirm'|trans }}"><input type="hidden" name="_token" value="{{ csrf_token('remove_member_' ~ member.id) }}"><button class="tw-icon-button tw-danger-text" type="submit" title="{{ 'teams.show.members.remove_title'|trans }}" aria-label="{{ 'teams.show.members.remove_title'|trans }}"><i class="fa-solid fa-user-minus" aria-hidden="true"></i></button></form>{% endif %}
                </div>
                {% else %}<div class="tw-empty"><p>{{ 'teams.show.members.empty'|trans }}</p></div>{% endfor %}
                <p class="tw-no-results" data-panel="members" data-team-workspace-target="empty" hidden>{{ 'teams.workspace.no_results'|trans }}</p>
            </div>
        </section>
    </div>
    {% if add_member_form %}
    <dialog id="tw-add-member" class="tw-dialog" aria-labelledby="tw-add-member-title" data-team-workspace-target="dialog" data-auto-open="{{ add_member_form.vars.submitted and not add_member_form.vars.valid ? 'true' : 'false' }}" data-action="click->team-workspace#dismissDialog">
        <header class="tw-dialog-header"><div><span class="tw-eyebrow">{{ team.name }}</span><h2 id="tw-add-member-title">{{ 'teams.show.members.add.title'|trans }}</h2></div><button class="tw-icon-button" type="button" aria-label="{{ 'teams.workspace.close'|trans }}" data-action="team-workspace#closeDialog"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></header>
        <div class="tw-dialog-body"><p>{{ 'teams.show.members.add.company_help'|trans }}</p>
            {{ form_start(add_member_form, {attr: {class: 'tw-form', 'data-turbo': 'false'}}) }}
            {{ form_errors(add_member_form) }}
            {{ form_label(add_member_form.email) }}{{ form_widget(add_member_form.email, {attr: {placeholder: 'teams.show.members.add.email_placeholder'|trans, autocomplete: 'email'}}) }}{{ form_errors(add_member_form.email) }}
            {{ form_label(add_member_form.role) }}{{ form_widget(add_member_form.role) }}{{ form_errors(add_member_form.role) }}
            <button class="tw-button tw-button-primary" type="submit"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> {{ 'teams.show.members.add.submit'|trans }}</button>
            {{ form_end(add_member_form) }}
        </div>
    </dialog>
    {% endif %}
{# Modal pour ajouter des credentials #}
{% if add_credentials_form is defined and add_credentials_form %}
<div id="credentialsModal" class="modal" aria-hidden="true">
    <div class="modal-overlay" data-action="click->team-show#closeCredentialsModal"></div>

    <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="credentialsModalTitle">
        <div class="modal-header">
            <h2 id="credentialsModalTitle">{{ 'teams.show.credentials.modal.title'|trans }}</h2>
            <button type="button" class="btn-close-modal" data-action="click->team-show#closeCredentialsModal" aria-label="{{ 'teams.workspace.close'|trans }}">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <div class="modal-body">
            {{ form_start(add_credentials_form, {'attr': {'class': 'credentials-form'}}) }}

            <div class="form-help-text-modal">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                {{ 'teams.show.credentials.modal.help'|trans }}
            </div>

            {# Search + quick actions #}
            <div class="credentials-toolbar">
                <div class="credentials-search">
                    <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M21 21l-4.35-4.35m1.35-5.65a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    <input
                        id="credentialsSearch"
                        type="text"
                        class="credentials-search-input"
                        placeholder="{{ 'teams.workspace.search_credentials'|trans }}"
                        autocomplete="off"
                        data-action="input->team-show#searchCredentials"
                    />
                    <button type="button" class="btn-clear-search" id="clearCredentialsSearch" aria-label="{{ 'teams.workspace.clear_search'|trans }}" hidden data-action="click->team-show#clearSearch">
                        &times;
                    </button>
                </div>

                <div class="credentials-actions">
                    <button type="button" class="btn-chip" id="selectAllCredentials" data-action="click->team-show#selectAll">
                        {{ 'teams.wizard.select_all'|trans }}
                    </button>
                    <button type="button" class="btn-chip" id="unselectAllCredentials" data-action="click->team-show#unselectAll">
                        {{ 'teams.wizard.clear_selection'|trans }}
                    </button>
                    <span class="credentials-counter" id="credentialsCounter">
                        0 / 0
                    </span>
                </div>
            </div>

            {# List #}
            <div class="credentials-listbox" id="credentialsListbox">
                <ul class="credentials-ul" id="credentialsUl">
                    {% for child in add_credentials_form.credentials %}
                        {# label texte pour la recherche #}
                        {% set labelText = (child.vars.label ?? '')|trim %}
                        <li class="credential-li" data-label="{{ labelText|lower }}">
                            <label class="credential-option">
                                {{ form_widget(child, {'attr': {'class': 'credential-checkbox', 'data-action': 'change->team-show#syncSelection'}}) }}

                                <span class="credential-text">
                                    <span class="credential-title">{{ labelText }}</span>
                                    {# Si tu as un domaine ou un extra a afficher, tu peux l'ajouter ici. #}
                                </span>

                                <span class="credential-check" aria-hidden="true">
                                    &#10003;
                                </span>
                            </label>
                        </li>
                    {% endfor %}
                </ul>

                <div class="credentials-empty" id="credentialsEmpty" hidden>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M20 20l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    <p>{{ 'teams.workspace.no_results'|trans }}</p>
                </div>
            </div>

            {{ form_errors(add_credentials_form.credentials) }}

            <label class="credential-option" style="margin-top: 1rem; align-items: flex-start;">
                {{ form_widget(add_credentials_form.canRevealPassword, {'attr': {'class': 'share-permission-checkbox'}}) }}
                <span class="credential-text">
                    <span class="credential-title">{{ add_credentials_form.canRevealPassword.vars.label|trans }}</span>
                    <small style="display:block; margin-top:.3rem; color:var(--color-text-medium); line-height:1.4;">
                        {{ add_credentials_form.canRevealPassword.vars.help|trans }}
                    </small>
                </span>
            </label>
            {{ form_errors(add_credentials_form.canRevealPassword) }}

            <div class="modal-actions">
                <button type="button" class="btn-secondary" data-action="click->team-show#closeCredentialsModal">
                    {{ 'teams.show.credentials.modal.cancel'|trans }}
                </button>
                <button type="submit" class="btn-primary-modal">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    {{ 'teams.show.credentials.modal.submit'|trans }}
                </button>
            </div>

            {{ form_end(add_credentials_form) }}
        </div>
    </div>
</div>
{% endif %}


{% if is_granted('TEAM_DELETE', team) %}<form id="deleteTeamForm" method="post" action="{{ path('app_team_delete', {id: team.id}) }}" hidden><input type="hidden" name="_token" value="{{ csrf_token('delete_team_' ~ team.id) }}"></form>{% endif %}
</div>
{% endblock %}
